lemma piLo_lt : (piLo : ℝ) < π := by
  have := pi_gt_d30; unfold piLo; push_cast; exact this
lemma lt_piHi : π < (piHi : ℝ) := by
  have := pi_lt_d30; unfold piHi; push_cast; exact this

lemma mem_unitBall {N m : ℕ} (hN : 0 < N) (hm : m ≤ N) :
    CBall.mem (Complex.exp (((2 * π * m / N : ℝ)) * Complex.I)) (unitBall N m) := by
  have hN' : (0 : ℝ) < N := by exact_mod_cast hN
  have hm' : (m : ℝ) ≤ N := by exact_mod_cast hm
  set yr : ℚ := 2 * piLo * m / (8 * N) with hyr
  set y0 := rdDown yr angP with hy0
  set y : ℝ := 2 * π * m / (8 * N) with hy
  have hlo := piLo_lt; have hhi := lt_piHi
  have hpl : (0 : ℝ) < piLo := by unfold piLo; norm_num
  have hyr0 : (0 : ℝ) ≤ yr := by rw [hyr]; push_cast; positivity
  have hyrle : (yr : ℝ) ≤ 1 := by
    rw [hyr]; push_cast
    rw [div_le_one (by positivity)]
    have : (piLo : ℝ) ≤ 4 := by unfold piLo; norm_num
    nlinarith
  have hy0le : (y0 : ℝ) ≤ yr := by exact_mod_cast rdDown_le yr angP
  have hy00 : (0 : ℚ) ≤ y0 := by
    rw [hy0]; unfold rdDown
    apply div_nonneg _ (by positivity)
    have : (0 : ℚ) ≤ yr * 2 ^ angP := by
      have : (0 : ℚ) ≤ yr := by exact_mod_cast hyr0
      positivity
    exact_mod_cast Int.floor_nonneg.2 this
  have habs : |y0| ≤ 1 := by
    rw [abs_of_nonneg hy00]; exact_mod_cast hy0le.trans hyrle
  have hB0 := mem_expIBall habs
  -- the widened ball contains e^{iy}
  have hdist : |y - y0| ≤ ((yr - y0) + 2 * (piHi - piLo) * m / (8 * N) : ℚ) := by
    push_cast
    have h1 : (yr : ℝ) ≤ y := by
      rw [hyr, hy]; push_cast
      exact div_le_div_of_nonneg_right (by nlinarith [(Nat.cast_nonneg m : (0 : ℝ) ≤ m)]) (by positivity)
    have h2 : y - yr ≤ 2 * (piHi - piLo) * m / (8 * N) := by
      rw [hyr, hy]; push_cast
      rw [← sub_div]
      exact div_le_div_of_nonneg_right (by nlinarith [(Nat.cast_nonneg m : (0 : ℝ) ≤ m)]) (by positivity)
    rw [abs_of_nonneg (by linarith)]
    linarith
  have hB : CBall.mem (Complex.exp (y * Complex.I))
      (⟨(expIBall y0).re, (expIBall y0).im, (expIBall y0).rad + ((yr - y0) + 2 * (piHi - piLo) * m / (8 * N))⟩ : CBall) := by
    unfold CBall.mem at hB0 ⊢
    simp only [CBall.c] at hB0 ⊢
    have e : Complex.exp (y * Complex.I) - ⟨(expIBall y0).re, (expIBall y0).im⟩
        = (Complex.exp (y * Complex.I) - Complex.exp ((y0 : ℝ) * Complex.I))
          + (Complex.exp ((y0 : ℝ) * Complex.I) - ⟨(expIBall y0).re, (expIBall y0).im⟩) := by ring
    rw [e]
    refine (norm_add_le _ _).trans ?_
    calc _ ≤ |y - (y0 : ℝ)| + (expIBall y0).rad := add_le_add (norm_exp_sub_le y y0) hB0
      _ ≤ _ := by push_cast at hdist ⊢; linarith
  have hsq : ∀ (x : ℝ) (B : CBall), CBall.mem (Complex.exp (x * Complex.I)) B →
      CBall.mem (Complex.exp (((2 * x : ℝ)) * Complex.I)) (cround (cmul B B)) := by
    intro x B hx
    have := mem_cround (mem_cmul hx hx)
    rw [← Complex.exp_add] at this
    convert this using 2; push_cast; ring
  have hB' : CBall.mem (Complex.exp (y * Complex.I))
      (⟨(expIBall y0).re, (expIBall y0).im,
        rdUp ((expIBall y0).rad + ((yr - y0) + 2 * (piHi - piLo) * m / (8 * N))) angP⟩ : CBall) :=
    le_trans hB (le_rdUp _ _ |> Rat.cast_le.2)
  have h8 := hsq _ _ (hsq _ _ (hsq _ _ hB'))
  have e8 : (2 * (2 * (2 * y)) : ℝ) = 2 * π * m / N := by rw [hy]; field_simp; ring
  rw [e8] at h8
  exact h8

lemma re_mem {z : ℂ} {B : CBall} (h : CBall.mem z B) : (B.re : ℝ) - B.rad ≤ z.re ∧ z.re ≤ B.re + B.rad := by
  have := (Complex.abs_re_le_norm (z - B.c)).trans h
  simp only [CBall.c, Complex.sub_re] at this
  rw [abs_le] at this; constructor <;> linarith [this.1, this.2]

lemma im_mem {z : ℂ} {B : CBall} (h : CBall.mem z B) : (B.im : ℝ) - B.rad ≤ z.im ∧ z.im ≤ B.im + B.rad := by
  have := (Complex.abs_im_le_norm (z - B.c)).trans h
  simp only [CBall.c, Complex.sub_im] at this
  rw [abs_le] at this; constructor <;> linarith [this.1, this.2]


end Grothe.UpperReplacement.TrigBounds

-- Section: CellNumerics

/-!
# Executable enclosures for the angular and normalized radial cell factors

Agent-ID: codex-a7c4.

The trigonometric enclosures reuse the proved 30-digit root-of-unity balls. Radial calculations
retain their chosen precision until after multiplication by the Hermite normalization; only then
are they rounded to the existing fixed-point arithmetic used by the matrix contraction.
-/

namespace Grothe.UpperReplacement.CellNumerics

open GrotheKernel GrotheKernel.HardyArc Upper UpperChaos.HardyArcSound
open scoped ComplexConjugate

def boundsI (l u : ℚ) : Ival := ⟨ofRatLo l, ofRatHi u⟩

theorem mem_boundsI {x : ℝ} {l u : ℚ} (hl : (l : ℝ) ≤ x) (hu : x ≤ u) :
    mem x (boundsI l u) :=
  ⟨(ofRatLo_le l).trans (mul_le_mul_of_nonneg_right hl D_pos.le),
    (mul_le_mul_of_nonneg_right hu D_pos.le).trans (le_ofRatHi u)⟩

def rootC (N : ℕ) (m : ℤ) : CI :=
  let B := TrigBounds.unitBall N ((m % N).toNat)
  ⟨boundsI (B.re - B.rad) (B.re + B.rad), boundsI (B.im - B.rad) (B.im + B.rad)⟩

theorem exp_integer_mod {N : ℕ} (hN : 0 < N) (m : ℤ) :
    Complex.exp ((((2 * Real.pi * (m : ℝ) / N : ℝ)) : ℂ) * Complex.I) =
      Complex.exp ((((2 * Real.pi * ((m % N).toNat : ℝ) / N : ℝ)) : ℂ) * Complex.I) := by
  have hN0 : (N : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hN
  have hNc : (N : ℂ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hN
  have hmod : ((m % N).toNat : ℤ) = m % N := Int.toNat_of_nonneg
    (Int.emod_nonneg _ (by omega))
  have he : (m : ℝ) = ((m % N).toNat : ℝ) + (N : ℝ) * ((m / N : ℤ) : ℝ) := by
    have h := (Int.emod_add_mul_ediv m (N : ℤ)).symm
    rw [← hmod] at h
    exact_mod_cast h
  have ha : (((2 * Real.pi * (m : ℝ) / N : ℝ)) : ℂ) * Complex.I =
      ((((2 * Real.pi * ((m % N).toNat : ℝ) / N : ℝ)) : ℂ) * Complex.I) +
        ((m / N : ℤ) : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
    rw [he]
    push_cast
    field_simp
  rw [ha, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]

theorem mem_rootC {N : ℕ} (hN : 0 < N) (m : ℤ) :
    memC (Complex.exp ((((2 * Real.pi * (m : ℝ) / N : ℝ)) : ℂ) * Complex.I))
      (rootC N m) := by
  rw [exp_integer_mod hN m]
  have hb := TrigBounds.mem_unitBall hN
    (Int.natMod_lt (m := m) (Nat.ne_of_gt hN)).le
  have hr := TrigBounds.re_mem hb
  have hi := TrigBounds.im_mem hb
  exact ⟨mem_boundsI (by simpa only [Rat.cast_sub, Int.natMod] using hr.1)
      (by simpa only [Rat.cast_add, Int.natMod] using hr.2),
    mem_boundsI (by simpa only [Rat.cast_sub, Int.natMod] using hi.1)
      (by simpa only [Rat.cast_add, Int.natMod] using hi.2)⟩

def piInvI : Ival := boundsI (1 / TrigBounds.piHi) (1 / TrigBounds.piLo)

theorem mem_piInvI : mem Real.pi⁻¹ piInvI := by
  have hlo := TrigBounds.piLo_lt
  have hhi := TrigBounds.lt_piHi
  have hp : (0 : ℝ) < TrigBounds.piLo := by
    norm_num [TrigBounds.piLo]
  apply mem_boundsI
  · push_cast
    simpa only [one_div] using one_div_le_one_div_of_le Real.pi_pos hhi.le
  · push_cast
    simpa only [one_div] using one_div_le_one_div_of_le hp hlo.le

/-- Evenness of sinc allows a positive denominator for every nonzero signed frequency. -/
def sincI (A : ℕ) (m : ℤ) : Ival :=
  if m = 0 then intI 1 else
    mulI (rootC (2 * A) m.natAbs).im (mulI (ofRatI ((A : ℚ) / m.natAbs)) piInvI)

theorem mem_sincI {A : ℕ} (hA : 0 < A) (m : ℤ) :
    mem (Real.sinc ((m : ℝ) * (Real.pi / A))) (sincI A m) := by
  by_cases hm : m = 0
  · subst m
    simpa [sincI] using mem_intI 1
  have hm0 : m.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hm
  have hAr : (A : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hA
  have hmr : (m.natAbs : ℝ) ≠ 0 := by exact_mod_cast hm0
  have he : Real.sinc ((m : ℝ) * (Real.pi / A)) =
      Real.sinc ((m.natAbs : ℝ) * (Real.pi / A)) := by
    rcases le_total 0 m with h | h
    · have ha : (m.natAbs : ℝ) = (m : ℝ) := by
        simpa only [Int.cast_natCast] using
          congrArg (fun z : ℤ ↦ (z : ℝ)) (Int.natAbs_of_nonneg h)
      rw [ha]
    · have ha : (m.natAbs : ℝ) = -(m : ℝ) := by
        simpa only [Int.cast_natCast, Int.cast_neg] using
          congrArg (fun z : ℤ ↦ (z : ℝ)) (Int.ofNat_natAbs_of_nonpos h)
      rw [ha]
      rw [neg_mul, Real.sinc_neg]
  have hr := (mem_rootC (show 0 < 2 * A by omega) (m.natAbs : ℤ)).2
  have hs : mem (Real.sin ((m.natAbs : ℝ) * (Real.pi / A))) (rootC (2 * A) m.natAbs).im := by
    rw [Complex.exp_ofReal_mul_I_im] at hr
    have ha : (2 * Real.pi * ((m.natAbs : ℤ) : ℝ) / (2 * A : ℕ)) =
        (m.natAbs : ℝ) * (Real.pi / A) := by
      simp only [Int.cast_natCast, Nat.cast_mul, Nat.cast_ofNat]
      ring
    rwa [ha] at hr
  rw [he, sincI, ite_eq_right hm, Real.sinc_of_ne_zero
    (mul_ne_zero hmr (div_ne_zero Real.pi_ne_zero hAr))]
  convert mem_mul hs (mem_mul (mem_ofRatI ((A : ℚ) / m.natAbs)) mem_piInvI) using 1
  push_cast
  field_simp

/-- Convert a proved rational enclosure to a floating dyadic enclosure with outward rounding. -/
def rationalBoundsFloat (P : ℕ) (l u : ℚ) : GrotheQuad.Ival :=
  GrotheQuad.ofFixed P ⌊l * 2 ^ P⌋ ⌈u * 2 ^ P⌉

theorem mem_rationalBoundsFloat {x : ℝ} (P : ℕ) {l u : ℚ}
    (hl : (l : ℝ) ≤ x) (hu : x ≤ u) : UpperQuad.mem x (rationalBoundsFloat P l u) := by
  apply UpperQuad.mem_ofFixed
  · have h := Int.floor_le (l * 2 ^ P)
    have h' : (⌊l * 2 ^ P⌋ : ℝ) ≤ (l : ℝ) * 2 ^ P := by exact_mod_cast h
    exact h'.trans (mul_le_mul_of_nonneg_right hl (by positivity))
  · have h := Int.le_ceil (u * 2 ^ P)
    have h' : (u : ℝ) * 2 ^ P ≤ (⌈u * 2 ^ P⌉ : ℝ) := by exact_mod_cast h
    exact (mul_le_mul_of_nonneg_right hu (by positivity)).trans h'

def fixedI (a : GrotheQuad.Ival) : Ival :=
  ⟨GrotheQuad.toFixedLo K a, GrotheQuad.toFixedHi K a⟩

theorem mem_fixedI {x : ℝ} {a : GrotheQuad.Ival} (h : UpperQuad.mem x a) :
    mem x (fixedI a) := by
  have hl := UpperQuad.toFixedLo_le K h
  have hu := UpperQuad.le_toFixedHi K h
  simpa only [mem, fixedI, D, Int.cast_pow, Int.cast_ofNat] using And.intro hl hu

/-- Normalize before reducing precision to the 128-bit contraction grid. -/
def radialI (P n p q : ℕ) (a b : ℚ) : Ival :=
  let v := radialHermiteEnclosure P n p q a b
  fixedI (GrotheQuad.mulI P (normalizationInterval P p q) (rationalBoundsFloat P v.1 v.2))

theorem mem_radialI (P : ℕ) (hP : 1 ≤ P) {n : ℕ} (hn : 0 < n)
    {a b : ℚ} (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ 8)
    (hw : 2 * ((a + b) / 2) * ((b - a) / 2) + ((b - a) / 2) ^ 2 ≤ 1)
    (p q : ℕ) :
    mem (UpperChaos.nrm p q * radialHermiteMoment p q a b) (radialI P n p q a b) := by
  have h := radialHermiteEnclosure_sound P hn ha hab hb hw p q
  exact mem_fixedI (UpperQuad.mem_mulI P (normalizationInterval_sound P hP p q)
    (mem_rationalBoundsFloat P h.1 h.2))

end Grothe.UpperReplacement.CellNumerics

-- Section: CachedRadial

/-!
# Normalized radial intervals from the shared moment array

Agent-ID: codex-a7c4.
-/

namespace Grothe.UpperReplacement

def radialHermiteFromCache (p q : ℕ) (moments : Array (ℚ × ℚ)) : ℚ × ℚ :=
  let term := fun k ↦ moments[p - k + (q - k)]?.getD (0, 0)
  (((List.range (p + 1)).map (fun k ↦
      let c := radialHermiteCoeff p q k
      c * if 0 ≤ c then (term k).1 else (term k).2)).sum,
    ((List.range (p + 1)).map (fun k ↦
      let c := radialHermiteCoeff p q k
      c * if 0 ≤ c then (term k).2 else (term k).1)).sum)

theorem radialHermiteFromCache_eq (P n p q : ℕ) (a b : ℚ)
    {size : ℕ} (hsize : p + q < size) :
    radialHermiteFromCache p q (CellMoments.fastMomentCache P n a b size) =
      radialHermiteEnclosure P n p q a b := by
  have he (k : ℕ) :
      (CellMoments.fastMomentCache P n a b size)[p - k + (q - k)]?.getD (0, 0) =
        CellMoments.fastMoment P n a b (p - k + (q - k)) :=
    CellMoments.fastMomentCache_get P n a b (by omega)
  simp only [radialHermiteFromCache, he, radialHermiteEnclosure]

def normalizedRadialFromCache (P p q : ℕ) (moments : Array (ℚ × ℚ)) : GrotheKernel.Ival :=
  let v := radialHermiteFromCache p q moments
  CellNumerics.fixedI (GrotheQuad.mulI P (normalizationInterval P p q)
    (CellNumerics.rationalBoundsFloat P v.1 v.2))

theorem normalizedRadialFromCache_eq (P n p q : ℕ) (a b : ℚ)
    {size : ℕ} (hsize : p + q < size) :
    normalizedRadialFromCache P p q (CellMoments.fastMomentCache P n a b size) =
      CellNumerics.radialI P n p q a b := by
  simp only [normalizedRadialFromCache, radialHermiteFromCache_eq P n p q a b hsize,
    CellNumerics.radialI]

end Grothe.UpperReplacement

-- Section: RadialComputeSound

/-!
# Identification of the executable radial calculation

Agent-ID: codex-a7c4.

The native arithmetic is equal to the rational recurrence whose integral enclosure is proved
in `Moments`. There is no external quadrature or floating-point accuracy premise.
-/

namespace Grothe.UpperReplacement.RadialCompute

@[simp] theorem factorial_eq (n : ℕ) : factorial n = n.factorial := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [factorial, Nat.factorial_succ, ih]

@[simp] theorem descending_eq (n k : ℕ) : descending n k = n.descFactorial k := by
  induction k with
  | zero => rfl
  | succ k ih => simp only [descending, Nat.descFactorial_succ, ih]

@[simp] theorem choose_eq (n k : ℕ) : choose n k = n.choose k := by
  rw [choose, descending_eq, factorial_eq, Nat.choose_eq_descFactorial_div_factorial]

@[simp] theorem padd_eq (p q : List ℚ) : padd p q = MomentTaylor.padd p q := by
  induction p generalizing q with
  | nil => rfl
  | cons a p ih => cases q <;> simp only [padd, MomentTaylor.padd, ih]

@[simp] theorem psmul_eq (c : ℚ) (p : List ℚ) : psmul c p = MomentTaylor.psmul c p := rfl

@[simp] theorem pmul_eq (p q : List ℚ) : pmul p q = MomentTaylor.pmul p q := by
  induction p with
  | nil => rfl
  | cons a p ih => simp only [pmul, MomentTaylor.pmul, psmul_eq, padd_eq, ih]

@[simp] theorem pint_eq (p : List ℚ) (d : ℕ) (a b : ℚ) :
    pint p d a b = MomentTaylor.pint p d a b := by
  induction p generalizing d with
  | nil => rfl
  | cons c p ih => simp only [pint, MomentTaylor.pint, ih]

@[simp] theorem expPoly_eq (u : List ℚ) (n : ℕ) : expPoly u n = MomentTaylor.expPoly u n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [expPoly, MomentTaylor.expPoly, ih, padd_eq, psmul_eq, pmul_eq]

@[simp] theorem rdDown_eq (q : ℚ) (P : ℕ) : rdDown q P = MomentTaylor.rdDown q P := rfl

@[simp] theorem rdUp_eq (q : ℚ) (P : ℕ) : rdUp q P = MomentTaylor.rdUp q P := by
  change ((-⌊-(q * 2 ^ P)⌋ : ℤ) : ℚ) / 2 ^ P = (⌈q * 2 ^ P⌉ : ℚ) / 2 ^ P
  rw [Int.floor_neg, neg_neg]

@[simp] theorem expTay_eq (x : ℚ) (n : ℕ) : expTay x n = MomentTaylor.expTay x n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [expTay, MomentTaylor.expTay, ih]

@[simp] theorem expRem_eq (y : ℚ) (n : ℕ) : expRem y n = MomentTaylor.expRem y n := by
  simp only [expRem, MomentTaylor.expRem, factorial_eq]

@[simp] theorem squareEnclosure_eq (P n : ℕ) (v : ℚ × ℚ) :
    squareEnclosure P n v = CellMoments.squareEnclosure P n v := by
  induction n with
  | zero => rfl
  | succ n ih =>
    simp only [squareEnclosure, CellMoments.squareEnclosure, ih, rdDown_eq, rdUp_eq]

@[simp] theorem expNegEnclosure_eq (P n : ℕ) (x : ℚ) :
    expNegEnclosure P n x = CellMoments.expNegEnclosure P n x := by
  simp only [expNegEnclosure, CellMoments.expNegEnclosure, expTay_eq, expRem_eq,
    rdDown_eq, rdUp_eq, squareEnclosure_eq]

@[simp] theorem radialBase_eq (a b : ℚ) (n k : ℕ) :
    radialBase a b n k = CellMoments.radialBase a b n k := by
  simp only [radialBase, CellMoments.radialBase, expPoly_eq, choose_eq, pint_eq]

@[simp] theorem radialError_eq (a b : ℚ) (n k : ℕ) :
    radialError a b n k = CellMoments.radialError a b n k := by
  simp only [radialError, CellMoments.radialError, expRem_eq]

@[simp] theorem radialEnclosure_eq (P n : ℕ) (a b : ℚ) (k : ℕ) :
    radialEnclosure P n a b k = CellMoments.radialEnclosure P n a b k := by
  simp only [radialEnclosure, CellMoments.radialEnclosure, expNegEnclosure_eq,
    radialBase_eq, radialError_eq, rdDown_eq, rdUp_eq]

@[simp] theorem momentStep_eq (P : ℕ) (a b : ℚ) (ea eb v : ℚ × ℚ) (k : ℕ) :
    momentStep P a b ea eb v k = CellMoments.momentStep P a b ea eb v k := by
  simp only [momentStep, CellMoments.momentStep, rdDown_eq, rdUp_eq]

@[simp] theorem momentCache_eq (P : ℕ) (a b : ℚ) (ea eb v₀ v₁ : ℚ × ℚ) (n : ℕ) :
    momentCache P a b ea eb v₀ v₁ n = CellMoments.momentCache P a b ea eb v₀ v₁ n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [momentCache.eq_def, CellMoments.momentCache.eq_def]
    dsimp only
    rw [ih]
    congr 1

@[simp] theorem fastMomentCache_eq (P n : ℕ) (a b : ℚ) (size : ℕ) :
    fastMomentCache P n a b size = CellMoments.fastMomentCache P n a b size := by
  simp only [fastMomentCache, CellMoments.fastMomentCache, momentCache_eq,
    expNegEnclosure_eq, radialEnclosure_eq]

@[simp] theorem hermiteCoefficient_eq (p q k : ℕ) :
    hermiteCoefficient p q k = radialHermiteCoeff p q k := by
  simp only [hermiteCoefficient, radialHermiteCoeff, choose_eq, descending_eq]

@[simp] theorem hermiteFromCache_eq (p q : ℕ) (v : Array (ℚ × ℚ)) :
    hermiteFromCache p q v = radialHermiteFromCache p q v := by
  simp only [hermiteFromCache, radialHermiteFromCache, hermiteCoefficient_eq]

@[simp] theorem normalization_eq (P p q : ℕ) :
    normalization P p q = normalizationInterval P p q := by
  simp only [normalization, normalizationInterval, factorial_eq]

@[simp] theorem rationalBoundsFloat_eq (P : ℕ) (l u : ℚ) :
    rationalBoundsFloat P l u = CellNumerics.rationalBoundsFloat P l u := rfl

@[simp] theorem fixedI_eq (a : GrotheQuad.Ival) : fixedI a = CellNumerics.fixedI a := rfl

theorem normalizedFromCache_eq (P n p q : ℕ) (a b : ℚ) {size : ℕ}
    (hsize : p + q < size) :
    normalizedFromCache P p q (fastMomentCache P n a b size) =
      CellNumerics.radialI P n p q a b := by
  simp only [normalizedFromCache, fastMomentCache_eq,
    hermiteFromCache_eq, normalization_eq, rationalBoundsFloat_eq, fixedI_eq]
  exact normalizedRadialFromCache_eq P n p q a b hsize

end Grothe.UpperReplacement.RadialCompute

-- Section: CellEvaluator

/-!
# From executable cell intervals to the actual Hermite coefficient

Agent-ID: codex-a7c4.

The same clipped table entries and centered-cell Fourier factors occur in the actual response
and the finite evaluator. Radial and angular arrays may be cached independently; their soundness
is the interface used by the separated matrix contraction.
-/

open Finset MeasureTheory
open scoped ComplexConjugate InnerProductSpace

namespace Grothe.UpperReplacement.CellEvaluator

open GrotheKernel GrotheKernel.HardyArc Upper UpperChaos UpperChaos.HardyArcSound
open CellArithmetic CellNumerics

def entryI (table : Array (ℤ × ℤ)) (scale N k i j : ℕ) : CI :=
  let v := table[k * N * N + i * N + j]?.getD (0, 0)
  cellC scale v.1 v.2

theorem mem_entryI (table : Array (ℤ × ℤ)) (scale N k i j : ℕ) :
    memC (cellEntry table scale N k i j) (entryI table scale N k i j) :=
  mem_cellC _ _ _

/-- The discrete transform includes the normalization and the full-cell sinc factor. -/
def angularI (A : ℕ) (m : ℤ) (table : ℕ → CI) : CI :=
  CI.mul (CI.ofR (mulI (sincI A m) (ofRatI (1 / (A : ℚ)))))
    (fourierC A (fun j ↦ rootC A (-(m * j))) table)

theorem mem_angularI {A : ℕ} (hA : 0 < A) (m : ℤ) {table : ℕ → CI} {v : ℕ → ℂ}
    (hv : ∀ j < A, memC (v j) (table j)) :
    memC (angularCellCoefficient A v m) (angularI A m table) := by
  rw [angularCellCoefficient_eq_dft hA]
  apply memC_mul
  · apply memC_ofR
    have h := mem_mul (mem_sincI hA m) (mem_ofRatI (1 / (A : ℚ)))
    push_cast at h
    simpa only [div_eq_mul_inv, mul_one, one_mul] using h
  · apply mem_fourierC _ hv
    intro j _
    convert mem_rootC hA (-(m * j)) using 1
    congr 2
    push_cast
    ring

theorem mem_angularEntryI (table : Array (ℤ × ℤ)) (scale N : ℕ) {A : ℕ}
    (hA : 0 < A) (m : ℤ) (i j : ℕ) :
    memC (angularCellCoefficient A (fun k ↦ cellEntry table scale N k i j) m)
      (angularI A m (fun k ↦ entryI table scale N k i j)) :=
  mem_angularI hA m (fun k _ ↦ mem_entryI table scale N k i j)

/-- The generic contraction is sound for cached enclosures as well as directly evaluated ones. -/
theorem mem_cellCoefficient {table : Array (ℤ × ℤ)} {scale N A : ℕ} {R : ℝ} (u : Idx2)
    {left right : ℕ → Ival} {angular : ℕ → ℕ → CI}
    (hl : ∀ i < N, mem
      (normalizedRadialMoment u.1.1 u.1.2 (R * i / N) (R * (i + 1) / N)) (left i))
    (hr : ∀ j < N, mem
      (normalizedRadialMoment u.2.1 u.2.2 (R * j / N) (R * (j + 1) / N)) (right j))
    (ha : ∀ i < N, ∀ j < N,
      memC (angularCellCoefficient A (fun k ↦ cellEntry table scale N k i j)
        ((u.1.1 : ℤ) - u.1.2)) (angular i j)) :
    memC (cellCoefficient table scale N A R u) (radialC N left right angular) := by
  have h := mem_radialC hl hr ha
  convert h using 1
  unfold cellCoefficient cellRowCoefficient
  simp_rw [Finset.mul_sum]
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro j _
  ring

/-- A cached right transform can be reused for every left radial mode. -/
theorem mem_cellCoefficient_separated {table : Array (ℤ × ℤ)} {scale N A : ℕ} {R : ℝ}
    (u : Idx2) {left : ℕ → Ival} {rows : ℕ → CI}
    (hl : ∀ i < N, mem
      (normalizedRadialMoment u.1.1 u.1.2 (R * i / N) (R * (i + 1) / N)) (left i))
    (hrows : ∀ i < N, memC (cellRowCoefficient table scale N A R u i) (rows i)) :
    memC (cellCoefficient table scale N A R u) (leftRadialC N left rows) :=
  mem_leftRadialC hl hrows

/-- The interval contraction encloses the coefficient of the actual bounded measurable response. -/
theorem mem_inner_cellResponse {table : Array (ℤ × ℤ)} {scale N A : ℕ} {R : ℝ}
    (hN : 0 < N) (hR : 0 < R) (u : Idx2)
    (hu : u.1.1 + u.2.1 = u.1.2 + u.2.2 + 1)
    {left right : ℕ → Ival} {angular : ℕ → ℕ → CI}
    (hl : ∀ i < N, mem
      (normalizedRadialMoment u.1.1 u.1.2 (R * i / N) (R * (i + 1) / N)) (left i))
    (hr : ∀ j < N, mem
      (normalizedRadialMoment u.2.1 u.2.2 (R * j / N) (R * (j + 1) / N)) (right j))
    (ha : ∀ i < N, ∀ j < N,
      memC (angularCellCoefficient A (fun k ↦ cellEntry table scale N k i j)
        ((u.1.1 : ℤ) - u.1.2)) (angular i j)) :
    memC ⟪hvec2 u, (memLp_cellResponse table scale N A R).toLp
      (cellResponse table scale N A R)⟫_ℂ (radialC N left right angular) := by
  rw [cellCoefficient_eq_inner table scale A hN hR u hu]
  exact mem_cellCoefficient u hl hr ha

end Grothe.UpperReplacement.CellEvaluator
