-- Section: CellArithmetic

/-!
# Certified finite complex arithmetic for the cell contraction

Agent-ID: codex-a7c4.

Reuses the existing 128-bit fixed-point interval operations after the radial moments have been
normalized. The table decoder, angular transform and radial contraction all use the same clipped
Gaussian-integer entries as the actual response.
-/

namespace Grothe.UpperReplacement.CellArithmetic

open GrotheKernel GrotheKernel.HardyArc Upper UpperChaos.HardyArcSound
open scoped ComplexConjugate

theorem mem_zeroC : memC 0 zeroC := ⟨mem_zero, mem_zero⟩

theorem mem_conjC {z : ℂ} {Z : CI} (hz : memC z Z) : memC (conj z) (conjC Z) :=
  ⟨hz.1, mem_neg hz.2⟩

theorem mem_sumC {f : ℕ → ℂ} {F : ℕ → CI} (n : ℕ)
    (hf : ∀ k, k < n → memC (f k) (F k)) :
    memC (∑ k ∈ Finset.range n, f k) (sumC n F) := by
  induction n with
  | zero => simpa [sumC] using mem_zeroC
  | succ n ih =>
    simp only [sumC, List.range_succ, List.foldl_append, List.foldl_cons,
      List.foldl_nil, Finset.sum_range_succ]
    exact memC_add (ih fun k hk ↦ hf k (by omega)) (hf n (by omega))

theorem mem_cellC (scale : ℕ) (a b : ℤ) :
    memC (clippedCell scale a b) (cellC scale a b) := by
  unfold clippedCell cellC
  split_ifs
  · have ha := mem_ofRatI ((a : ℚ) / scale)
    have hb := mem_ofRatI ((b : ℚ) / scale)
    constructor
    · simpa only [Complex.div_natCast_re, Complex.add_re, Complex.intCast_re,
        Complex.mul_re, Complex.intCast_im, Complex.I_re, Complex.I_im,
        mul_zero, zero_mul, sub_self, add_zero, Rat.cast_div, Rat.cast_intCast,
        Rat.cast_natCast] using ha
    · simpa only [Complex.div_natCast_im, Complex.add_im, Complex.intCast_im,
        Complex.mul_im, Complex.intCast_re, Complex.I_im, Complex.I_re,
        mul_one, mul_zero, zero_add, add_zero, Rat.cast_div, Rat.cast_intCast,
        Rat.cast_natCast] using hb
  · exact mem_zeroC

/-- A finite angular transform, before applying its cell-width sinc factor. -/
theorem mem_fourierC {A : ℕ} {phase table : ℕ → CI} {z t : ℕ → ℂ}
    (hz : ∀ j, j < A → memC (z j) (phase j))
    (ht : ∀ j, j < A → memC (t j) (table j)) :
    memC (∑ j ∈ Finset.range A, z j * t j) (fourierC A phase table) :=
  mem_sumC A fun j hj ↦ memC_mul (hz j hj) (ht j hj)

/-- Separated radial contraction against the transformed cell matrix. -/
theorem mem_radialC {N : ℕ} {left right : ℕ → Ival} {table : ℕ → ℕ → CI}
    {l r : ℕ → ℝ} {t : ℕ → ℕ → ℂ}
    (hl : ∀ i, i < N → mem (l i) (left i))
    (hr : ∀ j, j < N → mem (r j) (right j))
    (ht : ∀ i, i < N → ∀ j, j < N → memC (t i j) (table i j)) :
    memC (∑ i ∈ Finset.range N, ∑ j ∈ Finset.range N, (l i : ℂ) * t i j * r j)
      (radialC N left right table) := by
  apply mem_sumC
  intro i hi
  apply mem_sumC
  intro j hj
  exact memC_mul (memC_mul (memC_ofR (hl i hi)) (ht i hi j hj)) (memC_ofR (hr j hj))

theorem mem_rightRadialC {N : ℕ} {right : ℕ → Ival} {table : ℕ → ℕ → CI}
    {r : ℕ → ℝ} {t : ℕ → ℕ → ℂ}
    (hr : ∀ j < N, mem (r j) (right j))
    (ht : ∀ i < N, ∀ j < N, memC (t i j) (table i j)) {i : ℕ} (hi : i < N) :
    memC (∑ j ∈ Finset.range N, t i j * (r j : ℂ))
      (rightRadialC N right table i) :=
  mem_sumC N fun j hj ↦ memC_mul (ht i hi j hj) (memC_ofR (hr j hj))

theorem mem_leftRadialC {N : ℕ} {left : ℕ → Ival} {rows : ℕ → CI}
    {l : ℕ → ℝ} {v : ℕ → ℂ}
    (hl : ∀ i < N, mem (l i) (left i))
    (hv : ∀ i < N, memC (v i) (rows i)) :
    memC (∑ i ∈ Finset.range N, (l i : ℂ) * v i) (leftRadialC N left rows) :=
  mem_sumC N fun i hi ↦ memC_mul (memC_ofR (hl i hi)) (hv i hi)

/-- Real cross overlaps preserve their signs, including negative contributions. -/
theorem mem_overlapI {z w : ℂ} {Z W : CI} (hz : memC z Z) (hw : memC w W) :
    mem (conj z * w).re (overlapI Z W) :=
  (memC_mul (mem_conjC hz) hw).1

end Grothe.UpperReplacement.CellArithmetic

-- Section: TrigBounds

/-!
# Certified roots of unity without the lower-certificate import graph

Agent-ID: codex-a7c4.

The generic complex-ball arithmetic and thirty-digit pi witnesses are reused from
`LowerAnalytic.CapTables` and `CapTablesData`. Their Gaussian and node-cap wrappers are
not needed here. Dyadic rounding and the exponential remainder use `MomentTaylor`.

Source SHA256: cc4ef3a30c11435f68449256f8c92e9c67e85aeac5e53e0f8e383ca2e95bc57c
Data SHA256: 32b46fe51a736d6bd1e669654999c46dd03bbde8e1a0f2014d5486c6827b2ea3
-/

open Real MeasureTheory Set Finset

namespace Grothe.UpperReplacement.TrigBounds

open MomentTaylor

structure CBall where
  re : ℚ
  im : ℚ
  rad : ℚ

/-- `|re| + |im|`. -/
def nrm1 (B : CBall) : ℚ := |B.re| + |B.im|

/-- The angular precision. -/
def angP : ℕ := 128

/-- Product of balls. -/
def cmul (A B : CBall) : CBall :=
  ⟨A.re * B.re - A.im * B.im, A.re * B.im + A.im * B.re, A.rad * (nrm1 B + B.rad) + B.rad * nrm1 A⟩

/-- Round the center down to the grid `2^{-angP}`, enlarging the radius. -/
def cround (B : CBall) : CBall :=
  ⟨rdDown B.re angP, rdDown B.im angP,
    rdUp (B.rad + (B.re - rdDown B.re angP) + (B.im - rdDown B.im angP)) angP⟩

/-- `(Σ_{m<n} (iy)^m/m!, (iy)^n/n!)` as pairs `(re, im)`. -/
def expITay (y : ℚ) : ℕ → (ℚ × ℚ) × (ℚ × ℚ)
  | 0 => ((0, 0), (1, 0))
  | n + 1 =>
    let r := expITay y n
    ((r.1.1 + r.2.1, r.1.2 + r.2.2), (-r.2.2 * y / (n + 1), r.2.1 * y / (n + 1)))

/-- The Taylor ball of `e^{iy}`. -/
def expIBall (y : ℚ) : CBall :=
  let r := expITay y 30
  ⟨r.1.1, r.1.2, expRem |y| 30⟩

/-- `piLo < π`, 30 digits. -/
def piLo : ℚ := 3141592653589793238462643383279 / 10 ^ 30

/-- `π < piHi`, 30 digits. -/
def piHi : ℚ := 3141592653589793238462643383280 / 10 ^ 30

/-- A ball containing `e^{2πim/N}` (`m ≤ N`). -/
def unitBall (N m : ℕ) : CBall :=
  let yr : ℚ := 2 * piLo * m / (8 * N)
  let y0 := rdDown yr angP
  let δ := (yr - y0) + 2 * (piHi - piLo) * m / (8 * N)
  let B0 := expIBall y0
  let B := (⟨B0.re, B0.im, rdUp (B0.rad + δ) angP⟩ : CBall)
  let B2 := cround (cmul B B)
  let B4 := cround (cmul B2 B2)
  cround (cmul B4 B4)


/-- The center. -/
noncomputable def CBall.c (B : CBall) : ℂ := ⟨B.re, B.im⟩

/-- Membership. -/
def CBall.mem (z : ℂ) (B : CBall) : Prop := ‖z - B.c‖ ≤ B.rad

lemma norm_c_le (B : CBall) : ‖B.c‖ ≤ nrm1 B := by
  refine (Complex.norm_le_abs_re_add_abs_im _).trans (le_of_eq ?_)
  simp [CBall.c, nrm1]

lemma mem_cmul {z w : ℂ} {A B : CBall} (hz : CBall.mem z A) (hw : CBall.mem w B) :
    CBall.mem (z * w) (cmul A B) := by
  unfold CBall.mem at *
  have hc : (cmul A B).c = A.c * B.c := by
    apply Complex.ext <;> simp [cmul, CBall.c]
  have hrad : ((cmul A B).rad : ℝ) = A.rad * (nrm1 B + B.rad) + B.rad * nrm1 A := by
    simp [cmul]
  rw [hc, hrad]
  have e : z * w - A.c * B.c = (z - A.c) * w + A.c * (w - B.c) := by ring
  have hw' : ‖w‖ ≤ nrm1 B + B.rad := by
    linarith [norm_le_norm_add_norm_sub' w B.c, norm_c_le B, norm_sub_rev w B.c]
  have hA := norm_c_le A
  have hr0 : (0 : ℝ) ≤ A.rad := (norm_nonneg _).trans hz
  rw [e]
  refine (norm_add_le _ _).trans ?_
  rw [norm_mul, norm_mul]
  have h1 := mul_le_mul hz hw' (norm_nonneg _) hr0
  have h2 := mul_le_mul hA hw (norm_nonneg _) ((norm_nonneg _).trans hA)
  linarith

lemma mem_cround {z : ℂ} {B : CBall} (h : CBall.mem z B) : CBall.mem z (cround B) := by
  unfold CBall.mem at *
  have h1 : ‖B.c - (cround B).c‖ ≤ (B.re - rdDown B.re angP : ℚ) + (B.im - rdDown B.im angP : ℚ) := by
    refine (Complex.norm_le_abs_re_add_abs_im _).trans (le_of_eq ?_)
    simp only [CBall.c, cround, Complex.sub_re, Complex.sub_im]
    rw [abs_of_nonneg, abs_of_nonneg]
    · push_cast; ring
    · exact_mod_cast sub_nonneg.2 (rdDown_le B.im angP)
    · exact_mod_cast sub_nonneg.2 (rdDown_le B.re angP)
  have e : z - (cround B).c = (z - B.c) + (B.c - (cround B).c) := by ring
  have hr : (B.rad : ℝ) + ((B.re - rdDown B.re angP : ℚ) + (B.im - rdDown B.im angP : ℚ))
      ≤ (cround B).rad := by
    simp only [cround]; exact le_rdUp_real angP (by push_cast; linarith)
  rw [e]
  exact (norm_add_le _ _).trans ((add_le_add h h1).trans hr)

lemma expITay_eq (y : ℚ) : ∀ n : ℕ,
    (⟨(expITay y n).1.1, (expITay y n).1.2⟩ : ℂ)
        = ∑ m ∈ range n, (((y : ℝ) : ℂ) * Complex.I) ^ m / m.factorial ∧
      (⟨(expITay y n).2.1, (expITay y n).2.2⟩ : ℂ) = (((y : ℝ) : ℂ) * Complex.I) ^ n / n.factorial
  | 0 => by
    refine ⟨?_, ?_⟩ <;> apply Complex.ext <;> simp [expITay]
  | n + 1 => by
    obtain ⟨h1, h2⟩ := expITay_eq y n
    refine ⟨?_, ?_⟩
    · rw [Finset.sum_range_succ, ← h1, ← h2]
      apply Complex.ext <;> simp [expITay]
    · have e : (((y : ℝ) : ℂ) * Complex.I) ^ (n + 1) / ((n + 1).factorial : ℂ)
          = (((y : ℝ) : ℂ) * Complex.I) ^ n / (n.factorial : ℂ)
            * (((y : ℝ) : ℂ) * Complex.I * (((1 / (n + 1) : ℝ)) : ℂ)) := by
        rw [Nat.factorial_succ]; push_cast; field_simp; ring
      rw [e, ← h2]
      apply Complex.ext
      · simp only [expITay, Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
          Complex.I_re, Complex.I_im]
        push_cast; ring
      · simp only [expITay, Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
          Complex.I_re, Complex.I_im]
        push_cast; ring

lemma mem_expIBall {y : ℚ} (hy : |y| ≤ 1) : CBall.mem (Complex.exp ((y : ℝ) * Complex.I)) (expIBall y) := by
  unfold CBall.mem expIBall CBall.c
  have hx : ‖((y : ℝ) : ℂ) * Complex.I‖ ≤ 1 := by
    rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs]; exact_mod_cast hy
  have hb := Complex.exp_bound hx (n := 30) (by norm_num)
  have hc := (expITay_eq y 30).1
  simp only
  rw [hc]
  refine hb.trans (le_of_eq ?_)
  rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs]
  simp [expRem]; norm_num

lemma norm_exp_sub_le (a b : ℝ) :
    ‖Complex.exp (a * Complex.I) - Complex.exp (b * Complex.I)‖ ≤ |a - b| := by
  have e : Complex.exp (a * Complex.I) - Complex.exp (b * Complex.I)
      = Complex.exp (b * Complex.I) * (Complex.exp (Complex.I * ((a - b : ℝ) : ℂ)) - 1) := by
    rw [mul_sub, mul_one, ← Complex.exp_add]; congr 2; push_cast; ring
  rw [e, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
  exact Real.norm_exp_I_mul_ofReal_sub_one_le.trans (le_of_eq (Real.norm_eq_abs _))

