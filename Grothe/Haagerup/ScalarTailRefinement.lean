def ratio : ℚ := 581/1000

/-- Kernel-checked outward fixed-point bound for the finite polynomial power. -/
lemma power_check : powerNormOK pl 16 ratio = true := by
  decide +kernel

/-- Finite part of the physical phase suffix, before its pi/4 factor. -/
def wallisChunk : ℚ := ∑ k ∈ range 120, if k < 67 then 0 else haagR k

/-- A proof-producing rational comparison, with no native evaluation. -/
lemma wallis_rational_check :
    (355 : ℚ)/113/4 * (wallisChunk + haagG 120/240) ≤ 1/268 := by
  decide +kernel

noncomputable section

/-- The entire omitted physical phase suffix is bounded from the existing
Haagerup recurrence and telescoping lemmas, with no external Wallis input. -/
lemma wallis_tail_bound : (∑' k, |cHi 67 k|) ≤ (1 : ℝ)/268 := by
  have hfinite : ∑ k ∈ range 120, |cHi 67 k| = Real.pi/4*(wallisChunk : ℝ) := by
    unfold wallisChunk
    push_cast
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro k hk
    by_cases h : k < 67
    · simp [cHi, h]
    · simp only [cHi, ite_eq_right h, abs_of_nonneg (haagCoeff_nonneg k)]
      rfl
  have hshift : ∑' k, |cHi 67 (k+120)| = ∑' k, haagCoeff (k+120) := by
    apply tsum_congr
    intro k
    simp [cHi, show ¬ k+120 < 67 by omega, abs_of_nonneg (haagCoeff_nonneg _)]
  have hpi : Real.pi ≤ (355/113 : ℝ) := by linarith [Real.pi_lt_d20]
  have hnonneg : (0 : ℝ) ≤ (wallisChunk : ℝ) + (haagG 120 : ℝ)/240 := by
    have hr := haagR_pos 120
    have ht : (0 : ℚ) ≤ wallisChunk := Finset.sum_nonneg fun k _ => by
      split_ifs
      · exact le_rfl
      · exact (haagR_pos k).le
    have ht' : (0 : ℝ) ≤ (wallisChunk : ℝ) := by exact_mod_cast ht
    unfold haagG
    push_cast
    positivity
  calc
    (∑' k, |cHi 67 k|) = (∑ k ∈ range 120, |cHi 67 k|) +
        ∑' k, |cHi 67 (k+120)| :=
      ((summable_cHi 67).sum_add_tsum_nat_add 120).symm
    _ = Real.pi/4*(wallisChunk : ℝ) + ∑' k, haagCoeff (k+120) := by rw [hfinite, hshift]
    _ ≤ Real.pi/4*(wallisChunk : ℝ) + Real.pi/4*((haagG 120 : ℝ)/(2*120)) :=
      add_le_add_right (tsum_haagCoeff_tail_le 120 (by norm_num)) _
    _ = Real.pi/4*((wallisChunk : ℝ)+(haagG 120 : ℝ)/240) := by ring
    _ ≤ (355/113 : ℝ)/4*((wallisChunk : ℝ)+(haagG 120 : ℝ)/240) :=
      mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right hpi (by norm_num)) hnonneg
    _ ≤ (1 : ℝ)/268 := by
      have hc : (((355 : ℚ)/113/4 * (wallisChunk + haagG 120/240) : ℚ) : ℝ) ≤
          (((1 : ℚ)/268 : ℚ) : ℝ) := by
        exact_mod_cast wallis_rational_check
      push_cast at hc
      exact hc

def P : ℝ[X] := ofListQ pl

lemma norm_P : l1 P ≤ 1 :=
  (l1_ofListQ_le pl).trans (by norm_num [pl])

lemma degree_P : P.natDegree ≤ 37 := by
  simpa [P, pl] using natDegree_ofListQ_le pl

lemma norm_power : l1 (P^16) ≤ (ratio : ℝ) := by
  apply power_norm_of_check pl 16 593 ratio _ power_check
  exact lt_of_le_of_lt
    ((natDegree_pow_le).trans (Nat.mul_le_mul_left 16 degree_P)) (by norm_num)

/-- Finite-power cancellation for an arbitrary power r. The intended
application has r>0; the statement also remains true for r=0. -/
theorem compTerm_arbitrary_power_bound {R : ℝ[X]} (hR : l1 R ≤ 1)
    {q : ℝ} (hq0 : 0 ≤ q) (r : ℕ) (hpow : l1 (R^r) ≤ q) (k : ℕ) :
    l1 (compTerm R k) ≤ q^((2*k+1)/r) := by
  have he : 2*k+1 = r*((2*k+1)/r)+(2*k+1)%r :=
    (Nat.div_add_mod (2*k+1) r).symm
  have hrem : l1 (R^((2*k+1)%r)) ≤ 1 :=
    (l1_pow_le _ _).trans (pow_le_one₀ (l1_nonneg _) hR)
  have hp : l1 (R^(2*k+1)) ≤ q^((2*k+1)/r) := by
    conv_lhs => rw [he, pow_add, pow_mul]
    exact (l1_mul_le _ _).trans ((mul_le_mul
      ((l1_pow_le _ _).trans (pow_le_pow_left₀ (l1_nonneg _) hpow _))
      hrem (l1_nonneg _) (pow_nonneg hq0 _)).trans_eq (mul_one _))
  exact (l1_mul_le _ _).trans ((mul_le_mul
    ((l1_pow_le _ _).trans (by simp)) hp (l1_nonneg _) zero_le_one).trans_eq (one_mul _))

/-- A signed supported suffix retains a common arbitrary-power saving.
No positivity of the outer coefficient sequence is assumed. -/
theorem supported_composition_arbitrary_power_bound {c : ℕ → ℝ}
    (hc : Summable fun k => |c k|) {R : ℝ[X]} (hR : l1 R ≤ 1)
    {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (r : ℕ) (hpow : l1 (R^r) ≤ q)
    (K m : ℕ) (hm : m ≤ (2*K+1)/r) (hsupport : ∀ k, k < K → c k = 0) :
    ∑' n, |compCoeff c R n| ≤ q^m * ∑' k, |c k| := by
  let w : ℕ → ℝ := fun k => if k < K then 1 else q^m
  have hw0 : ∀ k, 0 ≤ w k := by
    intro k
    dsimp [w]
    split_ifs <;> positivity
  have hw1 : ∀ k, w k ≤ 1 := by
    intro k
    dsimp [w]
    split_ifs
    · exact le_rfl
    · exact pow_le_one₀ hq0 hq1
  have hterm : ∀ k, l1 (compTerm R k) ≤ w k := by
    intro k
    by_cases hk : k < K
    · simpa [w, hk] using l1_compTerm_le hR k
    · have he : m ≤ (2*k+1)/r :=
        hm.trans (Nat.div_le_div_right (by omega : 2*K+1 ≤ 2*k+1))
      exact (compTerm_arbitrary_power_bound hR hq0 r hpow k).trans
        (by simpa [w, hk] using pow_le_pow_of_le_one hq0 hq1 he)
  calc
    ∑' n, |compCoeff c R n| ≤ ∑' k, |c k| * w k :=
      weighted_composition hc hR w hw0 hw1 hterm
    _ = ∑' k, q^m * |c k| := by
      apply tsum_congr
      intro k
      by_cases hk : k < K
      · simp [w, hk, hsupport k hk]
      · simp [w, hk, mul_comm]
    _ = q^m * ∑' k, |c k| := tsum_mul_left

/-- The actual omitted outer phase blocks start at index 67, hence every
term receives at least ratio^8. No Wallis estimate is used yet. -/
lemma outer_composition_saving :
    ∑' n, |compCoeff (cHi 67) P n| ≤
      (ratio : ℝ)^8 * ∑' k, |cHi 67 k| := by
  exact supported_composition_arbitrary_power_bound (summable_cHi 67) norm_P
    (by norm_num [ratio]) (by norm_num [ratio]) 16 norm_power 67 8 (by norm_num)
    (fun k hk => by simp [cHi, hk])

/-- The paper's Wallis tail estimate is an explicit analytic input. -/
lemma outer_composition_bound
    (hWallis : (∑' k, |cHi 67 k|) ≤ (1 : ℝ)/268) :
    ∑' n, |compCoeff (cHi 67) P n| ≤ (ratio : ℝ)^8/268 := by
  calc
    ∑' n, |compCoeff (cHi 67) P n| ≤
        (ratio : ℝ)^8 * ∑' k, |cHi 67 k| := outer_composition_saving
    _ ≤ (ratio : ℝ)^8 * ((1 : ℝ)/268) :=
      mul_le_mul_of_nonneg_left hWallis (pow_nonneg (by norm_num [ratio]) 8)
    _ = (ratio : ℝ)^8/268 := by ring

/-! ## Exact rational ledger

The prefix, finite-block tail, other tails, selector mass and slope are the
unchanged published budgets identified in data/scalar-tail-refinement/PROOF.md.
Only the omitted outer reserve is replaced. All are raw, before selector
normalization. The ledger does not grant the inputs their Gaussian meaning.
-/

def branch5Weight : ℚ := 84679266306374373/5000000000000000000000
def slopeLower : ℚ := 17794910201410108363/25000000000000000000
def prefixUpper : ℚ := 67176837781129/62500000000000000000
def finite67Upper : ℚ := 1349588177898719/500000000000000000000000000
def otherTailsUpper : ℚ := 520112062885199/5000000000000000000000
def selectorMass : ℚ := 1250000000000000121997/1250000000000000000000
def outerReserve : ℚ := branch5Weight * ratio^8/268
def residualUpper : ℚ := prefixUpper + finite67Upper + otherTailsUpper + outerReserve
def scoreLower : ℚ := (slopeLower-residualUpper)/selectorMass
def reciprocalClaim : ℚ := 35122461/25000000

lemma branch5_outer_bound
    (hWallis : (∑' k, |cHi 67 k|) ≤ (1 : ℝ)/268) :
    (branch5Weight : ℝ) * (∑' n, |compCoeff (cHi 67) P n|) ≤
      (outerReserve : ℝ) := by
  calc
    (branch5Weight : ℝ) * (∑' n, |compCoeff (cHi 67) P n|) ≤
        (branch5Weight : ℝ) * ((ratio : ℝ)^8/268) :=
      mul_le_mul_of_nonneg_left (outer_composition_bound hWallis)
        (by norm_num [branch5Weight])
    _ = (outerReserve : ℝ) := by
      dsimp [outerReserve]
      push_cast
      ring

/-- Exact arithmetic including the selector mass, with a strict margin. -/
lemma ledger_acceptance :
    (1 : ℚ)/reciprocalClaim * selectorMass < slopeLower-residualUpper := by
  norm_num [reciprocalClaim, selectorMass, slopeLower, residualUpper,
    prefixUpper, finite67Upper, otherTailsUpper, outerReserve, branch5Weight, ratio]

lemma score_acceptance : (1 : ℚ)/reciprocalClaim < scoreLower := by
  unfold scoreLower
  exact (lt_div_iff₀ (by norm_num [selectorMass])).2 ledger_acceptance

/-- Parameterized arithmetic transfer. Each hypothesis must be supplied by
the published proof or a separate verified replay for the same raw mixture.
No valid-kernel or Grothendieck conclusion is asserted by this theorem. -/
theorem normalized_score_of_published_budgets
    (linear prefixCost finite67 otherTails outer mass : ℝ)
    (hlinear : (slopeLower : ℝ) ≤ linear)
    (hprefix : prefixCost ≤ (prefixUpper : ℝ))
    (hfinite67 : finite67 ≤ (finite67Upper : ℝ))
    (hother : otherTails ≤ (otherTailsUpper : ℝ))
    (houter : outer ≤ (outerReserve : ℝ))
    (hmass : mass = (selectorMass : ℝ)) :
    1/(reciprocalClaim : ℝ) <
      (linear-(prefixCost+finite67+otherTails+outer))/mass := by
  have hres : prefixCost+finite67+otherTails+outer ≤ (residualUpper : ℝ) := by
    calc
      prefixCost+finite67+otherTails+outer ≤
          (prefixUpper : ℝ)+finite67Upper+otherTailsUpper+outerReserve :=
        add_le_add (add_le_add (add_le_add hprefix hfinite67) hother) houter
      _ = (residualUpper : ℝ) := by
        dsimp [residualUpper]
        push_cast
        rfl
  have hmpos : 0 < mass := by rw [hmass]; norm_num [selectorMass]
  apply (lt_div_iff₀ hmpos).2
  calc
    1/(reciprocalClaim : ℝ)*mass =
        1/(reciprocalClaim : ℝ)*(selectorMass : ℝ) := by rw [hmass]
    _ < (slopeLower : ℝ)-(residualUpper : ℝ) := by
      exact_mod_cast ledger_acceptance
    _ ≤ linear-(prefixCost+finite67+otherTails+outer) := sub_le_sub hlinear hres

/-- The preceding score transfer with the improved outer tail proved above.
All remaining numerical and analytic inputs are still explicit hypotheses. -/
theorem refined_score_of_published_inputs
    (linear prefixCost finite67 otherTails mass : ℝ)
    (hlinear : (slopeLower : ℝ) ≤ linear)
    (hprefix : prefixCost ≤ (prefixUpper : ℝ))
    (hfinite67 : finite67 ≤ (finite67Upper : ℝ))
    (hother : otherTails ≤ (otherTailsUpper : ℝ))
    (hmass : mass = (selectorMass : ℝ))
    (hWallis : (∑' k, |cHi 67 k|) ≤ (1 : ℝ)/268) :
    1/(reciprocalClaim : ℝ) <
      (linear-(prefixCost+finite67+otherTails+
        (branch5Weight : ℝ)*(∑' n, |compCoeff (cHi 67) P n|)))/mass := by
  exact normalized_score_of_published_budgets linear prefixCost finite67 otherTails
    ((branch5Weight : ℝ)*(∑' n, |compCoeff (cHi 67) P n|)) mass
    hlinear hprefix hfinite67 hother (branch5_outer_bound hWallis) hmass

/-- The normalized score corollary needs only the published numerical
budgets: its Wallis input is discharged by wallis_tail_bound. The Gaussian
interpretation of the remaining budgets is not asserted by this theorem. -/
theorem refined_score_of_published_budgets
    (linear prefixCost finite67 otherTails mass : ℝ)
    (hlinear : (slopeLower : ℝ) ≤ linear)
    (hprefix : prefixCost ≤ (prefixUpper : ℝ))
    (hfinite67 : finite67 ≤ (finite67Upper : ℝ))
    (hother : otherTails ≤ (otherTailsUpper : ℝ))
    (hmass : mass = (selectorMass : ℝ)) :
    1/(reciprocalClaim : ℝ) <
      (linear-(prefixCost+finite67+otherTails+
        (branch5Weight : ℝ)*(∑' n, |compCoeff (cHi 67) P n|)))/mass := by
  exact refined_score_of_published_inputs linear prefixCost finite67 otherTails mass
    hlinear hprefix hfinite67 hother hmass wallis_tail_bound

