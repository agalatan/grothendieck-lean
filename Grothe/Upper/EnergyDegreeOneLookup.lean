namespace Grothe.Upper.EnergyDegreeOneLookup

private def rowValue (n m : ℕ) (row : GrotheKernel.RowQ) : ℚ :=
  if row.1 = m then
    (row.2.map fun entry => if entry.1 = n then entry.2 else 0).sum
  else 0

/-- Preserve every row and every matching entry, including duplicates.
This changes only evaluation order, so nonmatching rows need no entry decoding. -/
private theorem tabVal_rows (rows : List GrotheKernel.RowQ) (n m : ℕ) :
    tabVal rows (n, m) = (rows.map (rowValue n m)).sum := by
  induction rows with
  | nil => rfl
  | cons row rows ih =>
    have hr : (row.2.map fun entry =>
        if (entry.1, row.1) = (n, m) then entry.2 else 0).sum = rowValue n m row := by
      by_cases h : row.1 = m <;> simp [rowValue, h, Prod.mk.injEq]
    calc
      tabVal (row :: rows) (n, m) =
          (row.2.map fun entry =>
            if (entry.1, row.1) = (n, m) then entry.2 else 0).sum + tabVal rows (n, m) := by
        simp only [tabVal, flat, List.flatMap_cons, List.map_append, List.sum_append,
          List.map_map, Function.comp_def]
      _ = ((row :: rows).map (rowValue n m)).sum := by
        rw [hr, ih]
        rfl

