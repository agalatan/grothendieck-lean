private def splitCharAccum (sep : Char) : List Char → List Char → List (List Char)
  | [], acc => [acc.reverse]
  | c :: cs, acc => if c == sep then acc.reverse :: splitCharAccum sep cs []
      else splitCharAccum sep cs (c :: acc)

private theorem splitCharAccum_eq (sep : Char) (cs acc : List Char) :
    splitCharAccum sep cs acc = List.splitOnPPrepend (· == sep) cs acc := by
  induction cs generalizing acc with
  | nil => simp only [splitCharAccum, List.splitOnPPrepend_nil]
  | cons c cs ih =>
    simp only [splitCharAccum, List.splitOnPPrepend_cons_eq_ite, ih,
      List.splitOnPPrepend_nil_right]

private def splitChars (sep : Char) (cs : List Char) : List (List Char) :=
  splitCharAccum sep cs []

private theorem splitChars_eq (sep : Char) (cs : List Char) :
    splitChars sep cs = cs.splitOn sep := by
  rw [splitChars, splitCharAccum_eq, List.splitOnPPrepend_nil_right,
    List.splitOn_eq_splitOnP]

private theorem split_strings (s : String) (c : Char) :
    s.splitOn (String.ofList [c]) = (splitChars c s.toList).map String.ofList := by
  have h := congrArg (List.map String.ofList)
    (Grothe.UpperChaos.PackedDyadic.Structural.legacy_split_tokens s c)
  simpa only [List.map_map, Function.comp_def, String.ofList_toList,
    List.map_id_fun', id_eq, splitChars_eq] using h

/-- Certificates accept only decimal tokens from the actual source. A rejected
token proves nothing about the original parser's fallback behavior. -/
private def decimal? (cs : List Char) : Option ℕ :=
  if cs ≠ [] ∧ cs.all Char.isDigit then
    some (Nat.ofDigitChars 10 (cs.filter (· != '_')) 0)
  else none

private theorem natBang_of_some (s : String) (n : ℕ) (h : s.toNat? = some n) :
    s.toNat! = n := by
  have hn := String.isNat_of_toNat?_eq_some h
  change s.toSlice.isNat = true at hn
  change (if s.toSlice.isNat then some
    (s.toSlice.foldl (fun k c => if c = '_' then k else
      k * 10 + (c.toNat - '0'.toNat)) 0) else none) = some n at h
  change (if s.toSlice.isNat then
    s.toSlice.foldl (fun k c => if c = '_' then k else
      k * 10 + (c.toNat - '0'.toNat)) 0 else _) = n
  simpa only [hn, ite_true, Option.some.injEq] using h

private theorem decimal_correct (s : String) (n : ℕ)
    (h : decimal? s.toList = some n) : s.toNat! = n := by
  unfold decimal? at h
  split at h
  next hv =>
    have hn : s.isNat = true := String.isNat_of_isDigit
      (by simpa only [ne_eq, String.toList_eq_nil_iff] using hv.1)
      (fun c hc => List.all_eq_true.mp hv.2 c hc)
    apply natBang_of_some s n
    rw [String.toNat?_eq_some_ofDigitChars hn]
    exact h
  next _ => simp at h

private theorem mapM_correct {α β : Type} (f : α → Option β) (g : α → β)
    (hf : ∀ x y, f x = some y → g x = y) (xs : List α) (ys : List β)
    (h : xs.mapM f = some ys) : xs.map g = ys := by
  induction xs generalizing ys with
  | nil => simpa only [List.mapM_nil, Option.pure_def, Option.some.injEq] using h
  | cons x xs ih =>
    cases hx : f x with
    | none => simp [List.mapM_cons, hx] at h
    | some y =>
      cases hs : xs.mapM f with
      | none => simp [List.mapM_cons, hx, hs] at h
      | some zs =>
        have hy : y :: zs = ys := by simpa [List.mapM_cons, hx, hs] using h
        rw [← hy, List.map_cons, hf x y hx, ih zs hs]

private def entryValue? (n : ℕ) (cs : List Char) : Option ℚ :=
  match splitChars ',' cs with
  | [ns, aa, ks] => do
    let ni ← decimal? ns
    if ni = n then
      let a ← decimal? aa
      let k ← decimal? ks
      pure ((a : ℚ) / ((2 ^ k : ℕ) : ℚ))
    else pure 0
  | _ => none

private theorem entryValue_correct (s : String) (n : ℕ) (v : ℚ)
    (h : entryValue? n s.toList = some v) :
    (if (GrotheKernel.parseEntry s).1 = n then (GrotheKernel.parseEntry s).2 else 0) = v := by
  unfold entryValue? at h
  split at h
  next ns aa ks hfields =>
    have hsplit : s.splitOn "," = [String.ofList ns, String.ofList aa, String.ofList ks] := by
      rw [show "," = String.ofList [','] from rfl, split_strings, hfields]
      rfl
    cases hns : decimal? ns with
    | none => simp [hns] at h
    | some ni =>
      have hn := decimal_correct (String.ofList ns) ni (by simpa using hns)
      by_cases he : ni = n
      · cases haa : decimal? aa with
        | none => simp [hns, he, haa] at h
        | some a =>
          cases hks : decimal? ks with
          | none => simp [hns, he, haa, hks] at h
          | some k =>
            have ha := decimal_correct (String.ofList aa) a (by simpa using haa)
            have hk := decimal_correct (String.ofList ks) k (by simpa using hks)
            have hv : (a : ℚ) / ((2 ^ k : ℕ) : ℚ) = v := by
              simpa [hns, he, haa, hks] using h
            simpa only [GrotheKernel.parseEntry, hsplit, hn, ha, hk, he, ite_true] using hv
      · have hv : (0 : ℚ) = v := by simpa [hns, he] using h
        simpa only [GrotheKernel.parseEntry, hsplit, hn, he, ite_false] using hv
  next _ => simp at h

private def rowValue (n m : ℕ) (row : GrotheKernel.RowQ) : ℚ :=
  if row.1 = m then
    (row.2.map fun entry => if entry.1 = n then entry.2 else 0).sum
  else 0

private def rowValue? (n m : ℕ) (cs : List Char) : Option ℚ :=
  match splitChars ':' cs with
  | [ms, es] => do
    let mi ← decimal? ms
    if mi = m then
      let values ← (splitChars ';' es).mapM (entryValue? n)
      pure values.sum
    else pure 0
  | _ => none

/-- This one-sided certificate refers to the unchanged parser. Every source
row is checked, and all duplicate matching entries still contribute. -/
private theorem rowValue_correct (s : String) (n m : ℕ) (v : ℚ)
    (h : rowValue? n m s.toList = some v) : rowValue n m (GrotheKernel.parseRow s) = v := by
  unfold rowValue? at h
  split at h
  next ms es hfields =>
    have hsplit : s.splitOn ":" = [String.ofList ms, String.ofList es] := by
      rw [show ":" = String.ofList [':'] from rfl, split_strings, hfields]
      rfl
    cases hms : decimal? ms with
    | none => simp [hms] at h
    | some mi =>
      have hm := decimal_correct (String.ofList ms) mi (by simpa using hms)
      by_cases he : mi = m
      · cases hvalues : (splitChars ';' es).mapM (entryValue? n) with
        | none => simp [hms, he, hvalues] at h
        | some vs =>
          have hv : vs.sum = v := by simpa [hms, he, hvalues] using h
          have hmap := mapM_correct (entryValue? n)
            (fun cs => if (GrotheKernel.parseEntry (String.ofList cs)).1 = n then
              (GrotheKernel.parseEntry (String.ofList cs)).2 else 0)
            (fun cs value hc => entryValue_correct (String.ofList cs) n value
              (by simpa only [String.toList_ofList] using hc))
            (splitChars ';' es) vs hvalues
          have hentries : (String.ofList es).splitOn ";" =
              (splitChars ';' es).map String.ofList := by
            simpa only [String.toList_ofList] using split_strings (String.ofList es) ';'
          simpa only [GrotheKernel.parseRow, hsplit, rowValue, hm, he, ite_true,
            hentries, List.map_map, Function.comp_def, hmap] using hv
      · have hv : (0 : ℚ) = v := by simpa [hms, he] using h
        simpa only [GrotheKernel.parseRow, hsplit, rowValue, hm, he, ite_false] using hv
  next _ => simp at h

/-- Preserve every row and every matching entry, including duplicates.
This changes only evaluation order, so nonmatching rows need no entry decoding. -/
private theorem tabVal_rows (rows : List GrotheKernel.RowQ) (n m : ℕ) :
    tabVal rows (n, m) = (rows.map (rowValue n m)).sum := by
  induction rows with
  | nil => rfl
  | cons row rows ih =>
    have hr : (row.2.map fun entry =>
        if (entry.1, row.1) = (n, m) then entry.2 else 0).sum = rowValue n m row := by
      by_cases h : row.1 = m <;> simp [rowValue, h, Prod.mk.injEq]
    calc
      tabVal (row :: rows) (n, m) =
          (row.2.map fun entry =>
            if (entry.1, row.1) = (n, m) then entry.2 else 0).sum + tabVal rows (n, m) := by
        simp only [tabVal, flat, List.flatMap_cons, List.map_append, List.sum_append,
          List.map_map, Function.comp_def]
      _ = ((row :: rows).map (rowValue n m)).sum := by
        rw [hr, ih]
        rfl

private def tableValue? (n m : ℕ) : Option ℚ := do
  let rows ← energyStrs.mapM (fun s => rowValue? n m s.toList)
  pure rows.sum

private theorem tableValue_correct (n m : ℕ) (v : ℚ) (h : tableValue? n m = some v) :
    energyTable (n, m) = v := by
  unfold tableValue? at h
  cases hrows : energyStrs.mapM (fun s => rowValue? n m s.toList) with
  | none => simp [hrows] at h
  | some values =>
    have hv : values.sum = v := by simpa [hrows] using h
    have hmap := mapM_correct (fun s => rowValue? n m s.toList)
      (fun s => rowValue n m (GrotheKernel.parseRow s))
      (fun s value hs => rowValue_correct s n m value hs) energyStrs values hrows
    unfold energyTable
    rw [tabVal_rows]
    simpa only [energyRows, List.map_map, Function.comp_def, hmap] using hv

theorem one_zero : energyTable (1, 0) =
