        then secondGradeEnergy q else 0) = secondCenterBandIntegerEnergy 2 := by
  decide +kernel

theorem second_band3_arithmetic :
    (∑ q ∈ Finset.range 46,
      if secondCenterBandLo 3 < 2*q+1 ∧ 2*q+1 ≤ secondCenterBandHi 3
        then secondGradeEnergy q else 0) = secondCenterBandIntegerEnergy 3 := by
  decide +kernel

theorem second_band_arithmetic (k : Fin 4) :
    (∑ q ∈ Finset.range 46,
      if secondCenterBandLo k < 2*q+1 ∧ 2*q+1 ≤ secondCenterBandHi k
        then secondGradeEnergy q else 0) = secondCenterBandIntegerEnergy k := by
  fin_cases k
  · exact second_band0_arithmetic
  · exact second_band1_arithmetic
  · exact second_band2_arithmetic
  · exact second_band3_arithmetic

end Grothe.UpperChaos.FirstSecondGradeEnergyTargets

