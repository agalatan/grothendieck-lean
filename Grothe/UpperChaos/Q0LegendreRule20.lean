theorem count : brackets.length = 20 := by decide +kernel
theorem bounded : brackets.all (fun p => decide (-denominator < p.1 ∧ p.1 < p.2 ∧ p.2 < denominator)) = true := by
  decide +kernel
theorem ordered : brackets.Pairwise (fun a b => a.2 < b.1) := by decide +kernel

theorem exists_each (i : Fin brackets.length) :
    ∃ x ∈ Set.Icc (((brackets.get i).1 : ℝ) / denominator) (((brackets.get i).2 : ℝ) / denominator), (realPair x 19).2 = 0 := by
  fin_cases i
  · simpa [brackets] using root00
  · simpa [brackets] using root01
  · simpa [brackets] using root02
  · simpa [brackets] using root03
  · simpa [brackets] using root04
  · simpa [brackets] using root05
  · simpa [brackets] using root06
  · simpa [brackets] using root07
  · simpa [brackets] using root08
  · simpa [brackets] using root09
  · simpa [brackets] using root10
  · simpa [brackets] using root11
  · simpa [brackets] using root12
  · simpa [brackets] using root13
  · simpa [brackets] using root14
  · simpa [brackets] using root15
  · simpa [brackets] using root16
  · simpa [brackets] using root17
  · simpa [brackets] using root18
  · simpa [brackets] using root19

def bracketAt (i : Fin 20) : ℤ × ℤ :=
  brackets.get ⟨i.val, by simpa only [count] using i.isLt⟩

theorem all_unique : ∃ root : Fin 20 → ℝ,
    (∀ i, root i ∈ Set.Icc (((bracketAt i).1 : ℝ) / denominator) (((bracketAt i).2 : ℝ) / denominator) ∧ (realPair (root i) 19).2 = 0) ∧
    (∀ i x, x ∈ Set.Icc (((bracketAt i).1 : ℝ) / denominator) (((bracketAt i).2 : ℝ) / denominator) → (realPair x 19).2 = 0 → x = root i) := by
  exact select_from_ordered_brackets 19 brackets count denominator denominator_pos ordered exists_each

end Grothe.UpperChaos.Q0LegendreRule20
