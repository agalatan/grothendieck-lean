def bracketAt (i : Fin 19) : ℤ × ℤ :=
  brackets.get ⟨i.val, by simpa only [count] using i.isLt⟩

theorem all_unique : ∃ root : Fin 19 → ℝ,
    (∀ i, root i ∈ Set.Icc (((bracketAt i).1 : ℝ) / denominator) (((bracketAt i).2 : ℝ) / denominator) ∧ (realPair (root i) 18).2 = 0) ∧
    (∀ i x, x ∈ Set.Icc (((bracketAt i).1 : ℝ) / denominator) (((bracketAt i).2 : ℝ) / denominator) → (realPair x 18).2 = 0 → x = root i) := by
  exact select_from_ordered_brackets 18 brackets count denominator denominator_pos ordered exists_each

end Grothe.UpperChaos.Q0LegendreRule19
