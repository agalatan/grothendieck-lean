theorem pair_contains (x y : ℝ) (hx : |x| ≤ 1) (hy : |y| ≤ 1) :
    Contains firstOutputModel x y
      (Q0BasePairKernel.first (1 / 1000000000000000) (radial x) (q0Kappa (radial x)) (auxiliary y)) ∧
