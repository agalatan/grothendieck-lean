theorem all_unique : ∃ root : Fin 29 → ℝ,
    (∀ i, root i ∈ Set.Icc (((bracketAt i).1 : ℝ) / denominator) (((bracketAt i).2 : ℝ) / denominator) ∧ (realPair (root i) 28).2 = 0) ∧
    (∀ i x, x ∈ Set.Icc (((bracketAt i).1 : ℝ) / denominator) (((bracketAt i).2 : ℝ) / denominator) → (realPair x 28).2 = 0 → x = root i) := by
  exact select_from_ordered_brackets 28 brackets count denominator denominator_pos ordered exists_each

