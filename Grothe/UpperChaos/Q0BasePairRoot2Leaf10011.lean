  have hdenominatorProduct : Contains denominatorProductModel x y (k^2 * u^2) := by
    simpa only [pow_two, div_eq_mul_inv] using mul_sound profile2Model aux2Model denominatorProductModel (3626320890478622134391416107 / 365375409332725729550921208179070754913983135744) denominatorProduct_checked hx hy hprofile2 haux2

