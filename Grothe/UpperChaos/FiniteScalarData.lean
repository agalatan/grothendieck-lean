set_option warningAsError true

namespace Grothe.UpperChaos.TwoBlockSoundnessDraft
noncomputable section
open Q0GaussAddressScan Q0GaussOrdinalEquiv

abbrev MassRow := Q0NodeMassCheck.Row

def massRow (i : Fin 21577) : MassRow :=
  Q0NodeMassAll.rows.get ⟨i.val, by simpa only [Q0NodeMassAll.count] using i.isLt⟩

theorem massRow_mem (i : Fin 21577) : massRow i ∈ Q0NodeMassAll.rows :=
  List.get_mem _ _

theorem massRow_index (i : Fin 21577) : (massRow i).index = i.val := by
  have h : (Q0NodeMassAll.rows.map Q0NodeMassCheck.Row.index).get
      ⟨i.val, by simpa only [List.length_map, Q0NodeMassAll.count] using i.isLt⟩ = i.val := by
    simp only [Q0NodeMassAll.indices, List.get_eq_getElem, List.getElem_range'_1,
      Nat.zero_add]
  simpa only [massRow, List.get_eq_getElem, List.getElem_map] using h

def row (a : Address) : MassRow := massRow (fromAddress a)

def maskNat (a : Address) : ℕ :=
  if Q0SourceExceptionGeometry.exceptionalPanel a.1.val then 0 else 1

abbrev UpperTable := Fin sourcePanels.length → ℕ

def originalUpper : UpperTable := fun p =>
  Int.toNat (⌈(sourcePanels.get p).hi * (10^9 : ℚ)⌉ : ℤ)

end
end Grothe.UpperChaos.TwoBlockSoundnessDraft

namespace Grothe.UpperChaos.TwoBlockIntegerCheckerDraft
noncomputable section
open Q0GaussOrdinalEquiv TwoBlockSoundnessDraft

def scalarNumerator (U : UpperTable) : ℤ :=
  ∑ a : Address, (maskNat a : ℤ) * (row a).termUpper * (U a.1 : ℤ)^251

def scalarSumLiteral : ℤ := 

end
end Grothe.UpperChaos.TwoBlockIntegerCheckerDraft

open Lean Elab Command
run_cmd do
  for target in #[``Grothe.UpperChaos.TwoBlockSoundnessDraft.MassRow,
      ``Grothe.UpperChaos.TwoBlockSoundnessDraft.massRow,
      ``Grothe.UpperChaos.TwoBlockSoundnessDraft.massRow_mem,
      ``Grothe.UpperChaos.TwoBlockSoundnessDraft.massRow_index,
      ``Grothe.UpperChaos.TwoBlockSoundnessDraft.row,
      ``Grothe.UpperChaos.TwoBlockSoundnessDraft.maskNat,
      ``Grothe.UpperChaos.TwoBlockSoundnessDraft.UpperTable,
      ``Grothe.UpperChaos.TwoBlockSoundnessDraft.originalUpper,
      ``Grothe.UpperChaos.TwoBlockIntegerCheckerDraft.scalarNumerator,
