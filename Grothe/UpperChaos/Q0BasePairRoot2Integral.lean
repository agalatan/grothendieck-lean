private theorem leaf1111_mem :
    root.rightAux.rightAux.rightAux.rightAux.integral (directFirst (1 / 1000000000000000)) ∈
        Q0BasePairRoot2Leaf1111.firstInterval ∧
      root.rightAux.rightAux.rightAux.rightAux.integral (directCompanion (1 / 1000000000000000)) ∈
        Q0BasePairRoot2Leaf1111.companionInterval := by
  rw [leaf1111_eq]
  simpa only [Rect.integral, Rat.cast_div, Rat.cast_zero, Rat.cast_one,
    Rat.cast_ofNat, div_one, zero_div] using
    Q0BasePairRoot2Leaf1111.integrals_mem

/-- Exact addition of the checked first-component model integrals. -/
def firstInterval : IntervalRat :=
  (IntervalRat.add (IntervalRat.add (IntervalRat.add (IntervalRat.add Q0BasePairRoot2Leaf0000.firstInterval
          Q0BasePairRoot2Leaf0001.firstInterval)
        (IntervalRat.add Q0BasePairRoot2Leaf0010.firstInterval
          Q0BasePairRoot2Leaf0011.firstInterval))
      (IntervalRat.add (IntervalRat.add Q0BasePairRoot2Leaf0100.firstInterval
          Q0BasePairRoot2Leaf0101.firstInterval)
        (IntervalRat.add (IntervalRat.add Q0BasePairRoot2Leaf01100.firstInterval
            Q0BasePairRoot2Leaf01101.firstInterval)
          (IntervalRat.add Q0BasePairRoot2Leaf01110.firstInterval
            Q0BasePairRoot2Leaf01111.firstInterval))))
    (IntervalRat.add (IntervalRat.add (IntervalRat.add (IntervalRat.add Q0BasePairRoot2Leaf10000.firstInterval
            Q0BasePairRoot2Leaf10001.firstInterval)
          (IntervalRat.add Q0BasePairRoot2Leaf10010.firstInterval
            Q0BasePairRoot2Leaf10011.firstInterval))
        (IntervalRat.add (IntervalRat.add Q0BasePairRoot2Leaf10100.firstInterval
            Q0BasePairRoot2Leaf10101.firstInterval)
          (IntervalRat.add Q0BasePairRoot2Leaf10110.firstInterval
            Q0BasePairRoot2Leaf10111.firstInterval)))
      (IntervalRat.add (IntervalRat.add (IntervalRat.add Q0BasePairRoot2Leaf11000.firstInterval
            Q0BasePairRoot2Leaf11001.firstInterval)
          (IntervalRat.add Q0BasePairRoot2Leaf11010.firstInterval
            Q0BasePairRoot2Leaf11011.firstInterval))
        (IntervalRat.add Q0BasePairRoot2Leaf1110.firstInterval
          Q0BasePairRoot2Leaf1111.firstInterval))))

/-- Exact addition of the checked signed companion model integrals. -/
def companionInterval : IntervalRat :=
  (IntervalRat.add (IntervalRat.add (IntervalRat.add (IntervalRat.add Q0BasePairRoot2Leaf0000.companionInterval
          Q0BasePairRoot2Leaf0001.companionInterval)
        (IntervalRat.add Q0BasePairRoot2Leaf0010.companionInterval
          Q0BasePairRoot2Leaf0011.companionInterval))
      (IntervalRat.add (IntervalRat.add Q0BasePairRoot2Leaf0100.companionInterval
          Q0BasePairRoot2Leaf0101.companionInterval)
        (IntervalRat.add (IntervalRat.add Q0BasePairRoot2Leaf01100.companionInterval
            Q0BasePairRoot2Leaf01101.companionInterval)
          (IntervalRat.add Q0BasePairRoot2Leaf01110.companionInterval
            Q0BasePairRoot2Leaf01111.companionInterval))))
    (IntervalRat.add (IntervalRat.add (IntervalRat.add (IntervalRat.add Q0BasePairRoot2Leaf10000.companionInterval
            Q0BasePairRoot2Leaf10001.companionInterval)
          (IntervalRat.add Q0BasePairRoot2Leaf10010.companionInterval
            Q0BasePairRoot2Leaf10011.companionInterval))
        (IntervalRat.add (IntervalRat.add Q0BasePairRoot2Leaf10100.companionInterval
            Q0BasePairRoot2Leaf10101.companionInterval)
          (IntervalRat.add Q0BasePairRoot2Leaf10110.companionInterval
            Q0BasePairRoot2Leaf10111.companionInterval)))
      (IntervalRat.add (IntervalRat.add (IntervalRat.add Q0BasePairRoot2Leaf11000.companionInterval
            Q0BasePairRoot2Leaf11001.companionInterval)
          (IntervalRat.add Q0BasePairRoot2Leaf11010.companionInterval
            Q0BasePairRoot2Leaf11011.companionInterval))
        (IntervalRat.add Q0BasePairRoot2Leaf1110.companionInterval
          Q0BasePairRoot2Leaf1111.companionInterval))))

/-- Global direct-kernel continuity justifies each exact midpoint split. -/
private theorem combine (r : Rect) (hr : r.Valid)
    {F0 F1 C0 C1 : IntervalRat}
    (h0 : r.leftAux.integral (directFirst (1 / 1000000000000000)) ∈ F0 ∧
      r.leftAux.integral (directCompanion (1 / 1000000000000000)) ∈ C0)
    (h1 : r.rightAux.integral (directFirst (1 / 1000000000000000)) ∈ F1 ∧
      r.rightAux.integral (directCompanion (1 / 1000000000000000)) ∈ C1) :
    r.integral (directFirst (1 / 1000000000000000)) ∈ IntervalRat.add F0 F1 ∧
      r.integral (directCompanion (1 / 1000000000000000)) ∈
        IntervalRat.add C0 C1 := by
  have hc := continuous_direct_pair (1 / 1000000000000000)
  exact ⟨r.integral_mem_add_splitAux hr _ hc.1.continuousOn h0.1 h1.1,
    r.integral_mem_add_splitAux hr _ hc.2.continuousOn h0.2 h1.2⟩

/-- All twenty-four checked leaves close the whole root, without numerical premises. -/
theorem integrals_mem :
    root.integral (directFirst (1 / 1000000000000000)) ∈ firstInterval ∧
      root.integral (directCompanion (1 / 1000000000000000)) ∈
        companionInterval := by
  have h000 := combine (root.leftAux.leftAux.leftAux) (by decide +kernel) leaf0000_mem leaf0001_mem
  have h001 := combine (root.leftAux.leftAux.rightAux) (by decide +kernel) leaf0010_mem leaf0011_mem
  have h00 := combine (root.leftAux.leftAux) (by decide +kernel) h000 h001
  have h010 := combine (root.leftAux.rightAux.leftAux) (by decide +kernel) leaf0100_mem leaf0101_mem
  have h0110 := combine (root.leftAux.rightAux.rightAux.leftAux) (by decide +kernel) leaf01100_mem leaf01101_mem
  have h0111 := combine (root.leftAux.rightAux.rightAux.rightAux) (by decide +kernel) leaf01110_mem leaf01111_mem
  have h011 := combine (root.leftAux.rightAux.rightAux) (by decide +kernel) h0110 h0111
  have h01 := combine (root.leftAux.rightAux) (by decide +kernel) h010 h011
  have h0 := combine (root.leftAux) (by decide +kernel) h00 h01
  have h1000 := combine (root.rightAux.leftAux.leftAux.leftAux) (by decide +kernel) leaf10000_mem leaf10001_mem
  have h1001 := combine (root.rightAux.leftAux.leftAux.rightAux) (by decide +kernel) leaf10010_mem leaf10011_mem
  have h100 := combine (root.rightAux.leftAux.leftAux) (by decide +kernel) h1000 h1001
  have h1010 := combine (root.rightAux.leftAux.rightAux.leftAux) (by decide +kernel) leaf10100_mem leaf10101_mem
  have h1011 := combine (root.rightAux.leftAux.rightAux.rightAux) (by decide +kernel) leaf10110_mem leaf10111_mem
  have h101 := combine (root.rightAux.leftAux.rightAux) (by decide +kernel) h1010 h1011
  have h10 := combine (root.rightAux.leftAux) (by decide +kernel) h100 h101
  have h1100 := combine (root.rightAux.rightAux.leftAux.leftAux) (by decide +kernel) leaf11000_mem leaf11001_mem
  have h1101 := combine (root.rightAux.rightAux.leftAux.rightAux) (by decide +kernel) leaf11010_mem leaf11011_mem
  have h110 := combine (root.rightAux.rightAux.leftAux) (by decide +kernel) h1100 h1101
  have h111 := combine (root.rightAux.rightAux.rightAux) (by decide +kernel) leaf1110_mem leaf1111_mem
  have h11 := combine (root.rightAux.rightAux) (by decide +kernel) h110 h111
  have h1 := combine (root.rightAux) (by decide +kernel) h10 h11
  have hroot := combine (root) root_valid h0 h1
  exact hroot

theorem first_integral_mem :
    root.integral (directFirst (1 / 1000000000000000)) ∈ firstInterval :=
  integrals_mem.1

theorem companion_integral_mem :
    root.integral (directCompanion (1 / 1000000000000000)) ∈ companionInterval :=
  integrals_mem.2

/-- The same completed pair attached to the canonical retained root. -/
theorem fixed_root_integrals_mem :
    (AdaptiveRetainedCoefficient.regularRoot 1).integral
        (directFirst (1 / 1000000000000000)) ∈ firstInterval ∧
      (AdaptiveRetainedCoefficient.regularRoot 1).integral
        (directCompanion (1 / 1000000000000000)) ∈ companionInterval := by
  rw [← root_eq_fixed]
  exact integrals_mem

end Grothe.UpperChaos.Q0BasePairRoot2Integral
