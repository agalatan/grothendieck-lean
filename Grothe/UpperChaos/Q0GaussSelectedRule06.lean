    fin_cases i
    · simpa [lower] using lowerr00
    · simpa [lower] using lowerr01
    · simpa [lower] using lowerr02
    · simpa [lower] using lowerr03
    · simpa [lower] using lowerr04
    · simpa [lower] using lowerr05
  weight_le := by
    intro i
    fin_cases i
    · simpa [upper] using weightr00
    · simpa [upper] using weightr01
    · simpa [upper] using weightr02
    · simpa [upper] using weightr03
    · simpa [upper] using weightr04
    · simpa [upper] using weightr05
  injective := by
    apply injective_of_ordered_integer_brackets 6 Grothe.UpperChaos.Q0LegendreRule06.brackets
      Grothe.UpperChaos.Q0LegendreRule06.count denominator denominator_pos Grothe.UpperChaos.Q0LegendreRule06.ordered root
    intro i
    simpa only [Grothe.UpperChaos.Q0LegendreRule06.bracketAt] using (root_spec i).1

def indexedContext : Array (ℚ × ℚ) := #[(Grothe.UpperChaos.Q0LegendreWeightRule06.r00Interval.lo.toRat, Grothe.UpperChaos.Q0LegendreWeightRule06.r00Upper), (Grothe.UpperChaos.Q0LegendreWeightRule06.r01Interval.lo.toRat, Grothe.UpperChaos.Q0LegendreWeightRule06.r01Upper), (Grothe.UpperChaos.Q0LegendreWeightRule06.r02Interval.lo.toRat, Grothe.UpperChaos.Q0LegendreWeightRule06.r02Upper), (Grothe.UpperChaos.Q0LegendreWeightRule06.r03Interval.lo.toRat, Grothe.UpperChaos.Q0LegendreWeightRule06.r03Upper), (Grothe.UpperChaos.Q0LegendreWeightRule06.r04Interval.lo.toRat, Grothe.UpperChaos.Q0LegendreWeightRule06.r04Upper), (Grothe.UpperChaos.Q0LegendreWeightRule06.r05Interval.lo.toRat, Grothe.UpperChaos.Q0LegendreWeightRule06.r05Upper)]

theorem context_lookup (i : Fin 6) :
    indexedContext[i.val]? = some (selected.lower i, selected.upper i) := by
  fin_cases i <;> rfl

end Grothe.UpperChaos.Q0GaussSelectedRule06

