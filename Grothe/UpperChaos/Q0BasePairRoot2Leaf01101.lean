    (∫ u in ((13 / 32) : ℝ)..(7 / 16), ∫ s in ((6881023 / 500000) : ℝ)..(6946559 / 500000),
      Q0BasePairKernelContinuity.directFirst (1 / 1000000000000000) s u) ∈ firstInterval ∧
