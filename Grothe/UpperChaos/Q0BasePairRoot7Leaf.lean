/-- Both actual signed kernels are enclosed, with no numerical hypotheses. -/
theorem pair_contains (x y : ℝ) (hx : |x| ≤ 1) (hy : |y| ≤ 1) :
    Contains firstOutputModel x y
      (Q0BasePairKernel.reciprocalFirst (1 / 1000000000000000) (radial x) (q0Kappa (radial x)) (auxiliary y)) ∧
    Contains companionOutputModel x y
      (Q0BasePairKernel.reciprocalCompanion (1 / 1000000000000000) (radial x) (q0Kappa (radial x)) (auxiliary y)) := by
  let s := radial x
  let u := auxiliary y
  let k := q0Kappa s
  have hs : Contains sModel x y s := by
    simpa only [s, radial, Rat.cast_div, Rat.cast_one, Rat.cast_ofNat] using
      RectangleCoordinates.x_sound (20819997 / 1000000) (32 / 15625) sModel (by decide +kernel) hx hy
  have haux : Contains auxModel x y u := by
    simpa only [u, auxiliary, Rat.cast_div, Rat.cast_one, Rat.cast_ofNat] using
      RectangleCoordinates.y_sound (1501 / 1600) (99 / 1600) auxModel (by decide +kernel) hx hy
  have hprofile : Contains profileModel x y k :=
    Q0ProfileRectangleModel.profile_of_trace sModel profiletrace profile_checked hx hy hs
  have hone : Contains oneModel x y (1 : ℝ) := by
    simpa [oneModel, constant, IntervalRat.singleton] using contains_constant 1 x y

  have haux2 : Contains aux2Model x y (u^2) := by
    simpa only [pow_two, div_eq_mul_inv] using mul_sound auxModel auxModel aux2Model (1 / 1461501637330902918203684832716283019655932542976) aux2_checked hx hy haux haux

  have hprofile2 : Contains profile2Model x y (k^2) := by
    simpa only [pow_two, div_eq_mul_inv] using mul_sound profileModel profileModel profile2Model (121598887566121 / 1461501637330902918203684832716283019655932542976) profile2_checked hx hy hprofile hprofile

  have hdenominator : Contains denominatorModel x y ((u^2 + k^2)) := by
    simpa only [sub_eq_add_neg] using add_sound aux2Model profile2Model denominatorModel (0 / 1) denominator_checked hx hy haux2 hprofile2

  have hinverse : Contains inverseModel x y ((u^2 + k^2)⁻¹) :=
    RectangleReciprocalCertificate.sound denominatorModel inverseCertificate
      inverse_checked hx hy hdenominator

  have hargument : Contains argumentModel x y ((s / (u^2 + k^2))) := by
    simpa only [pow_two, div_eq_mul_inv] using mul_sound sModel inverseModel argumentModel (64573204307109287408199720710059955 / 1461501637330902918203684832716283019655932542976) argument_checked hx hy hs hinverse

  have hnegS : Contains negSModel x y (-s) := by
    convert scale_sound (-1 / 1) sModel negSModel (0 / 1) negS_checked hx hy hs using 1
    push_cast
    ring

  have hnegArgumentForGaussian : Contains negArgumentForGaussianModel x y (-(s / (u^2 + k^2))) := by
    convert scale_sound (-1 / 1) argumentModel negArgumentForGaussianModel (0 / 1) negArgumentForGaussian_checked hx hy hargument using 1
    push_cast
    ring

  have hgaussianArgument : Contains gaussianArgumentModel x y (-s - (s / (u^2 + k^2))) := by
    simpa only [sub_eq_add_neg] using add_sound negSModel negArgumentForGaussianModel gaussianArgumentModel (0 / 1) gaussianArgument_checked hx hy hnegS hnegArgumentForGaussian

  have hgaussian : Contains gaussianModel x y (Real.exp (-s - (s / (u^2 + k^2)))) :=
    RectangleExpCertificate.sound gaussianArgumentModel gaussianCertificate
      gaussian_checked Q0BasePairRoot7LeafScalars.exp_center0_mem hx hy hgaussianArgument

  have hcommon := commonCertificate.reciprocal_sound (1 / 1000000000000000)
    auxModel gaussianModel inverseModel common_verified hx hy haux hgaussian hinverse
  simpa only [Rat.cast_div, Rat.cast_one, Rat.cast_ofNat, s, k, u, pairCertificate] using
    pairCertificate.reciprocal_sound sModel profileModel argumentModel commonModel
      pair_checked hx hy hs hprofile hargument hcommon


