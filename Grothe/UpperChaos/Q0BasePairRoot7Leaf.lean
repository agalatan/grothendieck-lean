  have h := Q0BasePairCellIntegral.reciprocal_pair_integral_mem (1 / 1000000000000000)
    (20819997 / 1000000) (32 / 15625) (1501 / 1600) (99 / 1600) firstOutputModel companionOutputModel
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (fun x y hx hy => by
      simpa only [Q0BasePairKernelContinuity.reciprocalFirst,
        Q0BasePairKernelContinuity.reciprocalCompanion, radial, auxiliary,
