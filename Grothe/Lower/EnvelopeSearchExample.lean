-- Grothe/Lower/EnvelopeSearchExample.lean
import Grothe.Lower.EnvelopeSearch
import Grothe.Lower.RowData01
import Grothe.Lower.RowData02
import Grothe.Lower.RowData03
import Grothe.LowerAnalytic.Rows

/-!
# An adaptive envelope from three production rows

The first three certified-row data sets supply the scalar envelopes on
`[2/5, 3/5]`. The partition is generated by the search: no cut positions or
leaf witnesses are stored in this file. No single source row covers this whole
interval at `69702/100000`; the adaptive search succeeds at depth seven.

The consumer retains the existing `RowHolds` hypotheses. This is a prototype
for the exterior interval, not a new global Grothendieck bound.

Agent-ID: codex-6a2f. Refs #462.
-/

set_option maxRecDepth 4096
set_option maxHeartbeats 2000000

namespace Grothe.Lower.EnvelopeSearch.Example

/-- The scalar quadratic obtained by discarding a production row's square. -/
def rowQuad (r : Row) : Quad :=
  (r.ell, 2 * r.beta ^ 2 / ε + r.cap + capPad)

/-- Actual production data, with no duplicated numerical headers. -/
def sourceRows : List Row := [row01, row02, row03]

def productionRows : List Quad := sourceRows.map rowQuad

def domain : Interval := ⟨2 / 5, 3 / 5⟩

/-- Six subdivision levels are insufficient for these data and this test. -/
theorem depthSix_fails : search productionRows (69702 / 100000) 6 domain = none := by
  decide +kernel

/-- The successful tree is computed, rather than serialized as a certificate. -/
theorem depthSeven_succeeds :
    (search productionRows (69702 / 100000) 7 domain).isSome = true := by
  decide +kernel

/-- A stronger run supplies a uniform margin for the completeness theorem. -/
theorem depthEight_stronger :
    (search productionRows (697 / 1000) 8 domain).isSome = true := by
  decide +kernel

/-- Failure at depth six excludes every accepted midpoint partition of that
height, not just the particular execution that was tested. -/
theorem production_minimum_height (tree : AdaptiveSearch.Tree)
    (hvalid : AdaptiveSearch.valid (test productionRows (69702 / 100000))
      Interval.left Interval.right tree domain = true) :
    7 ≤ tree.height :=
  Nat.succ_le_of_lt (AdaptiveSearch.height_gt_of_search_none _ _ _ depthSix_fails hvalid)

/-- A generated partition attains the least possible accepted height. -/
theorem production_optimal_height : ∃ tree : AdaptiveSearch.Tree,
    AdaptiveSearch.valid (test productionRows (69702 / 100000))
      Interval.left Interval.right tree domain = true ∧ tree.height = 7 := by
  have hs := depthSeven_succeeds
  cases h : search productionRows (69702 / 100000) 7 domain with
  | none => simp [h] at hs
  | some tree =>
    exact ⟨tree, AdaptiveSearch.search_sound _ _ _ h,
      AdaptiveSearch.search_height_eq_of_previous_failure _ _ _ depthSix_fails h⟩

/-- Every real point belongs to some successful source-row envelope. -/
theorem production_envelope (t : ℝ) (ht : (2 / 5 : ℝ) ≤ t)
    (ht' : t ≤ (3 / 5 : ℝ)) :
    ∃ r ∈ productionRows, value r t ≤ (69702 / 100000 : ℝ) := by
  have hs := depthSeven_succeeds
  cases h : search productionRows (69702 / 100000) 7 domain with
  | none => simp [h] at hs
  | some tree =>
    obtain ⟨r, hr, hb⟩ := search_envelope h (by norm_num [domain])
      (by simpa [domain] using ht) (by simpa [domain] using ht')
    exact ⟨r, hr, hb.trans (by norm_num)⟩

/-- A margin obtained from the generated stronger cover, on every real point. -/
theorem production_margin (t : ℝ) (ht : (2 / 5 : ℝ) ≤ t)
    (ht' : t ≤ (3 / 5 : ℝ)) :
    ∃ r ∈ productionRows, value r t ≤ (69702 / 100000 : ℝ) - 2 / 100000 := by
  have hs := depthEight_stronger
  cases h : search productionRows (697 / 1000) 8 domain with
  | none => simp [h] at hs
  | some tree =>
    obtain ⟨r, hr, hb⟩ := search_envelope h (by norm_num [domain])
      (by simpa [domain] using ht) (by simpa [domain] using ht')
    exact ⟨r, hr, hb.trans (by norm_num)⟩

/-- Every rational target strictly above the stronger certified envelope has
a positive semantic margin. The margin is a proof, not an algorithm input. -/
theorem production_strict_margin (B : ℚ) (hB : 697 / 1000 < B) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℝ, domain.mem t →
      ∃ r ∈ productionRows, value r t ≤ (B : ℝ) - δ := by
  refine ⟨(B : ℝ) - 697 / 1000, ?_, ?_⟩
  · apply sub_pos.mpr
    have hb : ((697 / 1000 : ℚ) : ℝ) < (B : ℝ) := by exact_mod_cast hB
    norm_num at hb
    exact hb
  · intro t ht
    obtain ⟨r, hr, hb⟩ := production_margin t
      (by simpa [Interval.mem, domain] using ht.1)
      (by simpa [Interval.mem, domain] using ht.2)
    exact ⟨r, hr, by linarith⟩

/-- A family of executable certified covers, whose depth and partition are
chosen by the algorithm. No subdivision bound is supplied by the caller. -/
def productionCoverAbove (B : ℚ) (hB : 697 / 1000 < B) :
    {tree : AdaptiveSearch.Tree //
      AdaptiveSearch.valid (test productionRows B) Interval.left Interval.right tree domain = true} :=
  construct productionRows B domain (by norm_num [domain]) (production_strict_margin B hB)

/-- The target cover exists as an unevaluated executable construction. -/
def productionCover := productionCoverAbove (69702 / 100000) (by norm_num)

/-- Every member of the constructed family has its semantic specification
without evaluating either the depth search or the resulting tree. -/
theorem productionCoverAbove_envelope (B : ℚ) (hB : 697 / 1000 < B)
    (t : ℝ) (ht : (2 / 5 : ℝ) ≤ t) (ht' : t ≤ (3 / 5 : ℝ)) :
    ∃ r ∈ productionRows, value r t ≤ (B : ℝ) := by
  exact AdaptiveSearch.valid_sound (test productionRows B) Interval.left Interval.right Interval.mem
    (fun x => ∃ r ∈ productionRows, value r x ≤ (B : ℝ))
    (test_sound productionRows B) split_cover (productionCoverAbove B hB).val domain
    (productionCoverAbove B hB).property t ⟨by simpa [domain] using ht, by simpa [domain] using ht'⟩

/-- The actual retained-square row hypotheses imply the generated interval bound. -/
theorem bound_of_production_rows {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {Qh v : E} {V t : ℝ}
    (ht : (2 / 5 : ℝ) ≤ t) (ht' : t ≤ (3 / 5 : ℝ))
    (hrows : ∀ r ∈ sourceRows,
      LowerAnalytic.RowHolds (ε : ℝ) r.ell r.beta (rowQuad r).2 V t Qh v) :
    V ≤ (69702 / 100000 : ℝ) := by
  obtain ⟨q, hq, hbound⟩ := productionCoverAbove_envelope (69702 / 100000) (by norm_num) t ht ht'
  obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hq
  have h := (hrows r hr).le (by norm_num [ε])
  exact h.trans (by simpa [value, rowQuad] using hbound)

end Grothe.Lower.EnvelopeSearch.Example
