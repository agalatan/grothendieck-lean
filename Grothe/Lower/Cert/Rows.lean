/-! # The rows hold: `RowFacts` of every row of `rowData` (generated by `tools/gen_lower_data.py`; do not edit) -/

namespace Grothe.Lower

/-- **Every row of `rowData` is certified** (the plain rows by `checkRow`, the spectral rows by `checkSpecRow`). -/
theorem rowData_facts : ∀ r ∈ rowData, RowFacts r := by
  intro r hr
  simp only [rowData, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact rowFacts_of_checkSpecRow _ certRow01
  · exact rowFacts_of_checkSpecRow _ certRow02
  · exact rowFacts_of_checkRow _ certRow03
  · exact rowFacts_of_checkRow _ certRow04
  · exact rowFacts_of_checkRow _ certRow05
  · exact rowFacts_of_checkRow _ certRow06
  · exact rowFacts_of_checkRow _ certRow07
  · exact rowFacts_of_checkRow _ certRow08
  · exact rowFacts_of_checkRow _ certRow09
  · exact rowFacts_of_checkRow _ certRow10
  · exact rowFacts_of_checkRow _ certRow11
  · exact rowFacts_of_checkRow _ certRow12
  · exact rowFacts_of_checkRow _ certRow13
  · exact rowFacts_of_checkRow _ certRow14

end Grothe.Lower
