/-- Affine majorant of `√t (9/2 − 17t)` on `[0, 1/6]`. -/
def La (x : ℝ) : ℝ := (535512819309491 / 500000000000000 : ℝ) + (-902846776023757 / 500000000000000 : ℝ) * x

/-- Affine majorant of `√(1/2 + 8t − 48t²)` on `[0, 1/6]`. -/
