/-- Certified: `highGap` on `[409/500, yHi] × [0, 1/2]` (16 leaves). -/
theorem highGap_nonneg (y w : ℝ) (ha0 : (409 / 500 : ℝ) ≤ y) (ha1 : y ≤ (243505383503 / 250000000000 : ℝ))
    (hb0 : (0 : ℝ) ≤ w) (hb1 : w ≤ (1 / 2 : ℝ)) : 0 ≤ highGap y w := by
