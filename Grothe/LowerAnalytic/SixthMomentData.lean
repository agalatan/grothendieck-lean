  exact coverOK_sound _ _ _ highGap_fits _ _ _ _ _ highGap_cover y w (by push_cast; linarith)
    (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith)


/-- Coefficient matrix of `lowGap`. -/
def lowGapM : List (List ℚ) :=
