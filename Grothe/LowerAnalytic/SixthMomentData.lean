def Lu (x : ℝ) : ℝ := (179120099690501 / 200000000000000 : ℝ) + (257742205086459 / 1000000000000000 : ℝ) * x

/-- Affine majorant of `√(1 + (21/100) x)` on `[0, 1]`. -/
def LN (x : ℝ) : ℝ := (200808991097619 / 200000000000000 : ℝ) + (23992765498441 / 250000000000000 : ℝ) * x

/-- `θ = −1/10`. -/
def thetaC : ℝ := -1 / 10
/-- `r₀ = 151/160`. -/
def r0C : ℝ := 151 / 160
/-- `λ = 739/2500`. -/
def lamC : ℝ := 739 / 2500
/-- `144 y² t_λ = (7 − λ)(3y² − 1) + (8 + 6λ) w`. -/
def tlam (y w : ℝ) : ℝ := (7 - lamC) * (3 * y ^ 2 - 1) + (8 + 6 * lamC) * w
/-- `y² La(t_λ)`. -/
def LaY (y w : ℝ) : ℝ := (535512819309491 / 500000000000000 : ℝ) * y ^ 2 + (-902846776023757 / 500000000000000 : ℝ) * tlam y w / 144
/-- `y² Lb(t_λ)`. -/
def LbY (y w : ℝ) : ℝ := (21269932165993 / 20000000000000 : ℝ) * y ^ 2 + (-1925139767123 / 1250000000000 : ℝ) * tlam y w / 144
/-- Combined coefficient of `tr S³` (divided by `y`). -/
def KaY (y u : ℝ) : ℝ := (135 / 2 + 45 * thetaC) * y ^ 2 + 165 * thetaC / (4 * r0C) * u * y
/-- Combined coefficient of `√(tr S⁴)` (divided by `y`). -/
def KbY (y u : ℝ) : ℝ := 45 * y + 165 / (4 * r0C) * u
/-- `y · Pbar(y, w, u)`: the high-range polynomial majorant of `y · P`. -/
def Qhat (y w u : ℝ) : ℝ :=
  KaY y u * LaY y w + KbY y u * LN (y ^ 2) * LbY y w + 135 / 2 * Lc w * y ^ 2 - 20 * u ^ 2 * y
    + 165 / 4 * r0C * u * y ^ 2
/-- `y · ∂Pbar/∂u` at `u = Lu(w)`. -/
def Dhat (y w : ℝ) : ℝ :=
  165 * thetaC / (4 * r0C) * y * LaY y w + 165 / (4 * r0C) * LN (y ^ 2) * LbY y w
    + 165 / 4 * r0C * y ^ 2 - 40 * y * Lu w
/-- The squared terminal gap of the high range. -/
def highGap (y w : ℝ) : ℝ := C6 ^ 2 * y ^ 2 * (1 + 3 / 2 * y ^ 2) ^ 3 - 27 / 50 * Qhat y w (Lu w) ^ 2
/-- Uniform bounds of the low range: `aa > √(27/34)`, `bb > √(5/6)`, `cc > √(10/11)`,
`dd > √bb`. -/
def aaC : ℝ := (22278319717 / 25000000000 : ℝ)
/-- See `aaC`. -/
def bbC : ℝ := (114108866147 / 125000000000 : ℝ)
/-- See `aaC`. -/
def ccC : ℝ := (476731294623 / 500000000000 : ℝ)
/-- See `aaC`. -/
def ddC : ℝ := (191088558441 / 200000000000 : ℝ)
/-- The low-range majorant of `P`. -/
def Plow (y u : ℝ) : ℝ :=
  135 / 2 * aaC * y ^ 3 + 45 * bbC * y ^ 2 + 135 / 2 * ccC * y - 20 * u ^ 2 + 165 / 2 * ddC * y * u
/-- The squared terminal gap of the low range. -/
def lowGap (y u : ℝ) : ℝ := C6 ^ 2 * (1 + 3 / 2 * y ^ 2) ^ 3 - 27 / 50 * Plow y u ^ 2

end


