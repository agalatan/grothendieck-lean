namespace Grothe.LowerAnalytic

theorem capBridge09 :
    Grothe.Lower.row10.ell = capRow09.ell ∧
      Grothe.Lower.row10.beta = capRow09.beta ∧
      Grothe.Lower.row10.delta = capRow09.delta ∧
      Grothe.Lower.row10.kappa = capRow09.kappa ∧
      Grothe.Lower.row10.smax = capRow09.smax ∧
      Grothe.Lower.row10.E = capRow09.E ∧
      Grothe.Lower.row10.b1 = capRow09.b1 ∧
      Grothe.Lower.row10.b2 = capRow09.b2 ∧
      Grothe.Lower.row10.b3 = capRow09.b3 ∧
      Grothe.Lower.row10.nodes = capRow09.nodes :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

end Grothe.LowerAnalytic
