structure Extra where
  lo : ℚ
  hi : ℚ
  sigma : ℚ
  val : ℚ
  deriving DecidableEq, Repr

/-- Store the two numerical coordinates of a transported knot. -/
def Extra.node (k : Extra) : RowSigmaNode := .quad 0 k.sigma k.val

/-- Freeze an original knot at the endpoints of its own certified shape cell. -/
def freeze (c0 : ℚ) (c : AntiSCell) (p : RowSigmaNode) : RowSigmaNode :=
  match p with
  | .zero => .zero
  | p => .quad 0 p.sigma (p.val c0 c.sLo c.sHi)

structure Pick where
  cell : ℕ
  extra : Option ℕ
  knotIndices : List ℕ
  deriving DecidableEq, Repr

def oldCell (cells : List AntiSCell) (p : Pick) := cells.getD p.cell ⟨0,0,[]⟩

def select (l h c0 : ℚ) (cells : List AntiSCell) (ex : List Extra) (p : Pick) : AntiSCell :=
  let c := oldCell cells p
  let extra := (p.extra.bind fun i => ex[i]?).toList.map Extra.node
  let pool := c.snodes.map (freeze c0 c) ++ extra
  ⟨l, h, p.knotIndices.filterMap fun i => pool[i]?⟩

