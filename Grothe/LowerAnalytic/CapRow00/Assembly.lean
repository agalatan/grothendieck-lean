/-!
# The node caps of row 0 (`t = 0.4`) (generated by `tools/gen_tail_caps.py`; do not edit)

The vertex caps from the whole-fibre range facts and the caps of the localised nodes, the chord nodes by convexity
(`nodeCaps_of_vertexCapsNu`).
-/

open GrotheKernel Grothe.Lower

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

theorem exclCapsRow00 : ExclCapsNu capNu capRow00 capR00 capExcl00 := by
  intro i hmem _hi
  simp only [capExcl00, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact nodeCap_00x0
  · exact nodeCap_00x3
  · exact nodeCap_00x6
  · exact nodeCap_00x12
  · exact nodeCap_00x15
  · exact nodeCap_00x18
  · exact nodeCap_00x23
  · exact nodeCap_00x25
  · exact nodeCap_00x27
  · exact nodeCap_00x29
  · exact nodeCap_00x37
  · exact nodeCap_00x41
  · exact nodeCap_00x45
  · exact nodeCap_00x47
  · exact nodeCap_00x49
  · exact nodeCap_00x51
  · exact nodeCap_00x53
  · exact nodeCap_00x55
  · exact nodeCap_00x66

theorem vertexCapsRow00 : VertexCapsRowNu capNu capRow00 capR00 capChords00 := by
  intro i hi hc
  rcases (show i < 73 ∨ (73 ≤ i ∧ i < 80) ∨ (80 ≤ i ∧ i < 87) ∨ (87 ≤ i ∧ i < 94) ∨ (94 ≤ i ∧ i < 101) ∨ (101 ≤ i ∧ i < 108) ∨ (108 ≤ i ∧ i < 115) ∨ 115 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row00AnchorRange00
      exclCapsRow00 (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row00AnchorRange01
      exclCapsRow00 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row00AnchorRange02
      exclCapsRow00 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row00AnchorRange03
      exclCapsRow00 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row00AnchorRange04
      exclCapsRow00 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row00AnchorRange05
      exclCapsRow00 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row00AnchorRange06
      exclCapsRow00 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row00AnchorRange07
      exclCapsRow00 h1 hi hi hc

theorem chordsOKRow00 : chordOKLow capRow00.nodeList capChords00 = true := by native_decide

theorem psdRow00 : capRow00.E.psdOK = true ∧ capR00.psdOK = true := by decide +kernel

/-- **The node caps of row 0** (`t = 0.4`) with the tail `ν̂`. -/
theorem capsRow00 :
    ∀ m ∈ capRow00.nodeList, pot capRow00.E capR00 capRow00.ell capRow00.beta
      (aFib capRow00.b1 capRow00.b2 capRow00.b3) capNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu psdRow00.1 psdRow00.2 chordsOKRow00 vertexCapsRow00

end Grothe.LowerAnalytic
