import Grothe.LowerAnalytic.CapRow00.Data
import Grothe.Lower.RowData01

/-! # Row 0 (`t = 0.4`): the row of the caps is the row of the Stein side (generated by `tools/gen_tail_caps.py`; do not edit)

The cap data `capRow00` and the Stein row `row01` (`gen_lower_data.py`) are written from the same constants and the
same cap table; their common fields agree by `rfl`, and `R` is the gate of the row (`rowGates`). -/

namespace Grothe.LowerAnalytic

theorem capBridge00 :
    Grothe.Lower.row01.ell = capRow00.ell ∧
      Grothe.Lower.row01.beta = capRow00.beta ∧
      Grothe.Lower.row01.delta = capRow00.delta ∧
      Grothe.Lower.row01.kappa = capRow00.kappa ∧
      Grothe.Lower.row01.smax = capRow00.smax ∧
      Grothe.Lower.row01.E = capRow00.E ∧
      Grothe.Lower.row01.b1 = capRow00.b1 ∧
      Grothe.Lower.row01.b2 = capRow00.b2 ∧
      Grothe.Lower.row01.b3 = capRow00.b3 ∧
      Grothe.Lower.row01.nodes = capRow00.nodes :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

end Grothe.LowerAnalytic
