/-- **The node caps of row 7** (`t = 0.835`) with the tail `ν̂`, at the weight `ε̂` of the certificate. -/
theorem tailCaps07 (heps : tailEps = Grothe.Lower.ε) :
    ∀ m ∈ tailRow07.nodeList, pot tailRow07.E tailR07 tailRow07.ell tailRow07.beta
      (aFib tailRow07.b1 tailRow07.b2 tailRow07.b3) tailNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu tailPsd07.1 tailPsd07.2 tailChordsOK07 (tailVertexCaps07 heps)

