/-!
# The node caps of row 4 (`t = 0.8`) of the identity-tail certificate (generated by `tools/gen_tail_caps.py`; do not edit)

The vertex caps from the whole-fibre range facts and the caps of the localised nodes, the chord nodes by convexity
(`nodeCaps_of_vertexCapsNu`). Every statement takes `tailEps = ε`: the facts are checked at the weight `ε̂ = 25/31` of the
certificate, which is the rows' weight `ε` once the rows of the repository are those of the certificate.
-/

open GrotheKernel Grothe.Lower

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

theorem tailExclCaps04 (heps : tailEps = Grothe.Lower.ε) :
    ExclCapsNu tailNu tailRow04 tailR04 tailExcl04 := by
  intro i hmem _hi
  simp only [tailExcl04, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
