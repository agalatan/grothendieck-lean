theorem tailVertexCaps04 (heps : tailEps = Grothe.Lower.ε) :
    VertexCapsRowNu tailNu tailRow04 tailR04 tailChords04 := by
  intro i hi hc
  rcases (show i < 7 ∨ (7 ≤ i ∧ i < 57) ∨ (57 ≤ i ∧ i < 78) ∨ (78 ≤ i ∧ i < 89) ∨ (89 ≤ i ∧ i < 98) ∨ (98 ≤ i ∧ i < 105) ∨ (105 ≤ i ∧ i < 112) ∨ (112 ≤ i ∧ i < 119) ∨ (119 ≤ i ∧ i < 126) ∨ (126 ≤ i ∧ i < 133) ∨ 133 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor04_00
      (tailExclCaps04 heps) (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor04_01
      (tailExclCaps04 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor04_02
      (tailExclCaps04 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor04_03
      (tailExclCaps04 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor04_04
      (tailExclCaps04 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor04_05
      (tailExclCaps04 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor04_06
      (tailExclCaps04 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor04_07
      (tailExclCaps04 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor04_08
      (tailExclCaps04 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor04_09
      (tailExclCaps04 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor04_10
      (tailExclCaps04 heps) h1 hi hi hc

theorem tailChordsOK04 : chordOKLow tailRow04.nodeList tailChords04 = true := by native_decide

theorem tailPsd04 : tailRow04.E.psdOK = true ∧ tailR04.psdOK = true := by decide +kernel

/-- **The node caps of row 4** (`t = 0.8`) with the tail `ν̂`, at the weight `ε̂` of the certificate. -/
theorem tailCaps04 (heps : tailEps = Grothe.Lower.ε) :
    ∀ m ∈ tailRow04.nodeList, pot tailRow04.E tailR04 tailRow04.ell tailRow04.beta
      (aFib tailRow04.b1 tailRow04.b2 tailRow04.b3) tailNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu tailPsd04.1 tailPsd04.2 tailChordsOK04 (tailVertexCaps04 heps)

end Grothe.LowerAnalytic
