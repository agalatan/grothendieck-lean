/-!
# The node caps of row 2 (`t = 0.7`) of the identity-tail certificate (generated by `tools/gen_tail_caps.py`; do not edit)

The vertex caps from the whole-fibre range facts and the caps of the localised nodes, the chord nodes by convexity
(`nodeCaps_of_vertexCapsNu`). Every statement takes `tailEps = ε`: the facts are checked at the weight `ε̂ = 25/31` of the
certificate, which is the rows' weight `ε` once the rows of the repository are those of the certificate.
-/

open GrotheKernel Grothe.Lower

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

theorem tailExclCaps02 (heps : tailEps = Grothe.Lower.ε) :
    ExclCapsNu tailNu tailRow02 tailR02 tailExcl02 := by
  intro i hmem _hi
  simp only [tailExcl02, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact tailNodeCap02_000 heps
  · exact tailNodeCap02_001 heps
  · exact tailNodeCap02_003 heps
  · exact tailNodeCap02_006 heps
  · exact tailNodeCap02_009 heps
  · exact tailNodeCap02_012 heps
  · exact tailNodeCap02_015 heps
  · exact tailNodeCap02_023 heps
  · exact tailNodeCap02_027 heps
  · exact tailNodeCap02_028 heps
  · exact tailNodeCap02_029 heps
  · exact tailNodeCap02_031 heps
  · exact tailNodeCap02_032 heps
  · exact tailNodeCap02_033 heps
  · exact tailNodeCap02_034 heps
  · exact tailNodeCap02_035 heps
  · exact tailNodeCap02_037 heps
  · exact tailNodeCap02_039 heps
  · exact tailNodeCap02_041 heps
  · exact tailNodeCap02_043 heps
  · exact tailNodeCap02_045 heps
  · exact tailNodeCap02_047 heps
  · exact tailNodeCap02_048 heps
  · exact tailNodeCap02_049 heps
  · exact tailNodeCap02_065 heps

theorem tailVertexCaps02 (heps : tailEps = Grothe.Lower.ε) :
    VertexCapsRowNu tailNu tailRow02 tailR02 tailChords02 := by
  intro i hi hc
  rcases (show i < 68 ∨ (68 ≤ i ∧ i < 75) ∨ (75 ≤ i ∧ i < 82) ∨ (82 ≤ i ∧ i < 89) ∨ (89 ≤ i ∧ i < 96) ∨ (96 ≤ i ∧ i < 103) ∨ 103 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor02_00
      (tailExclCaps02 heps) (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor02_01
      (tailExclCaps02 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor02_02
      (tailExclCaps02 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor02_03
      (tailExclCaps02 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor02_04
      (tailExclCaps02 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor02_05
      (tailExclCaps02 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor02_06
      (tailExclCaps02 heps) h1 hi hi hc

theorem tailChordsOK02 : chordOKLow tailRow02.nodeList tailChords02 = true := by native_decide

theorem tailPsd02 : tailRow02.E.psdOK = true ∧ tailR02.psdOK = true := by decide +kernel

/-- **The node caps of row 2** (`t = 0.7`) with the tail `ν̂`, at the weight `ε̂` of the certificate. -/
theorem tailCaps02 (heps : tailEps = Grothe.Lower.ε) :
    ∀ m ∈ tailRow02.nodeList, pot tailRow02.E tailR02 tailRow02.ell tailRow02.beta
      (aFib tailRow02.b1 tailRow02.b2 tailRow02.b3) tailNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu tailPsd02.1 tailPsd02.2 tailChordsOK02 (tailVertexCaps02 heps)

end Grothe.LowerAnalytic
