/-- **The node caps of row 11** (`t = 0.87`) with the tail `ν̂`, at the weight `ε̂` of the certificate. -/
theorem tailCaps11 (heps : tailEps = Grothe.Lower.ε) :
    ∀ m ∈ tailRow11.nodeList, pot tailRow11.E tailR11 tailRow11.ell tailRow11.beta
      (aFib tailRow11.b1 tailRow11.b2 tailRow11.b3) tailNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu tailPsd11.1 tailPsd11.2 tailChordsOK11 (tailVertexCaps11 heps)

