/-!
# The node caps of row 13 (`t = 0.8875`) of the identity-tail certificate (generated by `tools/gen_tail_caps.py`; do not edit)

The vertex caps from the whole-fibre range facts and the caps of the localised nodes, the chord nodes by convexity
(`nodeCaps_of_vertexCapsNu`). Every statement takes `tailEps = ε`: the facts are checked at the weight `ε̂ = 25/31` of the
certificate, which is the rows' weight `ε` once the rows of the repository are those of the certificate.
-/

open GrotheKernel Grothe.Lower

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

theorem tailExclCaps13 (_heps : tailEps = Grothe.Lower.ε) :
    ExclCapsNu tailNu tailRow13 tailR13 tailExcl13 := by
  intro i hmem
  simp [tailExcl13] at hmem

theorem tailVertexCaps13 (heps : tailEps = Grothe.Lower.ε) :
    VertexCapsRowNu tailNu tailRow13 tailR13 tailChords13 := by
  intro i hi hc
  rcases (show i < 7 ∨ (7 ≤ i ∧ i < 14) ∨ (14 ≤ i ∧ i < 21) ∨ (21 ≤ i ∧ i < 28) ∨ (28 ≤ i ∧ i < 35) ∨ (35 ≤ i ∧ i < 42) ∨ (42 ≤ i ∧ i < 49) ∨ (49 ≤ i ∧ i < 56) ∨ (56 ≤ i ∧ i < 63) ∨ (63 ≤ i ∧ i < 70) ∨ (70 ≤ i ∧ i < 77) ∨ (77 ≤ i ∧ i < 85) ∨ (85 ≤ i ∧ i < 92) ∨ 92 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_00
      (tailExclCaps13 heps) (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_01
      (tailExclCaps13 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_02
      (tailExclCaps13 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_03
      (tailExclCaps13 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_04
      (tailExclCaps13 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_05
      (tailExclCaps13 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_06
      (tailExclCaps13 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_07
      (tailExclCaps13 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_08
      (tailExclCaps13 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_09
      (tailExclCaps13 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_10
      (tailExclCaps13 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_11
      (tailExclCaps13 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_12
      (tailExclCaps13 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor13_13
      (tailExclCaps13 heps) h1 hi hi hc

theorem tailChordsOK13 : chordOKLow tailRow13.nodeList tailChords13 = true := by native_decide

theorem tailPsd13 : tailRow13.E.psdOK = true ∧ tailR13.psdOK = true := by decide +kernel

/-- **The node caps of row 13** (`t = 0.8875`) with the tail `ν̂`, at the weight `ε̂` of the certificate. -/
theorem tailCaps13 (heps : tailEps = Grothe.Lower.ε) :
    ∀ m ∈ tailRow13.nodeList, pot tailRow13.E tailR13 tailRow13.ell tailRow13.beta
      (aFib tailRow13.b1 tailRow13.b2 tailRow13.b3) tailNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu tailPsd13.1 tailPsd13.2 tailChordsOK13 (tailVertexCaps13 heps)

end Grothe.LowerAnalytic
