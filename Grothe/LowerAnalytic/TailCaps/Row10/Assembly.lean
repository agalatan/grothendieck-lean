theorem tailChordsOK10 : chordOKLow tailRow10.nodeList tailChords10 = true := by native_decide

theorem tailPsd10 : tailRow10.E.psdOK = true ∧ tailR10.psdOK = true := by decide +kernel

/-- **The node caps of row 10** (`t = 0.86`) with the tail `ν̂`, at the weight `ε̂` of the certificate. -/
theorem tailCaps10 (heps : tailEps = Grothe.Lower.ε) :
    ∀ m ∈ tailRow10.nodeList, pot tailRow10.E tailR10 tailRow10.ell tailRow10.beta
      (aFib tailRow10.b1 tailRow10.b2 tailRow10.b3) tailNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu tailPsd10.1 tailPsd10.2 tailChordsOK10 (tailVertexCaps10 heps)

