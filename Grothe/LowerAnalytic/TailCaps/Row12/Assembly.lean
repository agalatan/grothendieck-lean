theorem tailChordsOK12 : chordOKLow tailRow12.nodeList tailChords12 = true := by native_decide

theorem tailPsd12 : tailRow12.E.psdOK = true ∧ tailR12.psdOK = true := by decide +kernel

/-- **The node caps of row 12** (`t = 0.885`) with the tail `ν̂`, at the weight `ε̂` of the certificate. -/
theorem tailCaps12 (heps : tailEps = Grothe.Lower.ε) :
    ∀ m ∈ tailRow12.nodeList, pot tailRow12.E tailR12 tailRow12.ell tailRow12.beta
      (aFib tailRow12.b1 tailRow12.b2 tailRow12.b3) tailNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu tailPsd12.1 tailPsd12.2 tailChordsOK12 (tailVertexCaps12 heps)

