/-!
# The node caps of row 1 (`t = 0.6`) of the identity-tail certificate (generated by `tools/gen_tail_caps.py`; do not edit)

The vertex caps from the whole-fibre range facts and the caps of the localised nodes, the chord nodes by convexity
(`nodeCaps_of_vertexCapsNu`). Every statement takes `tailEps = ε`: the facts are checked at the weight `ε̂ = 25/31` of the
certificate, which is the rows' weight `ε` once the rows of the repository are those of the certificate.
-/

open GrotheKernel Grothe.Lower

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

theorem tailExclCaps01 (heps : tailEps = Grothe.Lower.ε) :
    ExclCapsNu tailNu tailRow01 tailR01 tailExcl01 := by
  intro i hmem _hi
  simp only [tailExcl01, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact tailNodeCap01_000 heps
  · exact tailNodeCap01_001 heps
  · exact tailNodeCap01_003 heps
  · exact tailNodeCap01_006 heps
  · exact tailNodeCap01_008 heps
  · exact tailNodeCap01_009 heps
  · exact tailNodeCap01_024 heps
  · exact tailNodeCap01_025 heps
  · exact tailNodeCap01_027 heps
  · exact tailNodeCap01_033 heps
  · exact tailNodeCap01_035 heps
  · exact tailNodeCap01_039 heps
  · exact tailNodeCap01_040 heps
  · exact tailNodeCap01_041 heps
  · exact tailNodeCap01_044 heps
  · exact tailNodeCap01_045 heps
  · exact tailNodeCap01_051 heps
  · exact tailNodeCap01_065 heps

theorem tailVertexCaps01 (heps : tailEps = Grothe.Lower.ε) :
    VertexCapsRowNu tailNu tailRow01 tailR01 tailChords01 := by
  intro i hi hc
  rcases (show i < 68 ∨ (68 ≤ i ∧ i < 75) ∨ (75 ≤ i ∧ i < 82) ∨ (82 ≤ i ∧ i < 89) ∨ (89 ≤ i ∧ i < 96) ∨ (96 ≤ i ∧ i < 103) ∨ (103 ≤ i ∧ i < 110) ∨ (110 ≤ i ∧ i < 117) ∨ 117 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor01_00
      (tailExclCaps01 heps) (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor01_01
      (tailExclCaps01 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor01_02
      (tailExclCaps01 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor01_03
      (tailExclCaps01 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor01_04
      (tailExclCaps01 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor01_05
      (tailExclCaps01 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor01_06
      (tailExclCaps01 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor01_07
      (tailExclCaps01 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor01_08
      (tailExclCaps01 heps) h1 hi hi hc

theorem tailChordsOK01 : chordOKLow tailRow01.nodeList tailChords01 = true := by native_decide

theorem tailPsd01 : tailRow01.E.psdOK = true ∧ tailR01.psdOK = true := by decide +kernel

/-- **The node caps of row 1** (`t = 0.6`) with the tail `ν̂`, at the weight `ε̂` of the certificate. -/
theorem tailCaps01 (heps : tailEps = Grothe.Lower.ε) :
    ∀ m ∈ tailRow01.nodeList, pot tailRow01.E tailR01 tailRow01.ell tailRow01.beta
      (aFib tailRow01.b1 tailRow01.b2 tailRow01.b3) tailNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu tailPsd01.1 tailPsd01.2 tailChordsOK01 (tailVertexCaps01 heps)

end Grothe.LowerAnalytic
