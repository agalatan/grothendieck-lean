theorem tailVertexCaps05 (heps : tailEps = Grothe.Lower.ε) :
    VertexCapsRowNu tailNu tailRow05 tailR05 tailChords05 := by
  intro i hi hc
  rcases (show i < 7 ∨ (7 ≤ i ∧ i < 14) ∨ (14 ≤ i ∧ i < 60) ∨ (60 ≤ i ∧ i < 87) ∨ (87 ≤ i ∧ i < 94) ∨ (94 ≤ i ∧ i < 101) ∨ (101 ≤ i ∧ i < 108) ∨ (108 ≤ i ∧ i < 115) ∨ (115 ≤ i ∧ i < 122) ∨ (122 ≤ i ∧ i < 129) ∨ (129 ≤ i ∧ i < 136) ∨ 136 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor05_00
      (tailExclCaps05 heps) (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor05_01
      (tailExclCaps05 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor05_02
      (tailExclCaps05 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor05_03
      (tailExclCaps05 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor05_04
      (tailExclCaps05 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor05_05
      (tailExclCaps05 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor05_06
      (tailExclCaps05 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor05_07
      (tailExclCaps05 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor05_08
      (tailExclCaps05 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor05_09
      (tailExclCaps05 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor05_10
      (tailExclCaps05 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor05_11
      (tailExclCaps05 heps) h1 hi hi hc

theorem tailChordsOK05 : chordOKLow tailRow05.nodeList tailChords05 = true := by native_decide

theorem tailPsd05 : tailRow05.E.psdOK = true ∧ tailR05.psdOK = true := by decide +kernel

/-- **The node caps of row 5** (`t = 0.82`) with the tail `ν̂`, at the weight `ε̂` of the certificate. -/
theorem tailCaps05 (heps : tailEps = Grothe.Lower.ε) :
    ∀ m ∈ tailRow05.nodeList, pot tailRow05.E tailR05 tailRow05.ell tailRow05.beta
      (aFib tailRow05.b1 tailRow05.b2 tailRow05.b3) tailNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu tailPsd05.1 tailPsd05.2 tailChordsOK05 (tailVertexCaps05 heps)

