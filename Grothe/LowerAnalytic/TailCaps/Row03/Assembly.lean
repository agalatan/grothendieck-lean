theorem tailVertexCaps03 (heps : tailEps = Grothe.Lower.ε) :
    VertexCapsRowNu tailNu tailRow03 tailR03 tailChords03 := by
  intro i hi hc
  rcases (show i < 7 ∨ (7 ≤ i ∧ i < 46) ∨ (46 ≤ i ∧ i < 58) ∨ (58 ≤ i ∧ i < 65) ∨ (65 ≤ i ∧ i < 72) ∨ (72 ≤ i ∧ i < 79) ∨ (79 ≤ i ∧ i < 86) ∨ (86 ≤ i ∧ i < 93) ∨ 93 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor03_00
      (tailExclCaps03 heps) (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor03_01
      (tailExclCaps03 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor03_02
      (tailExclCaps03 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor03_03
      (tailExclCaps03 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor03_04
      (tailExclCaps03 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor03_05
      (tailExclCaps03 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor03_06
      (tailExclCaps03 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor03_07
      (tailExclCaps03 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor03_08
      (tailExclCaps03 heps) h1 hi hi hc

theorem tailChordsOK03 : chordOKLow tailRow03.nodeList tailChords03 = true := by native_decide

theorem tailPsd03 : tailRow03.E.psdOK = true ∧ tailR03.psdOK = true := by decide +kernel

/-- **The node caps of row 3** (`t = 0.78`) with the tail `ν̂`, at the weight `ε̂` of the certificate. -/
theorem tailCaps03 (heps : tailEps = Grothe.Lower.ε) :
    ∀ m ∈ tailRow03.nodeList, pot tailRow03.E tailR03 tailRow03.ell tailRow03.beta
      (aFib tailRow03.b1 tailRow03.b2 tailRow03.b3) tailNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu tailPsd03.1 tailPsd03.2 tailChordsOK03 (tailVertexCaps03 heps)

