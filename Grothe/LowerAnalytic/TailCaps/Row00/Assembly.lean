/-!
# The node caps of row 0 (`t = 0.4`) of the identity-tail certificate (generated by `tools/gen_tail_caps.py`; do not edit)

The vertex caps from the whole-fibre range facts and the caps of the localised nodes, the chord nodes by convexity
(`nodeCaps_of_vertexCapsNu`). Every statement takes `tailEps = ε`: the facts are checked at the weight `ε̂ = 25/31` of the
certificate, which is the rows' weight `ε` once the rows of the repository are those of the certificate.
-/

open GrotheKernel Grothe.Lower

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

theorem tailExclCaps00 (heps : tailEps = Grothe.Lower.ε) :
    ExclCapsNu tailNu tailRow00 tailR00 tailExcl00 := by
  intro i hmem _hi
  simp only [tailExcl00, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact tailNodeCap00_000 heps
  · exact tailNodeCap00_003 heps
  · exact tailNodeCap00_006 heps
  · exact tailNodeCap00_012 heps
  · exact tailNodeCap00_015 heps
  · exact tailNodeCap00_018 heps
  · exact tailNodeCap00_023 heps
  · exact tailNodeCap00_025 heps
  · exact tailNodeCap00_027 heps
  · exact tailNodeCap00_029 heps
  · exact tailNodeCap00_037 heps
  · exact tailNodeCap00_041 heps
  · exact tailNodeCap00_045 heps
  · exact tailNodeCap00_047 heps
  · exact tailNodeCap00_049 heps
  · exact tailNodeCap00_051 heps
  · exact tailNodeCap00_053 heps
  · exact tailNodeCap00_055 heps
  · exact tailNodeCap00_066 heps

theorem tailVertexCaps00 (heps : tailEps = Grothe.Lower.ε) :
    VertexCapsRowNu tailNu tailRow00 tailR00 tailChords00 := by
  intro i hi hc
  rcases (show i < 73 ∨ (73 ≤ i ∧ i < 80) ∨ (80 ≤ i ∧ i < 87) ∨ (87 ≤ i ∧ i < 94) ∨ (94 ≤ i ∧ i < 101) ∨ (101 ≤ i ∧ i < 108) ∨ (108 ≤ i ∧ i < 115) ∨ 115 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor00_00
      (tailExclCaps00 heps) (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor00_01
      (tailExclCaps00 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor00_02
      (tailExclCaps00 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor00_03
      (tailExclCaps00 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor00_04
      (tailExclCaps00 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor00_05
      (tailExclCaps00 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor00_06
      (tailExclCaps00 heps) h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK heps tailNu_nonneg tailNu_lt_one tailAnchor00_07
      (tailExclCaps00 heps) h1 hi hi hc

theorem tailChordsOK00 : chordOKLow tailRow00.nodeList tailChords00 = true := by native_decide

theorem tailPsd00 : tailRow00.E.psdOK = true ∧ tailR00.psdOK = true := by decide +kernel

/-- **The node caps of row 0** (`t = 0.4`) with the tail `ν̂`, at the weight `ε̂` of the certificate. -/
theorem tailCaps00 (heps : tailEps = Grothe.Lower.ε) :
    ∀ m ∈ tailRow00.nodeList, pot tailRow00.E tailR00 tailRow00.ell tailRow00.beta
      (aFib tailRow00.b1 tailRow00.b2 tailRow00.b3) tailNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu tailPsd00.1 tailPsd00.2 tailChordsOK00 (tailVertexCaps00 heps)

end Grothe.LowerAnalytic
