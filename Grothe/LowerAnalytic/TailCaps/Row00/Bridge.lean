import Grothe.LowerAnalytic.TailCaps.Row00.Data
import Grothe.Lower.TailRows.Row00

/-! # Row 0 (`t = 0.4`): the row of the caps is the row of the Stein side (generated by `tools/gen_tail_caps.py`; do not edit)

The cap data `tailRow00` and the Stein row `tailSteinRow00` (`gen_lower_data.py --tail`) are written from the same constants
and the same cap table; their common fields agree by `rfl`. -/

namespace Grothe.LowerAnalytic

theorem tailBridge00 :
    Grothe.Lower.tailSteinRow00.ell = tailRow00.ell ∧
      Grothe.Lower.tailSteinRow00.beta = tailRow00.beta ∧
      Grothe.Lower.tailSteinRow00.delta = tailRow00.delta ∧
      Grothe.Lower.tailSteinRow00.kappa = tailRow00.kappa ∧
      Grothe.Lower.tailSteinRow00.smax = tailRow00.smax ∧
      Grothe.Lower.tailSteinRow00.E = tailRow00.E ∧
      Grothe.Lower.tailSteinRow00.b1 = tailRow00.b1 ∧
      Grothe.Lower.tailSteinRow00.b2 = tailRow00.b2 ∧
      Grothe.Lower.tailSteinRow00.b3 = tailRow00.b3 ∧
      Grothe.Lower.tailSteinRow00.nodes = tailRow00.nodes :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

end Grothe.LowerAnalytic
