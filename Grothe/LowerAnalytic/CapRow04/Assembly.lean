theorem vertexCapsRow04 : VertexCapsRowNu capNu capRow04 capR04 capChords04 := by
  intro i hi hc
  rcases (show i < 7 ∨ (7 ≤ i ∧ i < 57) ∨ (57 ≤ i ∧ i < 78) ∨ (78 ≤ i ∧ i < 89) ∨ (89 ≤ i ∧ i < 98) ∨ (98 ≤ i ∧ i < 105) ∨ (105 ≤ i ∧ i < 112) ∨ (112 ≤ i ∧ i < 119) ∨ (119 ≤ i ∧ i < 126) ∨ (126 ≤ i ∧ i < 133) ∨ 133 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row04AnchorRange00
      exclCapsRow04 (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row04AnchorRange01
      exclCapsRow04 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row04AnchorRange02
      exclCapsRow04 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row04AnchorRange03
      exclCapsRow04 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row04AnchorRange04
      exclCapsRow04 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row04AnchorRange05
      exclCapsRow04 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row04AnchorRange06
      exclCapsRow04 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row04AnchorRange07
      exclCapsRow04 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row04AnchorRange08
      exclCapsRow04 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row04AnchorRange09
      exclCapsRow04 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row04AnchorRange10
      exclCapsRow04 h1 hi hi hc

theorem chordsOKRow04 : chordOKLow capRow04.nodeList capChords04 = true := by native_decide

theorem psdRow04 : capRow04.E.psdOK = true ∧ capR04.psdOK = true := by decide +kernel

/-- **The node caps of row 4** (`t = 0.8`) with the tail `ν̂`. -/
theorem capsRow04 :
    ∀ m ∈ capRow04.nodeList, pot capRow04.E capR04 capRow04.ell capRow04.beta
      (aFib capRow04.b1 capRow04.b2 capRow04.b3) capNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu psdRow04.1 psdRow04.2 chordsOKRow04 vertexCapsRow04

