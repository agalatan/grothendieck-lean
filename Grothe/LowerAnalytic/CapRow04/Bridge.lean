import Grothe.LowerAnalytic.CapRow04.Data
import Grothe.Lower.RowData05

/-! # Row 4 (`t = 0.8`): the row of the caps is the row of the Stein side (generated by `tools/gen_tail_caps.py`; do not edit)

The cap data `capRow04` and the Stein row `row05` (`gen_lower_data.py`) are written from the same constants and the
same cap table; their common fields agree by `rfl`, and `R` is the gate of the row (`rowGates`). -/

namespace Grothe.LowerAnalytic

theorem capBridge04 :
    Grothe.Lower.row05.ell = capRow04.ell ∧
      Grothe.Lower.row05.beta = capRow04.beta ∧
      Grothe.Lower.row05.delta = capRow04.delta ∧
      Grothe.Lower.row05.kappa = capRow04.kappa ∧
      Grothe.Lower.row05.smax = capRow04.smax ∧
      Grothe.Lower.row05.E = capRow04.E ∧
      Grothe.Lower.row05.b1 = capRow04.b1 ∧
      Grothe.Lower.row05.b2 = capRow04.b2 ∧
      Grothe.Lower.row05.b3 = capRow04.b3 ∧
      Grothe.Lower.row05.nodes = capRow04.nodes :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

end Grothe.LowerAnalytic
