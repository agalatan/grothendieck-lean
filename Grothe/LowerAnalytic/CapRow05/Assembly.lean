theorem vertexCapsRow05 : VertexCapsRowNu capNu capRow05 capR05 capChords05 := by
  intro i hi hc
  rcases (show i < 7 ∨ (7 ≤ i ∧ i < 14) ∨ (14 ≤ i ∧ i < 60) ∨ (60 ≤ i ∧ i < 87) ∨ (87 ≤ i ∧ i < 94) ∨ (94 ≤ i ∧ i < 101) ∨ (101 ≤ i ∧ i < 108) ∨ (108 ≤ i ∧ i < 115) ∨ (115 ≤ i ∧ i < 122) ∨ (122 ≤ i ∧ i < 129) ∨ (129 ≤ i ∧ i < 136) ∨ 136 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row05AnchorRange00
      exclCapsRow05 (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row05AnchorRange01
