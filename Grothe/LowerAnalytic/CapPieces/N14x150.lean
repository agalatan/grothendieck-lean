import Grothe.LowerAnalytic.CapPieceNodes
import Grothe.LowerAnalytic.CapPieces.C14x150
import Grothe.LowerAnalytic.CapPieces.R14x150_0
import Grothe.LowerAnalytic.CapPieces.R14x150_1

/-! # The cap of node 150 of row 14 from its pieces (generated by `tools/gen_cap_pieces.py nodes`; do not edit)

Checked pieces: 8 of 9 in 2 range facts; excluded: [0].
-/

namespace Grothe.LowerAnalytic

/-- **The cap of node 150 of row 14**, given the bounds of the excluded pieces [0]. -/
theorem nodeCap_14x150
    (hex : ∀ j ∈ ([0] : List ℕ), ∀ cs, (pieceCons pieceNode_14x150)[j]? = some cs → PieceCap 14 150 cs) :
    NodeCap 14 150 := by
  refine nodeCap_of_ranges pieceNode_14x150 [0] pieceCover_14x150 (fun j hj hx => ?_) hex
  have hn : (pieceNode_14x150).2.2.2.length = 9 := rfl
  rw [hn] at hj
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hx
  obtain h | h := (by omega : (1 ≤ j ∧ j < 5) ∨ (5 ≤ j ∧ j < 9))
  exacts [pieceOneOK_of_range pieceRange_14x150_0 h.1 h.2, pieceOneOK_of_range pieceRange_14x150_1 h.1 h.2]

end Grothe.LowerAnalytic
