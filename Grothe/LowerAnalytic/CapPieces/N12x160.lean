/-! # The cap of node 160 of row 12 from its pieces (generated by `tools/gen_cap_pieces.py nodes`; do not edit)

Checked pieces: 9 of 9 in 3 range facts; excluded: [].
-/

namespace Grothe.LowerAnalytic

/-- **The cap of node 160 of row 12**, given the bounds of the excluded pieces []. -/
theorem nodeCap_12x160
    (hex : ∀ j ∈ ([] : List ℕ), ∀ cs, (pieceCons pieceNode_12x160)[j]? = some cs → PieceCap 12 160 cs) :
    NodeCap 12 160 := by
  refine nodeCap_of_ranges pieceNode_12x160 [] pieceCover_12x160 (fun j hj hx => ?_) hex
  have hn : (pieceNode_12x160).2.2.2.length = 9 := rfl
  rw [hn] at hj
  obtain h | h | h := (by omega : (0 ≤ j ∧ j < 4) ∨ (4 ≤ j ∧ j < 8) ∨ (8 ≤ j ∧ j < 9))
  exacts [pieceOneOK_of_range pieceRange_12x160_0 h.1 h.2, pieceOneOK_of_range pieceRange_12x160_1 h.1 h.2, pieceOneOK_of_range pieceRange_12x160_2 h.1 h.2]

end Grothe.LowerAnalytic
