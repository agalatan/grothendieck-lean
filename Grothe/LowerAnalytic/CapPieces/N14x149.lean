/-! # The cap of node 149 of row 14 from its pieces (generated by `tools/gen_cap_pieces.py nodes`; do not edit)

Checked pieces: 9 of 9 in 3 range facts; excluded: [].
-/

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

/-- **The cap of node 149 of row 14**, given the bounds of the excluded pieces []. -/
theorem nodeCap_14x149
    (hex : ∀ j ∈ ([] : List ℕ), ∀ cs, (pieceCons pieceNode_14x149)[j]? = some cs → PieceCap 14 149 cs) :
    NodeCap 14 149 := by
  refine nodeCap_of_ranges pieceNode_14x149 [] pieceCover_14x149 (fun j hj hx => ?_) hex
  have hn : (pieceNode_14x149).2.2.2.length = 9 := rfl
  rw [hn] at hj
  obtain h | h | h := (by omega : (0 ≤ j ∧ j < 4) ∨ (4 ≤ j ∧ j < 8) ∨ (8 ≤ j ∧ j < 9))
  exacts [pieceOneOK_of_range pieceRange_14x149_0 h.1 h.2, pieceOneOK_of_range pieceRange_14x149_1 h.1 h.2, pieceOneOK_of_range pieceRange_14x149_2 h.1 h.2]

end Grothe.LowerAnalytic
