    NodeCap 15 174 := by
  refine nodeCap_of_ranges pieceNode_15x174 [] pieceCover_15x174 (fun j hj hx => ?_) hex
  have hn : (pieceNode_15x174).2.2.2.length = 9 := rfl
  rw [hn] at hj
  obtain h | h | h := (by omega : (0 ≤ j ∧ j < 4) ∨ (4 ≤ j ∧ j < 8) ∨ (8 ≤ j ∧ j < 9))
  exacts [pieceOneOK_of_range pieceRange_15x174_0 h.1 h.2, pieceOneOK_of_range pieceRange_15x174_1 h.1 h.2, pieceOneOK_of_range pieceRange_15x174_2 h.1 h.2]

