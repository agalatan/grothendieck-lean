import Grothe.LowerAnalytic.CapCommonFacts
import Grothe.LowerAnalytic.CapRow00.Data
import Grothe.LowerAnalytic.CapPieces.C00x3
import Grothe.LowerAnalytic.CapPieces.R00x3_0
import Grothe.LowerAnalytic.CapPieces.R00x3_1

/-! # The cap of node 3 of row 0 (`t = 0.4`) from its 10 pieces (generated by `tools/gen_tail_caps.py`; do not edit) -/

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

/-- **The cap of node 3 of row 0** with the tail `ν̂`. -/
theorem nodeCap_00x3 : NodeCapNu capNu capRow00 capR00 3 := by
  refine nodeCapNu_of_ranges rfl capNu_nonneg capNu_lt_one capRow00 capR00 pieceNode_00x3
    (pieceCoverOK_of_fast pieceCover_00x3) (fun j hj => ?_)
  have hn : pieceNode_00x3.2.2.2.length = 10 := rfl
  rw [hn] at hj
  rcases (by omega : j < 9 ∨ (9 ≤ j ∧ j < 10)) with h | ⟨h1, h2⟩
  · exact pieceOneOKNu_of_range pieceRange_00x3_0 (Nat.zero_le _) h
  · exact pieceOneOKNu_of_range pieceRange_00x3_1 h1 h2

end Grothe.LowerAnalytic
