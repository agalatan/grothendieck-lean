/-! # The cap of node 12 of row 0 (`t = 0.4`) from its 11 pieces (generated by `tools/gen_tail_caps.py`; do not edit) -/

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

/-- **The cap of node 12 of row 0** with the tail `ν̂`. -/
theorem nodeCap_00x12 : NodeCapNu capNu capRow00 capR00 12 := by
  refine nodeCapNu_of_ranges rfl capNu_nonneg capNu_lt_one capRow00 capR00 pieceNode_00x12
    (pieceCoverOK_of_fast pieceCover_00x12) (fun j hj => ?_)
  have hn : pieceNode_00x12.2.2.2.length = 11 := rfl
  rw [hn] at hj
  rcases (by omega : j < 9 ∨ (9 ≤ j ∧ j < 11)) with h | ⟨h1, h2⟩
  · exact pieceOneOKNu_of_range pieceRange_00x12_0 (Nat.zero_le _) h
  · exact pieceOneOKNu_of_range pieceRange_00x12_1 h1 h2

end Grothe.LowerAnalytic
