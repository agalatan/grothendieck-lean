  rw [hn] at hj
  obtain h | h | h := (by omega : (0 ≤ j ∧ j < 4) ∨ (4 ≤ j ∧ j < 8) ∨ (8 ≤ j ∧ j < 9))
  exacts [pieceOneOK_of_range pieceRange_15x177_0 h.1 h.2, pieceOneOK_of_range pieceRange_15x177_1 h.1 h.2, pieceOneOK_of_range pieceRange_15x177_2 h.1 h.2]

