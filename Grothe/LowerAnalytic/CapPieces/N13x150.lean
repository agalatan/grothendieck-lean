import Grothe.LowerAnalytic.CapPieceNodes
import Grothe.LowerAnalytic.CapPieces.C13x150
import Grothe.LowerAnalytic.CapPieces.R13x150_0
import Grothe.LowerAnalytic.CapPieces.R13x150_1
import Grothe.LowerAnalytic.CapPieces.R13x150_2

/-! # The cap of node 150 of row 13 from its pieces (generated by `tools/gen_cap_pieces.py nodes`; do not edit)

Checked pieces: 9 of 9 in 3 range facts; excluded: [].
-/

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

/-- **The cap of node 150 of row 13**, given the bounds of the excluded pieces []. -/
theorem nodeCap_13x150
    (hex : ∀ j ∈ ([] : List ℕ), ∀ cs, (pieceCons pieceNode_13x150)[j]? = some cs → PieceCap 13 150 cs) :
    NodeCap 13 150 := by
  refine nodeCap_of_ranges pieceNode_13x150 [] pieceCover_13x150 (fun j hj hx => ?_) hex
  have hn : (pieceNode_13x150).2.2.2.length = 9 := rfl
  rw [hn] at hj
  obtain h | h | h := (by omega : (0 ≤ j ∧ j < 4) ∨ (4 ≤ j ∧ j < 8) ∨ (8 ≤ j ∧ j < 9))
  exacts [pieceOneOK_of_range pieceRange_13x150_0 h.1 h.2, pieceOneOK_of_range pieceRange_13x150_1 h.1 h.2, pieceOneOK_of_range pieceRange_13x150_2 h.1 h.2]

end Grothe.LowerAnalytic
