namespace Grothe.LowerAnalytic

/-- **The cap of node 144 of row 12**, given the bounds of the excluded pieces []. -/
theorem nodeCap_12x144
    (hex : ∀ j ∈ ([] : List ℕ), ∀ cs, (pieceCons pieceNode_12x144)[j]? = some cs → PieceCap 12 144 cs) :
    NodeCap 12 144 := by
  refine nodeCap_of_ranges pieceNode_12x144 [] pieceCover_12x144 (fun j hj hx => ?_) hex
  have hn : (pieceNode_12x144).2.2.2.length = 9 := rfl
  rw [hn] at hj
  obtain h | h | h := (by omega : (0 ≤ j ∧ j < 4) ∨ (4 ≤ j ∧ j < 8) ∨ (8 ≤ j ∧ j < 9))
  exacts [pieceOneOK_of_range pieceRange_12x144_0 h.1 h.2, pieceOneOK_of_range pieceRange_12x144_1 h.1 h.2, pieceOneOK_of_range pieceRange_12x144_2 h.1 h.2]

end Grothe.LowerAnalytic
