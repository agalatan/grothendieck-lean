set_option maxRecDepth 100000

/-- **The cap of node 168 of row 13**, given the bounds of the excluded pieces []. -/
theorem nodeCap_13x168
    (hex : ∀ j ∈ ([] : List ℕ), ∀ cs, (pieceCons pieceNode_13x168)[j]? = some cs → PieceCap 13 168 cs) :
    NodeCap 13 168 := by
  refine nodeCap_of_ranges pieceNode_13x168 [] pieceCover_13x168 (fun j hj hx => ?_) hex
  have hn : (pieceNode_13x168).2.2.2.length = 9 := rfl
  rw [hn] at hj
  obtain h | h | h := (by omega : (0 ≤ j ∧ j < 4) ∨ (4 ≤ j ∧ j < 8) ∨ (8 ≤ j ∧ j < 9))
  exacts [pieceOneOK_of_range pieceRange_13x168_0 h.1 h.2, pieceOneOK_of_range pieceRange_13x168_1 h.1 h.2, pieceOneOK_of_range pieceRange_13x168_2 h.1 h.2]

end Grothe.LowerAnalytic
