  rw [hn] at hj
  rcases (by omega : j < 9 ∨ (9 ≤ j ∧ j < 17)) with h | ⟨h1, h2⟩
  · exact pieceOneOKNu_of_range pieceRange_01x40_0 (Nat.zero_le _) h
