import Grothe.LowerAnalytic.CapCommonFacts
import Grothe.LowerAnalytic.CapRow00.Data
import Grothe.LowerAnalytic.CapPieces.C00x0
import Grothe.LowerAnalytic.CapPieces.R00x0_0

/-! # The cap of node 0 of row 0 (`t = 0.4`) from its 9 pieces (generated by `tools/gen_tail_caps.py`; do not edit) -/

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

/-- **The cap of node 0 of row 0** with the tail `ν̂`. -/
theorem nodeCap_00x0 : NodeCapNu capNu capRow00 capR00 0 := by
  refine nodeCapNu_of_ranges rfl capNu_nonneg capNu_lt_one capRow00 capR00 pieceNode_00x0
    (pieceCoverOK_of_fast pieceCover_00x0) (fun j hj => ?_)
  have hn : pieceNode_00x0.2.2.2.length = 9 := rfl
  rw [hn] at hj
  exact pieceOneOKNu_of_range pieceRange_00x0_0 (Nat.zero_le _) hj

end Grothe.LowerAnalytic
