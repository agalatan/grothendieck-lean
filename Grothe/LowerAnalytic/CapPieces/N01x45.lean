set_option maxRecDepth 100000

/-- **The cap of node 45 of row 1** with the tail `ν̂`. -/
theorem nodeCap_01x45 : NodeCapNu capNu capRow01 capR01 45 := by
  refine nodeCapNu_of_ranges rfl capNu_nonneg capNu_lt_one capRow01 capR01 pieceNode_01x45
    (pieceCoverOK_of_fast pieceCover_01x45) (fun j hj => ?_)
  have hn : pieceNode_01x45.2.2.2.length = 18 := rfl
  rw [hn] at hj
  rcases (by omega : j < 9 ∨ (9 ≤ j ∧ j < 18)) with h | ⟨h1, h2⟩
  · exact pieceOneOKNu_of_range pieceRange_01x45_0 (Nat.zero_le _) h
  · exact pieceOneOKNu_of_range pieceRange_01x45_1 h1 h2

end Grothe.LowerAnalytic
