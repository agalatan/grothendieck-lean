lemma C6'_le_C6 : C6' ≤ C6 := by unfold C6' C6; norm_num

lemma C6'_pos : 0 < C6' := by unfold C6'; norm_num

/-- The sharper majorant is below the old one for `x ≥ 0`. -/
lemma nX'_le_nX (x : ℝ) (hx : 0 ≤ x) : nX' x ≤ nX x := by
  unfold nX' nX
  have h3 : 0 ≤ x ^ 3 := by positivity
  nlinarith [mul_le_mul_of_nonneg_right C6'_le_C6 h3]

/-- The first-moment bound from the moment lemma, with any third moment at most the old
majorant `nX x`: `E√Z < ρ`.  (`Z = |q|²`, `x² = E|q|⁴ − 2`, `0 ≤ x ≤ 31/4`.) -/
theorem first_moment_lt_rho {Ω : Type*} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
    [MeasureTheory.IsProbabilityMeasure μ] (Z : Ω → ℝ) (hZ : ∀ ω, 0 ≤ Z ω)
    (hZ1 : MeasureTheory.Integrable Z μ) (hZ2 : MeasureTheory.Integrable (fun ω => Z ω ^ 2) μ)
    (hZ3 : MeasureTheory.Integrable (fun ω => Z ω ^ 3) μ)
    (x : ℝ) (h0 : 0 ≤ x) (h1 : x ≤ 31 / 4)
    (hm1 : ∫ ω, Z ω ∂μ = 1) (hm2 : ∫ ω, Z ω ^ 2 ∂μ = mX x) (hm3 : ∫ ω, Z ω ^ 3 ∂μ ≤ nX x) :
    ∫ ω, √(Z ω) ∂μ < rhoC := by
  have hm : 1 < mX x := by unfold mX; nlinarith [sq_nonneg x]
  have hN : mX x ^ 2 < nX x := by
    have := q1poly_pos x h0 h1
    unfold q1poly at this; linarith
  exact lt_of_le_of_lt (moment_lemma μ Z hZ hZ1 hZ2 hZ3 (mX x) (nX x) hm1 hm2 hm3 hm hN)
    (moment_bound_lt_rho x h0 h1)

/-- **The sharper constant inherits `ρ`**: with the third moment bounded by `nX' x`, still
`E√Z < ρ = 0.977459`. -/
theorem first_moment_lt_rho' {Ω : Type*} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
    [MeasureTheory.IsProbabilityMeasure μ] (Z : Ω → ℝ) (hZ : ∀ ω, 0 ≤ Z ω)
    (hZ1 : MeasureTheory.Integrable Z μ) (hZ2 : MeasureTheory.Integrable (fun ω => Z ω ^ 2) μ)
    (hZ3 : MeasureTheory.Integrable (fun ω => Z ω ^ 3) μ)
    (x : ℝ) (h0 : 0 ≤ x) (h1 : x ≤ 31 / 4)
    (hm1 : ∫ ω, Z ω ∂μ = 1) (hm2 : ∫ ω, Z ω ^ 2 ∂μ = mX x) (hm3 : ∫ ω, Z ω ^ 3 ∂μ ≤ nX' x) :
    ∫ ω, √(Z ω) ∂μ < rhoC :=
  first_moment_lt_rho μ Z hZ hZ1 hZ2 hZ3 x h0 h1 hm1 hm2 (hm3.trans (nX'_le_nX x h0))

