import Grothe.LowerAnalytic.CapRow10.Data
import Grothe.Lower.RowData11

/-! # Row 10 (`t = 0.86`): the row of the caps is the row of the Stein side (generated by `tools/gen_tail_caps.py`; do not edit)

The cap data `capRow10` and the Stein row `row11` (`gen_lower_data.py`) are written from the same constants and the
same cap table; their common fields agree by `rfl`, and `R` is the gate of the row (`rowGates`). -/

namespace Grothe.LowerAnalytic

theorem capBridge10 :
    Grothe.Lower.row11.ell = capRow10.ell ∧
      Grothe.Lower.row11.beta = capRow10.beta ∧
      Grothe.Lower.row11.delta = capRow10.delta ∧
      Grothe.Lower.row11.kappa = capRow10.kappa ∧
      Grothe.Lower.row11.smax = capRow10.smax ∧
      Grothe.Lower.row11.E = capRow10.E ∧
      Grothe.Lower.row11.b1 = capRow10.b1 ∧
      Grothe.Lower.row11.b2 = capRow10.b2 ∧
      Grothe.Lower.row11.b3 = capRow10.b3 ∧
      Grothe.Lower.row11.nodes = capRow10.nodes :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

end Grothe.LowerAnalytic
