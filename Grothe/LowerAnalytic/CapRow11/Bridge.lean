import Grothe.LowerAnalytic.CapRow11.Data
import Grothe.Lower.RowData12

/-! # Row 11 (`t = 0.87`): the row of the caps is the row of the Stein side (generated by `tools/gen_tail_caps.py`; do not edit)

The cap data `capRow11` and the Stein row `row12` (`gen_lower_data.py`) are written from the same constants and the
same cap table; their common fields agree by `rfl`, and `R` is the gate of the row (`rowGates`). -/

namespace Grothe.LowerAnalytic

theorem capBridge11 :
    Grothe.Lower.row12.ell = capRow11.ell ∧
      Grothe.Lower.row12.beta = capRow11.beta ∧
      Grothe.Lower.row12.delta = capRow11.delta ∧
      Grothe.Lower.row12.kappa = capRow11.kappa ∧
      Grothe.Lower.row12.smax = capRow11.smax ∧
      Grothe.Lower.row12.E = capRow11.E ∧
      Grothe.Lower.row12.b1 = capRow11.b1 ∧
      Grothe.Lower.row12.b2 = capRow11.b2 ∧
      Grothe.Lower.row12.b3 = capRow11.b3 ∧
      Grothe.Lower.row12.nodes = capRow11.nodes :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

end Grothe.LowerAnalytic
