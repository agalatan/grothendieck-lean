def price (w : ℚ) : ℚ := (prices.lookup w).getD 0

def smallPrice (w : ℚ) : ℚ := (smallPrices.lookup w).getD 0

def smallStop : ℚ := 21/100

def bonus (w z : ℚ) : ℚ := min (min (4*(smallPrice w-price w)) (4*(smallPrice z-price z)))
  ((2019911/10^10)*(w-z)^2*(smallStop / Grothe.Lower.row08.delta)^2)

theorem small_weights : prices.map Prod.fst = smallPrices.map Prod.fst := by rfl

theorem price_weights : prices.map Prod.fst = CoupledStein.prices.map Prod.fst := by rfl

