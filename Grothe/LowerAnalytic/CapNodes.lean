/-!
# The certified rows of the node caps (generated by `tools/gen_cap_nodes.py`; do not edit)

`capRowsDone`: the rows whose vertex caps are certified inside Lean, by the range checks of the
computation-only modules `CapRowKK` (one `native_decide` fact per sequential range).
The cheap `vertexCapsRowKK` proofs below connect those facts to the cap soundness layer.
Consequently the lower bound needs only the vertex caps of the remaining rows and of the
excluded nodes (`CapsRest`, `lower_bound_of_capsRest`).
-/

open GrotheKernel Grothe.Lower

namespace Grothe.LowerAnalytic

/-- The vertex caps of row 0, given the caps at its excluded nodes. -/
theorem vertexCapsRow00 (hex : ExclCaps 0 (capExcl 0)) : VertexCapsRow 0 := by
  intro i hi hc
  rcases (show i < 49 ∨ (49 ≤ i ∧ i < 98) ∨ (98 ≤ i ∧ i < 147) ∨ 147 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h
  · exact nodeCap_of_rangeOK capRange00_0 hex (Nat.zero_le _) h hi hc
  · exact nodeCap_of_rangeOK capRange00_1 hex h1 h2 hi hc
  · exact nodeCap_of_rangeOK capRange00_2 hex h1 h2 hi hc
  · exact nodeCap_of_rangeOK capRange00_3 hex h hi hi hc

