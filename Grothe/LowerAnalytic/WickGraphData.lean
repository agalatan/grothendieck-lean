section moments

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {E : MvPolynomial ι ℝ →ₗ[ℝ] ℝ}
  (hE : IsGaussianExpectation E) {F : MvPolynomial ι ℝ} (hF : Chaos3 F)
include hE hF

theorem wg2_moment : E (F ^ 2) = (1 / 6 : ℝ) * gval E F wg2_3 := by
  rw [← gval_empty E F (N := 2)]
  change gval E F wg2_0 = _
  have h0 : ((3 : ℕ) : ℝ) * gval E F wg2_0 = _ :=
    gval_step_cert hE hF (v₀ := 0) (succ := [(1, ![0, 1], wg2_1)]) (by decide +kernel)
  have h1 : ((2 : ℕ) : ℝ) * gval E F wg2_1 = _ :=
    gval_step_cert hE hF (v₀ := 0) (succ := [(1, ![0, 1], wg2_2)]) (by decide +kernel)
  have h2 : ((1 : ℕ) : ℝ) * gval E F wg2_2 = _ :=
    gval_step_cert hE hF (v₀ := 0) (succ := [(1, ![0, 1], wg2_3)]) (by decide +kernel)
  simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Nat.cast_ofNat, Nat.cast_one] at *
  linear_combination (1 / 3 : ℝ) * h0 + (1 / 6 : ℝ) * h1 + (1 / 6 : ℝ) * h2

theorem wg4_moment : E (F ^ 4) = (1 / 12 : ℝ) * gval E F wg4_15 + (3 / 2 : ℝ) * gval E F wg4_16 + (1 : ℝ) * gval E F wg4_17 := by
  rw [← gval_empty E F (N := 4)]
  change gval E F wg4_0 = _
  have h0 : ((3 : ℕ) : ℝ) * gval E F wg4_0 = _ :=
    gval_step_cert hE hF (v₀ := 0) (succ := [(1, ![0, 1, 2, 3], wg4_1), (2, ![0, 2, 1, 3], wg4_1), (3, ![0, 2, 3, 1], wg4_1)]) (by decide +kernel)
  have h1 : ((2 : ℕ) : ℝ) * gval E F wg4_1 = _ :=
    gval_step_cert hE hF (v₀ := 0) (succ := [(1, ![0, 1, 2, 3], wg4_2), (2, ![0, 1, 2, 3], wg4_3), (3, ![0, 1, 3, 2], wg4_3)]) (by decide +kernel)
  have h2 : ((1 : ℕ) : ℝ) * gval E F wg4_2 = _ :=
    gval_step_cert hE hF (v₀ := 0) (succ := [(1, ![0, 1, 2, 3], wg4_4), (2, ![0, 1, 2, 3], wg4_5), (3, ![0, 1, 3, 2], wg4_5)]) (by decide +kernel)
  have h3 : ((1 : ℕ) : ℝ) * gval E F wg4_3 = _ :=
    gval_step_cert hE hF (v₀ := 0) (succ := [(1, ![0, 1, 2, 3], wg4_5), (2, ![0, 2, 1, 3], wg4_5), (3, ![0, 1, 2, 3], wg4_6)]) (by decide +kernel)
  have h4 : ((3 : ℕ) : ℝ) * gval E F wg4_4 = _ :=
    gval_step_cert hE hF (v₀ := 2) (succ := [(3, ![0, 1, 2, 3], wg4_7)]) (by decide +kernel)
  have h5 : ((1 : ℕ) : ℝ) * gval E F wg4_5 = _ :=
    gval_step_cert hE hF (v₀ := 1) (succ := [(2, ![0, 1, 2, 3], wg4_8), (3, ![0, 1, 2, 3], wg4_9)]) (by decide +kernel)
  have h6 : ((2 : ℕ) : ℝ) * gval E F wg4_6 = _ :=
    gval_step_cert hE hF (v₀ := 1) (succ := [(2, ![0, 1, 2, 3], wg4_10), (3, ![0, 1, 3, 2], wg4_10)]) (by decide +kernel)
  have h7 : ((2 : ℕ) : ℝ) * gval E F wg4_7 = _ :=
    gval_step_cert hE hF (v₀ := 2) (succ := [(3, ![0, 1, 2, 3], wg4_11)]) (by decide +kernel)
  have h8 : ((1 : ℕ) : ℝ) * gval E F wg4_8 = _ :=
    gval_step_cert hE hF (v₀ := 2) (succ := [(3, ![0, 1, 2, 3], wg4_12)]) (by decide +kernel)
  have h9 : ((2 : ℕ) : ℝ) * gval E F wg4_9 = _ :=
    gval_step_cert hE hF (v₀ := 2) (succ := [(3, ![0, 1, 2, 3], wg4_13)]) (by decide +kernel)
  have h10 : ((1 : ℕ) : ℝ) * gval E F wg4_10 = _ :=
    gval_step_cert hE hF (v₀ := 1) (succ := [(2, ![2, 0, 1, 3], wg4_12), (3, ![0, 1, 2, 3], wg4_14)]) (by decide +kernel)
  have h11 : ((1 : ℕ) : ℝ) * gval E F wg4_11 = _ :=
    gval_step_cert hE hF (v₀ := 2) (succ := [(3, ![0, 1, 2, 3], wg4_15)]) (by decide +kernel)
  have h12 : ((2 : ℕ) : ℝ) * gval E F wg4_12 = _ :=
    gval_step_cert hE hF (v₀ := 3) (succ := []) (by decide +kernel)
  have h13 : ((1 : ℕ) : ℝ) * gval E F wg4_13 = _ :=
    gval_step_cert hE hF (v₀ := 2) (succ := [(3, ![0, 1, 2, 3], wg4_16)]) (by decide +kernel)
  have h14 : ((1 : ℕ) : ℝ) * gval E F wg4_14 = _ :=
