/-!
# The node caps of row 2 (`t = 0.7`) (generated by `tools/gen_tail_caps.py`; do not edit)

The vertex caps from the whole-fibre range facts and the caps of the localised nodes, the chord nodes by convexity
(`nodeCaps_of_vertexCapsNu`).
-/

open GrotheKernel Grothe.Lower

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

theorem exclCapsRow02 : ExclCapsNu capNu capRow02 capR02 capExcl02 := by
  intro i hmem _hi
  simp only [capExcl02, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact nodeCap_02x0
  · exact nodeCap_02x1
  · exact nodeCap_02x3
  · exact nodeCap_02x6
  · exact nodeCap_02x9
  · exact nodeCap_02x12
  · exact nodeCap_02x15
  · exact nodeCap_02x23
  · exact nodeCap_02x27
  · exact nodeCap_02x28
  · exact nodeCap_02x29
  · exact nodeCap_02x31
  · exact nodeCap_02x32
  · exact nodeCap_02x33
  · exact nodeCap_02x34
  · exact nodeCap_02x35
  · exact nodeCap_02x37
  · exact nodeCap_02x39
  · exact nodeCap_02x41
  · exact nodeCap_02x43
  · exact nodeCap_02x45
  · exact nodeCap_02x47
  · exact nodeCap_02x48
  · exact nodeCap_02x49
  · exact nodeCap_02x65

theorem vertexCapsRow02 : VertexCapsRowNu capNu capRow02 capR02 capChords02 := by
  intro i hi hc
  rcases (show i < 68 ∨ (68 ≤ i ∧ i < 75) ∨ (75 ≤ i ∧ i < 82) ∨ (82 ≤ i ∧ i < 89) ∨ (89 ≤ i ∧ i < 96) ∨ (96 ≤ i ∧ i < 103) ∨ 103 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row02AnchorRange00
      exclCapsRow02 (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row02AnchorRange01
      exclCapsRow02 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row02AnchorRange02
      exclCapsRow02 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row02AnchorRange03
      exclCapsRow02 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row02AnchorRange04
      exclCapsRow02 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row02AnchorRange05
      exclCapsRow02 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row02AnchorRange06
      exclCapsRow02 h1 hi hi hc

theorem chordsOKRow02 : chordOKLow capRow02.nodeList capChords02 = true := by native_decide

theorem psdRow02 : capRow02.E.psdOK = true ∧ capR02.psdOK = true := by decide +kernel

/-- **The node caps of row 2** (`t = 0.7`) with the tail `ν̂`. -/
theorem capsRow02 :
    ∀ m ∈ capRow02.nodeList, pot capRow02.E capR02 capRow02.ell capRow02.beta
      (aFib capRow02.b1 capRow02.b2 capRow02.b3) capNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu psdRow02.1 psdRow02.2 chordsOKRow02 vertexCapsRow02

end Grothe.LowerAnalytic
