theorem vertexCapsRow03 : VertexCapsRowNu capNu capRow03 capR03 capChords03 := by
  intro i hi hc
  rcases (show i < 7 ∨ (7 ≤ i ∧ i < 46) ∨ (46 ≤ i ∧ i < 58) ∨ (58 ≤ i ∧ i < 65) ∨ (65 ≤ i ∧ i < 72) ∨ (72 ≤ i ∧ i < 79) ∨ (79 ≤ i ∧ i < 86) ∨ (86 ≤ i ∧ i < 93) ∨ 93 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row03AnchorRange00
      exclCapsRow03 (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row03AnchorRange01
      exclCapsRow03 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row03AnchorRange02
      exclCapsRow03 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row03AnchorRange03
      exclCapsRow03 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row03AnchorRange04
      exclCapsRow03 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row03AnchorRange05
      exclCapsRow03 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row03AnchorRange06
      exclCapsRow03 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row03AnchorRange07
      exclCapsRow03 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row03AnchorRange08
      exclCapsRow03 h1 hi hi hc

theorem chordsOKRow03 : chordOKLow capRow03.nodeList capChords03 = true := by native_decide

theorem psdRow03 : capRow03.E.psdOK = true ∧ capR03.psdOK = true := by decide +kernel

