/-!
# The node caps of row 1 (`t = 0.6`) (generated by `tools/gen_tail_caps.py`; do not edit)

The vertex caps from the whole-fibre range facts and the caps of the localised nodes, the chord nodes by convexity
(`nodeCaps_of_vertexCapsNu`).
-/

open GrotheKernel Grothe.Lower

namespace Grothe.LowerAnalytic

set_option maxRecDepth 100000

theorem exclCapsRow01 : ExclCapsNu capNu capRow01 capR01 capExcl01 := by
  intro i hmem _hi
  simp only [capExcl01, List.mem_cons, List.not_mem_nil, or_false] at hmem
  rcases hmem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact nodeCap_01x0
  · exact nodeCap_01x1
  · exact nodeCap_01x3
  · exact nodeCap_01x6
  · exact nodeCap_01x8
  · exact nodeCap_01x9
  · exact nodeCap_01x24
  · exact nodeCap_01x25
  · exact nodeCap_01x27
  · exact nodeCap_01x33
  · exact nodeCap_01x35
  · exact nodeCap_01x39
  · exact nodeCap_01x40
  · exact nodeCap_01x41
  · exact nodeCap_01x44
  · exact nodeCap_01x45
  · exact nodeCap_01x51
  · exact nodeCap_01x65

theorem vertexCapsRow01 : VertexCapsRowNu capNu capRow01 capR01 capChords01 := by
  intro i hi hc
  rcases (show i < 68 ∨ (68 ≤ i ∧ i < 75) ∨ (75 ≤ i ∧ i < 82) ∨ (82 ≤ i ∧ i < 89) ∨ (89 ≤ i ∧ i < 96) ∨ (96 ≤ i ∧ i < 103) ∨ (103 ≤ i ∧ i < 110) ∨ (110 ≤ i ∧ i < 117) ∨ 117 ≤ i by omega) with h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | h1
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row01AnchorRange00
      exclCapsRow01 (Nat.zero_le _) h hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row01AnchorRange01
      exclCapsRow01 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row01AnchorRange02
      exclCapsRow01 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row01AnchorRange03
      exclCapsRow01 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row01AnchorRange04
      exclCapsRow01 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row01AnchorRange05
      exclCapsRow01 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row01AnchorRange06
      exclCapsRow01 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row01AnchorRange07
      exclCapsRow01 h1 h2 hi hc
  · exact nodeCapNu_of_rangeOK rfl capNu_nonneg capNu_lt_one row01AnchorRange08
      exclCapsRow01 h1 hi hi hc

theorem chordsOKRow01 : chordOKLow capRow01.nodeList capChords01 = true := by native_decide

theorem psdRow01 : capRow01.E.psdOK = true ∧ capR01.psdOK = true := by decide +kernel

/-- **The node caps of row 1** (`t = 0.6`) with the tail `ν̂`. -/
theorem capsRow01 :
    ∀ m ∈ capRow01.nodeList, pot capRow01.E capR01 capRow01.ell capRow01.beta
      (aFib capRow01.b1 capRow01.b2 capRow01.b3) capNu m.1 - capPad ≤ m.2 :=
  nodeCaps_of_vertexCapsNu psdRow01.1 psdRow01.2 chordsOKRow01 vertexCapsRow01

end Grothe.LowerAnalytic
