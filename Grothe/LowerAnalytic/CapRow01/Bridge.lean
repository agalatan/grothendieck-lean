import Grothe.LowerAnalytic.CapRow01.Data
import Grothe.Lower.RowData02

/-! # Row 1 (`t = 0.6`): the row of the caps is the row of the Stein side (generated by `tools/gen_tail_caps.py`; do not edit)

The cap data `capRow01` and the Stein row `row02` (`gen_lower_data.py`) are written from the same constants and the
same cap table; their common fields agree by `rfl`, and `R` is the gate of the row (`rowGates`). -/

namespace Grothe.LowerAnalytic

theorem capBridge01 :
    Grothe.Lower.row02.ell = capRow01.ell ∧
      Grothe.Lower.row02.beta = capRow01.beta ∧
      Grothe.Lower.row02.delta = capRow01.delta ∧
      Grothe.Lower.row02.kappa = capRow01.kappa ∧
      Grothe.Lower.row02.smax = capRow01.smax ∧
      Grothe.Lower.row02.E = capRow01.E ∧
      Grothe.Lower.row02.b1 = capRow01.b1 ∧
      Grothe.Lower.row02.b2 = capRow01.b2 ∧
      Grothe.Lower.row02.b3 = capRow01.b3 ∧
      Grothe.Lower.row02.nodes = capRow01.nodes :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

end Grothe.LowerAnalytic
