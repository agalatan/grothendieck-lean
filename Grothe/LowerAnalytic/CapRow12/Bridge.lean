same cap table; their common fields agree by `rfl`, and `R` is the gate of the row (`rowGates`). -/

namespace Grothe.LowerAnalytic

theorem capBridge12 :
    Grothe.Lower.row13.ell = capRow12.ell ∧
      Grothe.Lower.row13.beta = capRow12.beta ∧
      Grothe.Lower.row13.delta = capRow12.delta ∧
      Grothe.Lower.row13.kappa = capRow12.kappa ∧
      Grothe.Lower.row13.smax = capRow12.smax ∧
      Grothe.Lower.row13.E = capRow12.E ∧
      Grothe.Lower.row13.b1 = capRow12.b1 ∧
      Grothe.Lower.row13.b2 = capRow12.b2 ∧
      Grothe.Lower.row13.b3 = capRow12.b3 ∧
      Grothe.Lower.row13.nodes = capRow12.nodes :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

end Grothe.LowerAnalytic
