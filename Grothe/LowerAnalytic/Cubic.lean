import Grothe.LowerAnalytic.MomentLemma

/-!
# The cubic-moment constants `C₆` and `ρ`

Generated by `tools/gen_cubic.py` (exact rationals).  For a normalized cubic-chaos variable
`Y = |q|` with `x² = E|Y|⁴ − 2 ∈ [0, 60]` the lower-bound argument uses

* the sixth-moment bound `E Y⁶ ≤ 6 + 9x² + C₆ x³` with `C₆ = 49.42288923`, whose remaining
  scalar inequality is `sixthGap_pos`: `(50/27) C₆² (1 + 3y²/2)³ − N(y)² > 0` on `[0, 1]`,
  `N(y) = 95/2 + (165/2) y + 45 y² + (135/2) y³`;
* the first-moment bound `E Y < ρ = 0.977459`, obtained from the three-moment lemma
  (`moment_lemma`) and the positivity of `N − m²`, `U`, `U² − 4(1−ρ²)²(N−m²)(m−1)` on
  `[0, 31/4]` (`q1poly_pos`, `Upoly_pos`, `gap8_pos`), giving `first_moment_lt_rho`.

Each positivity statement is proved on a subdivision of the interval: on every leaf `[l, h]`
the polynomial is rewritten in the Bernstein basis of `s = (x − l)/(h − l) ∈ [0, 1]`; since
the Bernstein basis functions are nonnegative and sum to one, the polynomial is at least its
smallest Bernstein coefficient, which is positive.  `linarith` verifies the Bernstein identity
from the nonnegativity of the basis terms.
-/

namespace Grothe.LowerAnalytic

noncomputable section

/-- `C₆ = 49.42288923`. -/
def C6 : ℝ := 4942288923 / 100000000
/-- `ρ = 0.977459`. -/
def rhoC : ℝ := 977459 / 1000000
/-- `N(y) = 95/2 + (165/2) y + 45 y² + (135/2) y³`. -/
def Ncub (y : ℝ) : ℝ := 95 / 2 + 165 / 2 * y + 45 * y ^ 2 + 135 / 2 * y ^ 3
/-- The sixth-moment gap polynomial. -/
def sixthGap (y : ℝ) : ℝ := 50 / 27 * C6 ^ 2 * (1 + 3 / 2 * y ^ 2) ^ 3 - Ncub y ^ 2
/-- `m = 2 + x²`. -/
def mX (x : ℝ) : ℝ := 2 + x ^ 2
/-- `N = 6 + 9x² + C₆ x³`. -/
def nX (x : ℝ) : ℝ := 6 + 9 * x ^ 2 + C6 * x ^ 3
/-- `N − m²`. -/
def q1poly (x : ℝ) : ℝ := nX x - mX x ^ 2
/-- `U = ρ²(N−m) − (m−1) − (N−m²)`. -/
def Upoly (x : ℝ) : ℝ := rhoC ^ 2 * (nX x - mX x) - (mX x - 1) - (nX x - mX x ^ 2)
/-- `U² − 4(1−ρ²)²(N−m²)(m−1)`. -/
def gap8 (x : ℝ) : ℝ := Upoly x ^ 2 - 4 * (1 - rhoC ^ 2) ^ 2 * q1poly x * (mX x - 1)

