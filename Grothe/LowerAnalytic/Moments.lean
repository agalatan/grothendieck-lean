  · exact lt_of_lt_of_le (by norm_num) (gap8_leaf0 x h0 hA0)
  rcases le_or_gt x (155 / 128 : ℝ) with hA1 | hA1
  · exact lt_of_lt_of_le (by norm_num) (gap8_leaf1 x hA0.le hA1)
  rcases le_or_gt x (341 / 256 : ℝ) with hA2 | hA2
  · exact lt_of_lt_of_le (by norm_num) (gap8_leaf2 x hA1.le hA2)
  rcases le_or_gt x (1395 / 1024 : ℝ) with hA3 | hA3
  · exact lt_of_lt_of_le (by norm_num) (gap8_leaf3 x hA2.le hA3)
  rcases le_or_gt x (2821 / 2048 : ℝ) with hA4 | hA4
  · exact lt_of_lt_of_le (by norm_num) (gap8_leaf4 x hA3.le hA4)
  rcases le_or_gt x (22599 / 16384 : ℝ) with hA5 | hA5
  · exact lt_of_lt_of_le (by norm_num) (gap8_leaf5 x hA4.le hA5)
