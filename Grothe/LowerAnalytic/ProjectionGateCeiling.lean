import Mathlib.Analysis.InnerProductSpace.PiL2

/-!
A ceiling for gate-only models with a free common remote projector.
No Gaussian extraction, cubic realization, or Grothendieck endpoint is asserted.
-/
namespace Grothe.LowerAnalytic.ProjectionGateCeiling

open scoped ComplexConjugate
noncomputable section
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- The projector onto the line generated by a unit vector. -/
def rankOne (q : E) : E →ₗ[ℂ] E where
  toFun x := (inner ℂ q x) • q
  map_add' x y := by simp [inner_add_right, add_smul]
  map_smul' a x := by simp [inner_smul_right, mul_smul]

@[simp] theorem rankOne_apply (q x : E) :
    rankOne q x = (inner ℂ q x) • q := rfl

/-- Keeping the distinguished line fixes its coefficient under the map.
Orthogonal projectors containing `q` satisfy this hypothesis. -/
theorem coefficient_le_projected_norm (q : E) (hq : ‖q‖ = 1)
    (T : E →ₗ[ℂ] E) (hT : ∀ x, inner ℂ q (T x) = inner ℂ q x) (x : E) :
    ‖inner ℂ q x‖ ^ 2 ≤ ‖T x‖ ^ 2 := by
  have h : ‖inner ℂ q (T x)‖ ≤ ‖q‖ * ‖T x‖ := norm_inner_le_norm _ _
  rw [hT, hq, one_mul] at h
  exact pow_le_pow_left₀ (norm_nonneg _) h 2

/-- Self-adjointness and retaining the distinguished vector give the
coefficient-preservation hypothesis used in the gate bound. -/
theorem preserves_coefficient_of_selfadjoint (q : E) (T : E →ₗ[ℂ] E)
    (hself : ∀ x y, inner ℂ (T x) y = inner ℂ x (T y)) (hfix : T q = q)
    (x : E) : inner ℂ q (T x) = inner ℂ q x := by
  rw [← hself q x, hfix]

/-- Weighted two-field gate energy, written in exact Cholesky coordinates. -/
def gateEnergy (a d r : ℝ) (x y : E) : ℝ :=
  a * ‖x + (r : ℂ) • y‖ ^ 2 + d * ‖y‖ ^ 2

/-- Any common projection retaining the distinguished unit vector pays at
least the corresponding two scalar moments. This applies to a general PSD
2-by-2 gate by taking `r=b/a` and `d=c-b*b/a`. -/
theorem gateEnergy_lower (q : E) (hq : ‖q‖ = 1)
    (T : E →ₗ[ℂ] E) (hT : ∀ x, inner ℂ q (T x) = inner ℂ q x)
    (a d r : ℝ) (ha : 0 ≤ a) (hd : 0 ≤ d) (x y : E) :
    a * ‖inner ℂ q x + (r : ℂ) * inner ℂ q y‖ ^ 2
      + d * ‖inner ℂ q y‖ ^ 2 ≤ gateEnergy a d r (T x) (T y) := by
  have hxy := coefficient_le_projected_norm q hq T hT (x + (r : ℂ) • y)
  have hy := coefficient_le_projected_norm q hq T hT y
  simp only [inner_add_right, inner_smul_right, map_add, map_smul] at hxy
  exact add_le_add (mul_le_mul_of_nonneg_left hxy ha)
    (mul_le_mul_of_nonneg_left hy hd)

@[simp] theorem rankOne_norm_sq (q : E) (hq : ‖q‖ = 1) (x : E) :
    ‖rankOne q x‖ ^ 2 = ‖inner ℂ q x‖ ^ 2 := by
  simp [rankOne_apply, norm_smul, hq]

/-- The lower bound is attained simultaneously for every field by the same
rank-one projector, so all conditional field data do not improve a gate-only
model whose projector is otherwise free. -/
theorem gateEnergy_rankOne (q : E) (hq : ‖q‖ = 1)
    (a d r : ℝ) (x y : E) :
    gateEnergy a d r (rankOne q x) (rankOne q y) =
      a * ‖inner ℂ q x + (r : ℂ) * inner ℂ q y‖ ^ 2
        + d * ‖inner ℂ q y‖ ^ 2 := by
  unfold gateEnergy
  rw [← map_smul, ← map_add, rankOne_norm_sq q hq, rankOne_norm_sq q hq]
  simp only [inner_add_right, inner_smul_right]

/-- Unit normalization makes the rank-one map coefficient-preserving. -/
theorem rankOne_preserves_coefficient (q : E) (hq : ‖q‖ = 1) (x : E) :
    inner ℂ q (rankOne q x) = inner ℂ q x := by
  simp only [rankOne_apply, inner_smul_right]
  have hqq : inner ℂ q q = 1 := by
    rw [inner_self_eq_norm_sq_to_K, hq]
    norm_num
  rw [hqq, mul_one]

/-- The minimizing map is self-adjoint, so idempotence below makes it an
orthogonal projection rather than only an arbitrary coefficient-preserving map. -/
theorem rankOne_selfadjoint (q x y : E) :
    inner ℂ (rankOne q x) y = inner ℂ x (rankOne q y) := by
  simp only [rankOne_apply, inner_smul_left, inner_smul_right]
  rw [← inner_conj_symm x q]
  ring

/-- The minimizing projection is a contraction. -/
theorem rankOne_contraction (q : E) (hq : ‖q‖ = 1) (x : E) :
    ‖rankOne q x‖ ≤ ‖x‖ := by
  have h : ‖inner ℂ q x‖ ≤ ‖q‖ * ‖x‖ := norm_inner_le_norm _ _
  simpa [rankOne_apply, norm_smul, hq] using h

/-- The minimizing map is genuinely idempotent. -/
theorem rankOne_idempotent (q : E) (hq : ‖q‖ = 1) (x : E) :
    rankOne q (rankOne q x) = rankOne q x := by
  change (inner ℂ q (rankOne q x)) • q = (inner ℂ q x) • q
  rw [rankOne_preserves_coefficient q hq]

/-- Its image of the distinguished field has the required prescribed value. -/
theorem rankOne_c0 (q c0 : E) (tau : ℂ) (h0 : inner ℂ q c0 = tau) :
    rankOne q c0 = tau • q := by rw [rankOne_apply, h0]

#print axioms rankOne_apply
#print axioms rankOne_norm_sq
#print axioms coefficient_le_projected_norm
#print axioms preserves_coefficient_of_selfadjoint
#print axioms gateEnergy_lower
#print axioms gateEnergy_rankOne
#print axioms rankOne_preserves_coefficient
#print axioms rankOne_selfadjoint
#print axioms rankOne_contraction
#print axioms rankOne_idempotent
#print axioms rankOne_c0

end
end Grothe.LowerAnalytic.ProjectionGateCeiling
