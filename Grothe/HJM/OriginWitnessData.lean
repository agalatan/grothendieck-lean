set_option maxHeartbeats 16000000

theorem left_mass_check : mass leftAlpha ≤ leftMassCap := by decide +kernel
theorem left_weighted_mass_check : weightedMass leftAlpha ≤ weightedMassCap := by decide +kernel
theorem left_visible_arithmetic : leftMassCap * visibleTarget ≤ leftCorrelationLower ^ 2 := by decide +kernel

theorem right_mass_check : mass rightAlpha ≤ rightMassCap := by decide +kernel
theorem right_weighted_mass_check : weightedMass rightAlpha ≤ weightedMassCap := by decide +kernel
theorem right_visible_arithmetic : rightMassCap * visibleTarget ≤ rightCorrelationLower ^ 2 := by decide +kernel

theorem spatial_error_arithmetic :
    (102 : ℚ) * (1001 / 10 ^ 15) ≤ correlationError := by decide +kernel

