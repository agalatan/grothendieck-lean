import Grothe.Haagerup.Phase
import Grothe.UpperChaos.HermiteBasis
import Grothe.UpperChaos.PhaseMoments
import Mathlib.Algebra.Polynomial.Derivation

/-!
# The radial polynomial of a charge-one Hermite mode

Agent-ID: codex-aa04.

The bivariate complex Hermite polynomial `H (n+1) n` equals `z R_n(z*z̄)`,
where the real polynomial `R_n` is generated by a one-variable differential
recurrence. Its leading normalization is `R_n = (-1)^n n! L_n^(1)`.
The reduction is derived from the Hermite creation operators, so radial
coefficient integrals use the same normalized Gaussian basis as OriginLaguerre.
-/

open MeasureTheory MvPolynomial Grothe.LowerAnalytic Grothe.UpperChaos
open Set
open scoped ComplexConjugate InnerProductSpace

namespace Grothe.HJM

noncomputable section

/-- The radial factor of `H (n+1) n`, with real integer coefficients. -/
def originRadialPoly : ℕ → Polynomial ℝ
  | 0 => 1
  | n + 1 => (Polynomial.X - Polynomial.C (n + 2)) * originRadialPoly n -
      Polynomial.X * (originRadialPoly n).derivative

/-- The generalized Laguerre normalization of the radial Hermite polynomial. -/
def originLaguerrePoly (n : ℕ) : Polynomial ℝ :=
  Polynomial.C ((-1 : ℝ) ^ n / (n.factorial : ℝ)) * originRadialPoly n

/-- Exact sign and factorial conversion between the Hermite and Laguerre conventions. -/
theorem originLaguerrePoly_normalization (n : ℕ) :
    Polynomial.C ((-1 : ℝ) ^ n * (n.factorial : ℝ)) * originLaguerrePoly n =
      originRadialPoly n := by
  have hf : (n.factorial : ℝ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero n
  have hs : (-1 : ℝ) ^ n * (-1 : ℝ) ^ n = 1 := by rw [← mul_pow]; norm_num
  have hc : (-1 : ℝ) ^ n * (n.factorial : ℝ) *
      ((-1 : ℝ) ^ n / (n.factorial : ℝ)) = 1 := by
    calc
      _ = ((-1 : ℝ) ^ n * (-1 : ℝ) ^ n) *
          ((n.factorial : ℝ) / (n.factorial : ℝ)) := by ring
      _ = 1 := by rw [hs, div_self hf, mul_one]
  rw [originLaguerrePoly, ← mul_assoc, ← map_mul, hc, map_one, one_mul]

/-- The radial factor satisfies the Laguerre differential equation with parameter one. -/
theorem originRadialPoly_ode (n : ℕ) :
    Polynomial.X * (originRadialPoly n).derivative.derivative +
      (2 - Polynomial.X) * (originRadialPoly n).derivative +
      Polynomial.C (n : ℝ) * originRadialPoly n = 0 := by
  induction n with
  | zero => simp [originRadialPoly]
  | succ n ih =>
    have hd := congrArg Polynomial.derivative ih
    simp only [Polynomial.derivative_add, Polynomial.derivative_mul,
      Polynomial.derivative_sub, Polynomial.derivative_X, Polynomial.derivative_C,
      Polynomial.derivative_ofNat, Polynomial.derivative_zero, mul_zero, zero_mul, zero_add, add_zero,
      one_mul] at hd
    simp only [originRadialPoly, Polynomial.derivative_add, Polynomial.derivative_mul,
      Polynomial.derivative_sub, Polynomial.derivative_X, Polynomial.derivative_C,
      Polynomial.derivative_ofNat, Polynomial.derivative_zero, mul_zero, zero_mul, zero_add, add_zero,
      one_mul]
    push_cast at ih hd ⊢
    linear_combination (Polynomial.X - (n : Polynomial ℝ) - 3) * ih - Polynomial.X * hd

/-- Evaluation form of the polynomial ODE, for the radial integration-by-parts step. -/
theorem originRadialPoly_ode_eval (n : ℕ) (s : ℝ) :
    s * (originRadialPoly n).derivative.derivative.eval s +
      (2 - s) * (originRadialPoly n).derivative.eval s +
      (n : ℝ) * (originRadialPoly n).eval s = 0 := by
  have h := congrArg (Polynomial.eval s) (originRadialPoly_ode n)
  simpa using h

/-- Substitute `z*z̄` for the radial variable. -/
def originRadialLift : Polynomial ℝ →ₐ[ℝ] CPoly :=
  Polynomial.aeval (X 0 * X 1)

lemma pderiv0_originRadialLift (P : Polynomial ℝ) :
    pderiv 0 (originRadialLift P) = originRadialLift P.derivative * X 1 := by
  have h := ((pderiv (0 : Fin 2) : Derivation ℂ CPoly CPoly).restrictScalars ℝ).comp_aeval_eq
    (X 0 * X 1) P
  simpa [originRadialLift, Derivation.leibniz, pderiv_X, smul_eq_mul] using h

lemma originRadialLift_C (a : ℝ) : originRadialLift (Polynomial.C a) = C (a : ℂ) := by
  simp [originRadialLift, Polynomial.aeval_C,
    IsScalarTower.algebraMap_eq ℝ ℂ CPoly, algebraMap_eq]

lemma originRadialLift_X : originRadialLift Polynomial.X = X 0 * X 1 := by
  simp [originRadialLift]

private lemma H_charge_one_step (n : ℕ) :
    H (n + 2) (n + 1) = (X 0 * X 1) * H (n + 1) n -
      X 0 * pderiv 0 (H (n + 1) n) - (n + 1) • H (n + 1) n := by
  rw [show n + 2 = (n + 1) + 1 by omega, H_succ_left, A0, pderiv1_H_succ,
    ← A1_H, A1]
  ring

/-- The charge-one bivariate polynomial is exactly a one-variable radial polynomial. -/
theorem H_charge_one_radial (n : ℕ) :
    H (n + 1) n = X 0 * originRadialLift (originRadialPoly n) := by
  induction n with
  | zero => simp [H_succ_left, H_zero_zero, A0, originRadialPoly]
  | succ n ih =>
    rw [show n + 1 + 1 = n + 2 by omega, H_charge_one_step]
    simp only [ih, Derivation.leibniz, pderiv_X, pderiv0_originRadialLift]
    simp only [originRadialPoly, map_sub, map_mul, originRadialLift_X,
      originRadialLift_C, smul_eq_mul, nsmul_eq_mul]
    push_cast
    ring

lemma ev_originRadialLift (z : ℂ) (P : Polynomial ℝ) :
    ev z (originRadialLift P) = (P.eval (‖z‖ ^ 2) : ℂ) := by
  let e : CPoly →ₐ[ℝ] ℂ := (MvPolynomial.aeval (zv z)).restrictScalars ℝ
  have he : e (X 0 * X 1) = ((‖z‖ ^ 2 : ℝ) : ℂ) := by
    simp only [e, AlgHom.restrictScalars_apply, map_mul, MvPolynomial.aeval_X, zv,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
  have h := Polynomial.aeval_algHom_apply e (X 0 * X 1) P
  rw [he, Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval] at h
  exact h.symm

/-- Pointwise radial formula with no exception at the Gaussian origin. -/
theorem ev_H_charge_one_radial (n : ℕ) (z : ℂ) :
    ev z (H (n + 1) n) = z * (originRadialPoly n).eval (‖z‖ ^ 2) := by
  rw [H_charge_one_radial]
  change eval (zv z) (X 0 * originRadialLift (originRadialPoly n)) = _
  rw [map_mul, eval_X]
  change z * ev z (originRadialLift (originRadialPoly n)) = _
  rw [ev_originRadialLift]

/-- The actual normalized Hermite function in radial coordinates. -/
theorem hfun_charge_one_radial (n : ℕ) (z : ℂ) :
    hfun (n + 1, n) z = (nrm (n + 1) n : ℂ) * z *
      (originRadialPoly n).eval (‖z‖ ^ 2) := by
  rw [hfun, ev_H_charge_one_radial]
  ring


private lemma nrm_charge_one_factorial (n : ℕ) :
    nrm (n + 1) n * (n.factorial : ℝ) = 1 / Real.sqrt ((n : ℝ) + 1) := by
  have hf : (n.factorial : ℝ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero n
  have hs : Real.sqrt ((n : ℝ) + 1) ≠ 0 := by positivity
  have he : (((n + 1).factorial * n.factorial : ℕ) : ℝ) =
      ((n : ℝ) + 1) * (n.factorial : ℝ) ^ 2 := by
    rw [Nat.factorial_succ]
    push_cast
    ring
  rw [nrm, he, Real.sqrt_mul (by positivity), Real.sqrt_sq (by positivity)]
  field_simp [hf, hs] <;> ring

/-- The normalized Laguerre formula, including the upstream alternating sign. -/
theorem hfun_charge_one_laguerre (n : ℕ) (z : ℂ) :
    hfun (n + 1, n) z =
      (((-1 : ℝ) ^ n / Real.sqrt ((n : ℝ) + 1) : ℝ) : ℂ) * z *
        (originLaguerrePoly n).eval (‖z‖ ^ 2) := by
  rw [hfun_charge_one_radial, ← originLaguerrePoly_normalization n]
  simp only [Polynomial.eval_mul, Polynomial.eval_C]
  calc
    _ = (((-1 : ℝ) ^ n * (nrm (n + 1) n * (n.factorial : ℝ)) : ℝ) : ℂ) *
        z * (originLaguerrePoly n).eval (‖z‖ ^ 2) := by push_cast; ring
    _ = _ := by rw [nrm_charge_one_factorial]; simp only [mul_one_div]

/-- Complex radial Gaussian integration, with both ordinary integrability obligations explicit. -/
theorem integral_gaussC_radial_complex (f : ℝ → ℂ) (hf : Measurable f)
    (hG : Integrable (fun z : ℂ => f ‖z‖) gaussC)
    (hR : IntegrableOn (fun r : ℝ => ((r * Real.exp (-r ^ 2) : ℝ) : ℂ) * f r) (Ioi 0)) :
    ∫ z, f ‖z‖ ∂gaussC = (2 : ℂ) *
      ∫ r in Ioi (0 : ℝ), ((r * Real.exp (-r ^ 2) : ℝ) : ℂ) * f r := by
  apply Complex.ext
  · have hg := integral_re hG
    have hr := integral_re hR
    have h := integral_gaussC_radial (fun r => (f r).re) (Complex.measurable_re.comp hf)
    simp only [RCLike.re_to_complex, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, sub_zero] at hg hr
    rw [← hg, h, hr]
    simp
  · have hg := integral_im hG
    have hr := integral_im hR
    have h := integral_gaussC_radial (fun r => (f r).im) (Complex.measurable_im.comp hf)
    simp only [RCLike.im_to_complex, Complex.mul_im, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, add_zero] at hg hr
    rw [← hg, h, hr]
    simp

private lemma integrable_gaussC_radial_polynomial (P : Polynomial ℝ) :
    Integrable (fun z : ℂ => ‖z‖ * P.eval (‖z‖ ^ 2)) gaussC := by
  induction P using Polynomial.induction_on' with
  | monomial n a =>
    convert (integrable_norm_pow (2 * n + 1)).const_mul a using 1
    funext z
    simp only [Polynomial.eval_monomial, ← pow_mul, pow_add, pow_one]
    ring
  | add P Q hP hQ =>
    simpa only [Polynomial.eval_add, mul_add] using hP.add hQ

private lemma integrable_radial_polynomial (P : Polynomial ℝ) :
    IntegrableOn (fun r : ℝ => r ^ 2 * Real.exp (-r ^ 2) * P.eval (r ^ 2)) (Ioi 0) := by
  induction P using Polynomial.induction_on' with
  | monomial n a =>
    have h := integrableOn_rpow_mul_exp_neg_mul_sq (b := 1) one_pos
      (s := ((2 * n + 2 : ℕ) : ℝ)) (by positivity)
    have hi : IntegrableOn (fun r : ℝ => r ^ (2 * n + 2) * Real.exp (-r ^ 2)) (Ioi 0) := by
      simpa only [Real.rpow_natCast, neg_mul, one_mul] using h
    convert hi.const_mul a using 1
    funext r
    simp only [Polynomial.eval_monomial, ← pow_mul, pow_add, pow_one]
    ring
  | add P Q hP hQ =>
    simpa only [Polynomial.eval_add, mul_add] using hP.add hQ

/-- The radial polynomial formula for possibly unbounded responses.
These are ordinary integrability premises, permitting the polynomial-growth
number-operator image used in the energy estimate. -/
theorem integral_gaussC_radial_polynomial_mul_of_integrable
    (P : Polynomial ℝ) (v : ℝ → ℂ) (hv : Measurable v)
    (hG : Integrable (fun z : ℂ =>
      ((‖z‖ * P.eval (‖z‖ ^ 2) : ℝ) : ℂ) * v (‖z‖ ^ 2)) gaussC)
    (hR : IntegrableOn (fun r : ℝ =>
      ((r ^ 2 * Real.exp (-r ^ 2) * P.eval (r ^ 2) : ℝ) : ℂ) * v (r ^ 2)) (Ioi 0)) :
    ∫ z : ℂ, ((‖z‖ * P.eval (‖z‖ ^ 2) : ℝ) : ℂ) * v (‖z‖ ^ 2) ∂gaussC =
      (2 : ℂ) * ∫ r in Ioi (0 : ℝ),
        ((r ^ 2 * Real.exp (-r ^ 2) * P.eval (r ^ 2) : ℝ) : ℂ) * v (r ^ 2) := by
  have he (r : ℝ) : ((r * Real.exp (-r ^ 2) : ℝ) : ℂ) *
      (((r * P.eval (r ^ 2) : ℝ) : ℂ) * v (r ^ 2)) =
      ((r ^ 2 * Real.exp (-r ^ 2) * P.eval (r ^ 2) : ℝ) : ℂ) * v (r ^ 2) := by
    push_cast
    ring
  have h := integral_gaussC_radial_complex
    (fun r => (((r * P.eval (r ^ 2) : ℝ) : ℂ) * v (r ^ 2)))
    (by fun_prop) hG (by simpa only [he] using hR)
  simpa only [he] using h

/-- Integrating a radial polynomial against any bounded measurable radial response.
The result is an ordinary one-dimensional Gaussian integral, suitable for exact quadrature. -/
theorem integral_gaussC_radial_polynomial_mul (P : Polynomial ℝ) (v : ℝ → ℂ)
    (hv : Measurable v) {M : ℝ} (hbound : ∀ s, ‖v s‖ ≤ M) :
    ∫ z : ℂ, ((‖z‖ * P.eval (‖z‖ ^ 2) : ℝ) : ℂ) * v (‖z‖ ^ 2) ∂gaussC =
      (2 : ℂ) * ∫ r in Ioi (0 : ℝ),
        ((r ^ 2 * Real.exp (-r ^ 2) * P.eval (r ^ 2) : ℝ) : ℂ) * v (r ^ 2) := by
  have hG := (integrable_gaussC_radial_polynomial P).ofReal.mul_bdd
    (hv.comp (by fun_prop : Measurable fun z : ℂ => ‖z‖ ^ 2)).aestronglyMeasurable
    (Filter.Eventually.of_forall fun z => hbound (‖z‖ ^ 2))
  have hR := (integrable_radial_polynomial P).ofReal.mul_bdd
    (hv.comp (by fun_prop : Measurable fun r : ℝ => r ^ 2)).aestronglyMeasurable
    (Filter.Eventually.of_forall fun r => hbound (r ^ 2))
  exact integral_gaussC_radial_polynomial_mul_of_integrable P v hv hG hR

private lemma hfun_phase_radial (n : ℕ) (z v : ℂ) :
    conj (hfun (n + 1, n) z) * (Grothe.Haag.ph z * v) =
      (nrm (n + 1) n : ℂ) *
        ((((‖z‖ * (originRadialPoly n).eval (‖z‖ ^ 2)) : ℝ) : ℂ) * v) := by
  have hp : conj z * Grothe.Haag.ph z = (‖z‖ : ℂ) := by
    simpa [Grothe.Haag.ph] using conj_monomial_mul_div_norm 0 z
  rw [hfun_charge_one_radial]
  simp only [map_mul, Complex.conj_ofReal]
  calc
    _ = (nrm (n + 1) n : ℂ) * (conj z * Grothe.Haag.ph z) *
        (originRadialPoly n).eval (‖z‖ ^ 2) * v := by ring
    _ = _ := by rw [hp]; push_cast; ring

/-- The actual coefficient integral for an unbounded, square-integrable radial response. -/
theorem inner_charge_one_radial_integral_of_integrable (n : ℕ) (v : ℝ → ℂ)
    (hv : Measurable v)
    (hG : Integrable (fun z : ℂ =>
      ((‖z‖ * (originRadialPoly n).eval (‖z‖ ^ 2) : ℝ) : ℂ) * v (‖z‖ ^ 2)) gaussC)
    (hR : IntegrableOn (fun r : ℝ =>
      ((r ^ 2 * Real.exp (-r ^ 2) * (originRadialPoly n).eval (r ^ 2) : ℝ) : ℂ) *
        v (r ^ 2)) (Ioi 0))
    (hF : MemLp (fun z : ℂ => Grothe.Haag.ph z * v (‖z‖ ^ 2)) 2 gaussC) :
    ⟪hvec (n + 1, n), hF.toLp (fun z : ℂ => Grothe.Haag.ph z * v (‖z‖ ^ 2))⟫_ℂ =
      ((2 * nrm (n + 1) n : ℝ) : ℂ) * ∫ r in Ioi (0 : ℝ),
        ((r ^ 2 * Real.exp (-r ^ 2) * (originRadialPoly n).eval (r ^ 2) : ℝ) : ℂ) *
          v (r ^ 2) := by
  rw [hvec, inner_toLp]
  simp_rw [hfun_phase_radial]
  rw [integral_const_mul, integral_gaussC_radial_polynomial_mul_of_integrable _ _ hv hG hR]
  push_cast
  ring

/-- The actual normalized charge-one coefficient of a bounded radial response.
The factor `R_n=(-1)^n n! L_n^(1)` preserves the pinned upstream Hermite convention. -/
theorem inner_charge_one_radial_integral (n : ℕ) (v : ℝ → ℂ)
    (hv : Measurable v) {M : ℝ} (hbound : ∀ s, ‖v s‖ ≤ M)
    (hF : MemLp (fun z : ℂ => Grothe.Haag.ph z * v (‖z‖ ^ 2)) 2 gaussC) :
    ⟪hvec (n + 1, n), hF.toLp (fun z : ℂ => Grothe.Haag.ph z * v (‖z‖ ^ 2))⟫_ℂ =
      ((2 * nrm (n + 1) n : ℝ) : ℂ) * ∫ r in Ioi (0 : ℝ),
        ((r ^ 2 * Real.exp (-r ^ 2) * (originRadialPoly n).eval (r ^ 2) : ℝ) : ℂ) *
          v (r ^ 2) := by
  rw [hvec, inner_toLp]
  simp_rw [hfun_phase_radial]
  rw [integral_const_mul, integral_gaussC_radial_polynomial_mul _ _ hv hbound]
  push_cast
  ring

end

end Grothe.HJM
