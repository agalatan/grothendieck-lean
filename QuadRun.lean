import GrotheQuadKernel

/-!
# `quadrun`: the batch driver of the quadrature checker (milestone 2 of issue #303)

A native executable (`lake build quadrun`, `.lake/build/bin/quadrun`) over the precompiled
library `GrotheQuadKernel`.  It runs the node loop of the committed partition
(`data/quad-checker/panels.txt`: the 1,289 panels of `Q0GaussAddress.sourcePanels`;
`handoff/quad-checker/rules.txt`: the 64 Gauss–Legendre bracket rules of `Q0LegendreRule01…64`,
regenerated by `tools/quad_gen_partition.py`; `cutoffs.txt`: the per-node conditional
cutoffs of `conditional_cutoffs.npy`; `profile.txt`: `profileQ`, `aQ` of `Grothe/Upper/Data.lean`)
and the contraction into the raw coefficients, in shards:

    quadrun rules                       check every rule's brackets (sign changes, disjoint)
    quadrun node <ordinal> [P]          one node, diagnostics only
    quadrun shard <i> <n> <outdir>      nodes ≡ i (mod n): raw-<i>.txt (lo hi at 2^128), nodes-<i>.txt
    quadrun merge <n> <outdir>          sum the shards into raw-final.txt
    quadrun smat <i> <n> <dir>          the saved smoothing matrices S_k, k ≡ i (mod n), exactly
    quadrun rotate <i> <n> <smatdir> <raw> <frozen> <dir>   energies of the grades q ≡ i (mod n)

Diagnostics only: no theorem, no native fact.  Agent-ID: claude-b9ee. Refs #303, #21.
-/

open GrotheQuad

/-- The data folder (relative to the working directory). -/
def dataDir : String := "data/quad-checker"

def parseInt! (s : String) : Int := (s.toInt?).getD 0
def parseNat! (s : String) : Nat := (s.toNat?).getD 0

/-- Parse `rules.txt`: the brackets of the rules of orders `1 … 64` (index = order). -/
def readRules (path : String) : IO (Array (Array Bracket)) := do
  let lines ← IO.FS.lines path
  let mut rules : Array (Array Bracket) := Array.replicate 65 #[]
  let mut cur : Nat := 0
  for line in lines do
    match (line.splitOn " ").filter (· ≠ "") with
    | ["rule", n] => cur := parseNat! n
    | ["bracket", lo, hi] =>
      rules := rules.set! cur ((rules.getD cur #[]).push ⟨parseInt! lo, parseInt! hi, 640⟩)
    | _ => pure ()
  return rules

/-- Parse `panels.txt` and attach the brackets of each panel's rule. -/
def readPanels (path : String) (rules : Array (Array Bracket)) : IO (Array Panel) := do
  let lines ← IO.FS.lines path
  let mut panels : Array Panel := #[]
  for line in lines do
    match (line.splitOn " ").filter (· ≠ "") with
    | ["panel", _idx, loN, loD, hiN, hiD, order, _offset] =>
      let n := parseNat! order
      panels := panels.push ⟨parseInt! loN, parseNat! loD, parseInt! hiN, parseNat! hiD, n, rules.getD n #[]⟩
    | _ => pure ()
  return panels

/-- Parse `cutoffs.txt` (`ordinal cutoff` per line). -/
def readCutoffs (path : String) : IO (Array Nat) := do
  let lines ← IO.FS.lines path
  let mut out : Array Nat := #[]
  for line in lines do
    match (line.splitOn " ").filter (· ≠ "") with
    | [_, c] => out := out.push (parseNat! c)
    | _ => pure ()
  return out

/-- Parse `profile.txt` (`coeff num den` lines and one `a num den` line). -/
def readProfile (path : String) : IO ProfileData := do
  let lines ← IO.FS.lines path
  let mut cs : Array (Int × Nat) := #[]
  let mut aN : Int := 0
  let mut aD : Nat := 1
  for line in lines do
    match (line.splitOn " ").filter (· ≠ "") with
    | ["coeff", n, d] => cs := cs.push (parseInt! n, parseNat! d)
    | ["a", n, d] => aN := parseInt! n; aD := parseNat! d
    | _ => pure ()
  return ⟨cs, aN, aD⟩

/-- The (panel, rule) address of every ordinal. -/
def addresses (panels : Array Panel) : Array (Nat × Nat) := Id.run do
  let mut out : Array (Nat × Nat) := #[]
  for pi in [0:panels.size] do
    for r in [0:(panels.getD pi default).order] do
      out := out.push (pi, r)
  return out

structure NodeResult where
  ordinal : Nat
  panel : Nat
  rule : Nat
  s : Ival
  w : Ival
  v : Ival
  neg : Bool
  a : Ival
  x : Ival
  cutoff : Nat
  prec : Nat
  vals : Array Ival
  maxWidth : Int
  bessel : Ival
  ms : Nat

/-- The widest canonical enclosure accepted (log₂). -/
def widthThreshold : Int := -80

def precisions : List Nat := [512, 1024, 2048, 4096]

/-- One node: the coefficients of its canonical prefix at the first precision whose widths are
below the threshold. -/
def runNode (panels : Array Panel) (addrs : Array (Nat × Nat)) (cutoffs : Array Nat)
    (pd : ProfileData) (ordinal : Nat) (precs : List Nat) (verbose : Bool := false) :
    IO NodeResult := do
  let t0 ← IO.monoMsNow
  let (pi, r) := addrs.getD ordinal (0, 0)
  let p := panels.getD pi default
  let D := min (cutoffs.getD ordinal 532) 531
  let mut best : Option NodeResult := none
  for P in precs do
    let piI := piMachinI P (P / 3 + 20)
    let b := p.brackets.getD r default
    let loI := ratI P p.loN p.loD
    let half := divN P 2 (subI P (ratI P p.hiN p.hiD) loI)
    let s := addI P loI (mulI P half (addI P (ofInt P 1) b.toIval))
    let w := mulI P half (weightI P p.order b.toIval)
    match profileShiftI P piI pd s with
    | none => throw (IO.userError s!"node {ordinal}: profile sign undecided")
    | some (v, neg, a) =>
      let x := sqI P a
      let scalar := seedScalarI P piI a
      let ratios := ratiosI P x (D + 2000)
      if verbose then IO.println s!"  seed+ratios: {ratios.size} ratios, scalar {toDecimal 12 scalar}"
      let tA ← IO.monoMsNow
      let vals := canonicalTriangleI P scalar neg zeroI a (sqrtTable P (D + 1)) ratios D 265
      let mw := maxWidthLog2 vals
      if verbose then IO.println s!"  triangle: {vals.size} pairs, max width 2^{mw}"
      let tB ← IO.monoMsNow
      if verbose then IO.println s!"  timing: seed+ratios {tA - t0} ms, triangle {tB - tA} ms"
      let bes := sumSqUpper P vals
      let t1 ← IO.monoMsNow
      let res : NodeResult := ⟨ordinal, pi, r, s, w, v, neg, a, x, D, P, vals, mw, bes, t1 - t0⟩
      best := some res
      if mw ≤ widthThreshold then return res
  match best with
  | some res => return res
  | none => throw (IO.userError "no precision")

def summaryLine (n : NodeResult) : String :=
  s!"{n.ordinal} {n.panel} {n.rule} {toDecimal 12 n.s} {sciString n.v} {if n.neg then 1 else 0} " ++
  s!"{sciString n.a} {sciString n.x} {n.cutoff} {n.prec} {n.vals.size} {n.maxWidth} {toDecimal 16 n.bessel} {n.ms}"

def loadAll : IO (Array Panel × Array (Nat × Nat) × Array Nat × ProfileData) := do
  let rules ← readRules "handoff/quad-checker/rules.txt"
  let panels ← readPanels s!"{dataDir}/panels.txt" rules
  let cutoffs ← readCutoffs s!"{dataDir}/cutoffs.txt"
  let pd ← readProfile s!"{dataDir}/profile.txt"
  let addrs := addresses panels
  IO.println s!"partition: {panels.size} panels, {addrs.size} nodes, {cutoffs.size} cutoffs, profile {pd.coeffs.size} coefficients"
  return (panels, addrs, cutoffs, pd)

def cmdRules : IO UInt32 := do
  let (panels, _, _, _) ← loadAll
  let mut seen : Array Bool := Array.replicate 65 false
  let mut ok := true
  for p in panels do
    if seen.getD p.order false then continue
    seen := seen.set! p.order true
    let good := ruleOK 1024 p.order p.brackets
    IO.println s!"rule {p.order}: {if good then "OK" else "FAIL"}"
    ok := ok && good
  IO.println s!"all rules: {if ok then "OK" else "FAIL"}"
  return (if ok then 0 else 1)

def cmdNode (ordinal : Nat) (precs : List Nat) : IO UInt32 := do
  let (panels, addrs, cutoffs, pd) ← loadAll
  let n ← runNode panels addrs cutoffs pd ordinal precs (verbose := true)
  IO.println (summaryLine n)
  IO.println s!"s = {toDecimal 30 n.s}\nw = {toDecimal 30 n.w}\nv = {toDecimal 30 n.v}\nA = {toDecimal 30 n.a}\nx = {toDecimal 20 n.x}"
  for i in [0:min 8 n.vals.size] do
    IO.println s!"  I[{i}] = {toDecimal 30 (n.vals.getD i zeroI)}  width 2^{widthLog2 (n.vals.getD i zeroI)}"
  -- per-band widths
  let pairs := canonicalPairs n.cutoff 265
  let mut bandMax : Array Int := Array.replicate 11 (-100000)
  for i in [0:pairs.size] do
    let b := ((pairs.getD i (0, 0)).1 + (pairs.getD i (0, 0)).2) / 50
    bandMax := bandMax.set! b (max (bandMax.getD b 0) (widthLog2 (n.vals.getD i zeroI)))
  for b in [0:11] do
    if bandMax.getD b 0 > -100000 then
      IO.println s!"  max width for c+d in [{50*b},{50*b+49}]: 2^{bandMax.getD b 0}"
  let t0 ← IO.monoMsNow
  let factors := nodeFactors 1024 n.s n.w 0 251
  -- a checksum over every entry forces the whole computation before the next timer
  let checksum := factors.foldl (fun s row => row.foldl (fun s f => s + f.lo + f.hi) s) (0 : Int)
  IO.println s!"node factors: F[0][0] = {factors.getD 0 #[] |>.getD 0 default |>.lo} (scale 2^128); checksum {checksum % 1000000007}; valid {nodeFactorsValid 1024 n.s}"
  let t1 ← IO.monoMsNow
  IO.println s!"node factors: {t1 - t0} ms"
  let acc := accumulateNode n.cutoff (n.vals.map toFx) factors 0 251 rawZero
  let cs2 := acc.foldl (fun s blk => blk.foldl (fun s row => row.foldl (fun s p => s + p.1 + p.2) s) s) (0 : Int)
  IO.println s!"accumulate: checksum {cs2 % 1000000007}; entry 0 = [{(rawGet acc 0 0 0).1}, {(rawGet acc 0 0 0).2}] (scale 2^256); entry 63001 = {(rawGet acc 1 0 0).1}"
  let t2 ← IO.monoMsNow
  IO.println s!"accumulate: {t2 - t1} ms"
  return 0

/-- Write an accumulator in the flat committed layout (`lo hi` per line at scale `2^128`). -/
def writeRawFlat (h : IO.FS.Handle) (acc : Raw) : IO Unit := do
  for k in [0:numCharges] do
    for j in [0:blockSide k] do
      for c in [0:blockSide k] do
        let (lo, hi) := rawGet acc k j c
        h.putStrLn s!"{shDown 128 lo} {shUp 128 hi}"

/-- An accumulator (scale `2^256`) from the flat layout at scale `2^128` (exact). -/
def rawOfFlat (lo hi : Array Int) : Raw :=
  Array.ofFn fun k : Fin numCharges =>
    Array.ofFn fun j : Fin (blockSide k.val) =>
      Array.ofFn fun c : Fin (blockSide k.val) =>
        (lo.getD (blockOffset k.val + j.val * blockSide k.val + c.val) 0 * pow2 128,
          hi.getD (blockOffset k.val + j.val * blockSide k.val + c.val) 0 * pow2 128)

def cmdShard (i n : Nat) (outdir : String) : IO UInt32 := do
  let (panels, addrs, cutoffs, pd) ← loadAll
  IO.FS.createDirAll outdir
  let hn ← IO.FS.Handle.mk s!"{outdir}/nodes-{i}.txt" IO.FS.Mode.write
  let mut acc := rawZero
  let mut count := 0
  let tStart ← IO.monoMsNow
  let mut ordinal := i
  while ordinal < addrs.size do
    let r ← runNode panels addrs cutoffs pd ordinal precisions
    let t0 ← IO.monoMsNow
    let factors := nodeFactors 1024 r.s r.w 0 251
    if !nodeFactorsValid 1024 r.s then throw (IO.userError s!"node {ordinal}: node factors invalid")
    acc := accumulateNode r.cutoff (r.vals.map toFx) factors 0 251 acc
    let t1 ← IO.monoMsNow
    hn.putStrLn (summaryLine r ++ s!" {t1 - t0}")
    hn.flush
    count := count + 1
    if count % 50 == 0 then
      let now ← IO.monoMsNow
      IO.println s!"shard {i}: {count} nodes, {(now - tStart) / 1000} s"
    ordinal := ordinal + n
  let hr ← IO.FS.Handle.mk s!"{outdir}/raw-{i}.txt" IO.FS.Mode.write
  writeRawFlat hr acc
  hr.flush
  let tEnd ← IO.monoMsNow
  IO.println s!"shard {i}: done, {count} nodes, {(tEnd - tStart) / 1000} s"
  return 0

def cmdMerge (n : Nat) (outdir : String) : IO UInt32 := do
  let mut lo := Array.replicate rawSize (0 : Int)
  let mut hi := Array.replicate rawSize (0 : Int)
  for i in [0:n] do
    let lines ← IO.FS.lines s!"{outdir}/raw-{i}.txt"
    if lines.size != rawSize then throw (IO.userError s!"raw-{i}.txt has {lines.size} lines")
    for idx in [0:rawSize] do
      match ((lines.getD idx "").splitOn " ") with
      | [a, b] =>
        lo := lo.set! idx (lo.getD idx 0 + parseInt! a)
        hi := hi.set! idx (hi.getD idx 0 + parseInt! b)
      | _ => throw (IO.userError s!"raw-{i}.txt line {idx} malformed")
    IO.println s!"merged shard {i}"
  let hr ← IO.FS.Handle.mk s!"{outdir}/raw-final.txt" IO.FS.Mode.write
  let mut maxW : Int := 0
  for idx in [0:rawSize] do
    hr.putStrLn s!"{lo.getD idx 0} {hi.getD idx 0}"
    maxW := max maxW (hi.getD idx 0 - lo.getD idx 0)
  hr.flush
  IO.println s!"raw-final.txt written: {rawSize} entries, max width {maxW} / 2^128"
  return 0


/-! ### Milestone 3: saved matrices, rotation, energies -/

/-- `quadrun smat <i> <n> <outdir>`: the saved matrices `S_k` for `k ≡ i (mod n)`, `k ≤ 251`,
as numerators over `S = 10^22`, one per line, row-major, in `outdir/smat-<k>.txt`. -/
def cmdSmat (i n : Nat) (outdir : String) : IO UInt32 := do
  IO.FS.createDirAll outdir
  let mut k := i
  while k ≤ 251 do
    let t0 ← IO.monoMsNow
    let nums := savedMatrixNums k
    let h ← IO.FS.Handle.mk s!"{outdir}/smat-{k}.txt" IO.FS.Mode.write
    for row in nums do
      for v in row do
        h.putStrLn (toString v)
    h.flush
    let t1 ← IO.monoMsNow
    IO.println s!"S_{k}: {nums.size}x{nums.size} entries, {t1 - t0} ms; S_{k}[0][0] = {(nums.getD 0 #[]).getD 0 0} / 10^22"
    k := k + n
  return 0

/-- Read a saved matrix file (`(n+1)²` numerators, row-major) as a nested matrix of fixed intervals. -/
def readSmat (path : String) (n : Nat) : IO (Array (Array Fx)) := do
  let lines ← IO.FS.lines path
  let flat := lines.filterMap fun l => if l.isEmpty then none else some (savedToFx (parseNat! l))
  if flat.size != (n + 1) * (n + 1) then throw (IO.userError s!"{path}: {flat.size} entries, expected {(n + 1) * (n + 1)}")
  return Array.ofFn fun c : Fin (n + 1) => Array.ofFn fun e : Fin (n + 1) => flat.getD (c.val * (n + 1) + e.val) default

/-- Read `raw-final.txt` (lines `lo hi` at scale `2^128`). -/
def readRaw (path : String) : IO (Array Int × Array Int) := do
  let lines ← IO.FS.lines path
  let mut lo : Array Int := Array.mkEmpty lines.size
  let mut hi : Array Int := Array.mkEmpty lines.size
  for l in lines do
    match l.splitOn " " with
    | [a, b] => lo := lo.push (parseInt! a); hi := hi.push (parseInt! b)
    | _ => pure ()
  return (lo, hi)

/-- Read `frozen.txt` (lines `q c d m e`, value `m·2^{-e}`) into a lookup by `gradedFlatIndex`. -/
def readFrozen (path : String) : IO (Array (Option Fx)) := do
  let lines ← IO.FS.lines path
  let size := 91 * 92 * 93 / 3
  let mut out : Array (Option Fx) := Array.replicate size none
  for l in lines do
    match (l.splitOn " ").filter (· ≠ "") with
    | [q, c, d, m, e] =>
      let q := parseNat! q; let c := parseNat! c; let d := parseNat! d
      let m := parseInt! m; let e := parseNat! e
      let idx := q * (q + 1) * (q + 2) / 3 + c * (q + 1) + d
      -- m·2^{-e} at scale 2^128: exact if e ≤ 128, else outward
      let v : Fx := if e ≤ 128 then ⟨m * pow2 (128 - e), m * pow2 (128 - e)⟩
        else ⟨shDown (e - 128) m, shUp (e - 128) m⟩
      out := out.set! idx (some v)
    | _ => pure ()
  return out

def frozenLookup (tbl : Array (Option Fx)) (q c d : Nat) : Fx :=
  if q < 91 then (tbl.getD (q * (q + 1) * (q + 2) / 3 + c * (q + 1) + d) none).getD ⟨0, 0⟩ else ⟨0, 0⟩

/-- `quadrun rotate <i> <n> <smatdir> <rawfile> <frozenfile> <outdir>`: the energies of the
grades `q ≡ i (mod n)`, `q ≤ 250`, lines `q n m lo hi` at scale `2^256` in `outdir/energy-<i>.txt`. -/
def cmdRotate (i n : Nat) (smatdir rawfile frozenfile outdir : String) : IO UInt32 := do
  IO.FS.createDirAll outdir
  let t0 ← IO.monoMsNow
  let (rawLo, rawHi) ← readRaw rawfile
  if rawLo.size != rawSize then throw (IO.userError s!"raw file has {rawLo.size} entries")
  let raw := rawOfFlat rawLo rawHi
  let frozenTbl ← readFrozen frozenfile
  let t1 ← IO.monoMsNow
  IO.println s!"rotate shard {i}: inputs read in {t1 - t0} ms"
  let h ← IO.FS.Handle.mk s!"{outdir}/energy-{i}.txt" IO.FS.Mode.write
  let mut q := i
  while q ≤ 250 do
    let tq ← IO.monoMsNow
    let S1 ← readSmat s!"{smatdir}/smat-{q + 1}.txt" (q + 1)
    let S0 ← readSmat s!"{smatdir}/smat-{q}.txt" q
    let es := rotateGrade raw (frozenLookup frozenTbl) S1 S0 q
    for m in [0:es.size] do
      let (lo, hi) := es.getD m (0, 0)
      h.putStrLn s!"{q} {2 * q + 1 - m} {m} {lo} {hi}"
    h.flush
    let tq1 ← IO.monoMsNow
    IO.println s!"grade {q}: {es.size} bidegrees, {tq1 - tq} ms"
    q := q + n
  return 0

/-- The `NodeSpec` of an ordinal (panel, rule bracket, cutoff), as the facts define it. -/
def specOf (panels : Array Panel) (addrs : Array (Nat × Nat)) (cutoffs : Array Nat) (ordinal : Nat) :
    NodeSpec :=
  let (pi, r) := addrs.getD ordinal (0, 0)
  let p := panels.getD pi default
  ⟨p.loN, p.loD, p.hiN, p.hiD, p.order, p.brackets.getD r default, min (cutoffs.getD ordinal 532) 531⟩

/-- `quadrun block <qLo> <qHi> <n> [P]`: the node loop of the first `n` nodes restricted to the grade
block `[qLo, qHi)` (`accumulateSpecs`, the kernel function the facts evaluate), timed. -/
def cmdBlock (qLo qHi n P : Nat) : IO UInt32 := do
  let (panels, addrs, cutoffs, pd) ← loadAll
  let piI := piMachinI P (P / 3 + 20)
  let specs := (List.range (min n addrs.size)).map (specOf panels addrs cutoffs)
  let t0 ← IO.monoMsNow
  let res := accumulateSpecs P piI pd qLo qHi specs rawZero
  match res with
  | none => throw (IO.userError "block: a node was rejected (a flag failed)")
  | some acc =>
    let cs := acc.foldl (fun s blk => blk.foldl (fun s row => row.foldl (fun s p => s + p.1 + p.2) s) s) (0 : Int)
    let t1 ← IO.monoMsNow
    IO.println s!"block [{qLo},{qHi}) over {specs.length} nodes at P = {P}: {t1 - t0} ms ({(t1 - t0) / specs.length} ms per node); checksum {cs % 1000000007}"
  return 0

/-- Read `energy-table.txt` (`n m num den`) into a `502 × 502` table of enclosures at scale `2^256`
(`⌊num·2^256/den⌋, ⌈…⌉`; `(0, 0)` for the absent bidegrees). -/
def readTable (path : String) : IO (Array (Array (Int × Int))) := do
  let lines ← IO.FS.lines path
  let mut tbl : Array (Array (Int × Int)) := Array.replicate 502 (Array.replicate 502 ((0 : Int), (0 : Int)))
  for l in lines do
    match (l.splitOn " ").filter (· ≠ "") with
    | [n, m, num, den] =>
      let n := parseNat! n; let m := parseNat! m
      let num := parseInt! num; let den := parseInt! den
      if n < 502 && m < 502 && den > 0 then
        let v := (fdiv (num * pow2 (2 * KFix)) den, cdiv (num * pow2 (2 * KFix)) den)
        tbl := tbl.set! n ((tbl.getD n #[]).set! m v)
    | _ => pure ()
  return tbl

/-- `quadrun check <rawfile> <frozenfile> <tablefile> <qLo> <qHi>`: the block checks of the facts
(`blockExcursion` and `gradeWidthSqBlock`, scale `2^256`) on a stored raw vector, for validation
against the milestone-3 comparison; also `evenExcursion`. -/
def cmdCheck (rawfile frozenfile tablefile : String) (qLo qHi : Nat) : IO UInt32 := do
  let t0 ← IO.monoMsNow
  let (rawLo, rawHi) ← readRaw rawfile
  if rawLo.size != rawSize then throw (IO.userError s!"raw file has {rawLo.size} entries")
  let raw := rawOfFlat rawLo rawHi
  let frozenTbl ← readFrozen frozenfile
  let tbl ← readTable tablefile
  let table := fun n m => (tbl.getD n #[]).getD m (0, 0)
  let t1 ← IO.monoMsNow
  IO.println s!"check: inputs read in {t1 - t0} ms"
  let smats := savedMatricesRange qLo qHi
  let t2 ← IO.monoMsNow
  IO.println s!"saved matrices S_{qLo}..S_{qHi}: {t2 - t1} ms"
  let en := blockEnergies raw (frozenLookup frozenTbl) smats qLo qHi
  let ex := blockExcursion en table qLo qHi
  let t3 ← IO.monoMsNow
  IO.println s!"block [{qLo},{qHi}): excursion {ex} / 2^256 = {toDecimal 20 (ofFixed (2 * KFix) ex ex)} ({t3 - t2} ms)"
  let w := gradeWidthSqBlock raw (frozenLookup frozenTbl) qLo qHi
  let t4 ← IO.monoMsNow
  IO.println s!"block [{qLo},{qHi}): width-sq {w} / 2^256 = {toDecimal 20 (ofFixed (2 * KFix) w w)} ({t4 - t3} ms)"
  let ev := evenExcursion table
  IO.println s!"even excursion {ev} / 2^256"
  return 0


/-! ### The twisted node loop (docs/UPPER_CLOSURE.md §8): `quadrun twist*` -/

/-- Read `phase.txt` (`i j k num den` per line). -/
def readPhase (path : String) : IO (Array PhaseTerm) := do
  let lines ← IO.FS.lines path
  let mut out : Array PhaseTerm := #[]
  for l in lines do
    match (l.splitOn " ").filter (· ≠ "") with
    | [i, j, k, num, den] =>
      if i.startsWith "#" then pure () else
      out := out.push ⟨parseNat! i, parseNat! j, parseNat! k, parseInt! num, parseNat! den⟩
    | _ => pure ()
  return out

/-- Read `center-j.txt` (`q c d m e`, value `m·2^{−e}`) into the flat graded array of numerators at the
common exponent `E` (`e ≤ E`). -/
def readCenter (path : String) (Q E : Nat) : IO (Array Int) := do
  let lines ← IO.FS.lines path
  let mut out : Array Int := Array.replicate (Q * (Q + 1) * (Q + 2) / 3) 0
  for l in lines do
    match (l.splitOn " ").filter (· ≠ "") with
    | [q, c, d, m, e] =>
      let q := parseNat! q; let c := parseNat! c; let d := parseNat! d
      let m := parseInt! m; let e := parseNat! e
      if e > E then throw (IO.userError s!"{path}: exponent {e} > {E}")
      if q < Q then out := out.set! (gradedFlat q c d) (m * pow2 (E - e))
    | _ => pure ()
  return out

/-- The per-process tables of the power `j`. -/
def loadTwist (j P : Nat) : IO (TwistParams × TwistTables) := do
  let prm := twistParams j
  let terms ← readPhase s!"{dataDir}/phase.txt"
  let center ← readCenter s!"handoff/quad-checker/center-{j}.txt" prm.Q prm.E
  let t0 ← IO.monoMsNow
  let tabs := twistTables P prm terms center
  let cs := tabs.dil.foldl (fun s lv => lv.foldl (fun s row => row.foldl (fun s f => s + f.lo + f.hi) s) s) (0 : Int)
  let t1 ← IO.monoMsNow
  IO.println s!"twist j={j}: {terms.size} phase terms, center {center.size} entries (E = {prm.E}), D_in = {twistDin prm}; tables {t1 - t0} ms (dilation checksum {cs % 1000000007})"
  return (prm, tabs)

/-- `quadrun twistnode <j> <ordinal> [P]`: one node, timed by phase; the low-band `J_{c,d}(s)`. -/
def cmdTwistNode (j ordinal P : Nat) : IO UInt32 := do
  let (panels, addrs, cutoffs, pd) ← loadAll
  let (prm, tabs) ← loadTwist j P
  let piI := piMachinI P (P / 3 + 20)
  let nd := specOf panels addrs cutoffs ordinal
  let s := nodeS P nd
  let w := nodeW P nd
  match nodeShift P piI pd nd with
  | none => throw (IO.userError "profile sign undecided")
  | some (neg, aI) =>
    let Din := twistDin prm
    let lam := lamI P prm.j
    let aI' := mulI P (sqrtI P lam) aI
    IO.println s!"node {ordinal}: s = {toDecimal 20 s}, W = {toDecimal 20 w}, neg = {neg}, A = {toDecimal 15 aI}, A' = {toDecimal 15 aI'}, valid = {twistValid P prm nd aI}"
    let t0 ← IO.monoMsNow
    let vals := canonicalTriangleI P (seedScalarI P piI aI') neg zeroI aI' (sqrtTable P (Din + 1))
      (ratiosI P (sqI P aI') (ratioDepth Din)) Din Din
    IO.println s!"  triangle at A': {vals.size} pairs, max width 2^{maxWidthLog2 vals}"
    let t1 ← IO.monoMsNow
    let K := dilate P tabs.dil Din (fullTriangleI P vals Din)
    let kw := K.foldl (fun m row => row.foldl (fun m x => max m (widthLog2 x)) m) (-100000 : Int)
    let km := K.foldl (fun m row => row.foldl (fun m x => max m (magLog2 x)) m) (-100000 : Int)
    IO.println s!"  dilation: K max |entry| 2^{km}, max width 2^{kw}; K[0][0] = {toDecimal 18 (ivGet K 0 0)}"
    let t2 ← IO.monoMsNow
    let K' := unnormalise P tabs.sqf Din K
    IO.println s!"  unnormalised: K' max |entry| 2^{twMaxMagLog2 K'}, width 2^{twMaxWidthLog2 K'} (checksum {twChecksum K' % 1000000007})"
    let t3 ← IO.monoMsNow
    let r := sqrtI P s
    let coefs := nodeCoefs P tabs.terms s r
    let J' := applyQPow coefs (toTw (divN P 2 r)) prm.Dout prm.j K'
    IO.println s!"  operator: J' max |entry| 2^{twMaxMagLog2 J'}, width 2^{twMaxWidthLog2 J'} (checksum {twChecksum J' % 1000000007})"
    let t4 ← IO.monoMsNow
    let J := twistJ P prm tabs piI s neg aI
    let jw := J.foldl (fun m row => row.foldl (fun m x => max m (widthLog2 x)) m) (-100000 : Int)
    let jm := J.foldl (fun m row => row.foldl (fun m x => max m (magLog2 x)) m) (-100000 : Int)
    let t5 ← IO.monoMsNow
    IO.println s!"  J: max |entry| 2^{jm}, max width 2^{jw}"
    for c in [0:4] do
      for d in [0:3] do
        IO.println s!"    J[{c}][{d}] = {toDecimal 22 (ivGet J c d)}"
    let out := twistNode P prm tabs piI s w neg aI
    let t6 ← IO.monoMsNow
    IO.println s!"  I-part = {toDecimal 24 (ofFixed (2 * KOut) out.iPart.1 out.iPart.2)}; low[0][0][0] = {toDecimal 24 (ofFixed (2 * KOut) (lowGet out.low 0 0 0).1 (lowGet out.low 0 0 0).2)}"
    IO.println s!"  timing: triangle {t1 - t0} ms, dilation {t2 - t1} ms, unnormalise {t3 - t2} ms, operator {t4 - t3} ms, whole J (recomputed) {t5 - t4} ms, whole node (recomputed) {t6 - t5} ms"
    -- the dump for tools/quad_twist_compare.py
    IO.FS.createDirAll "handoff/quad-checker"
    let h ← IO.FS.Handle.mk s!"handoff/quad-checker/twistnode-j{j}-{ordinal}.txt" IO.FS.Mode.write
    h.putStrLn s!"node {ordinal} j {j} Dout {prm.Dout} s {toDecimal 40 s} W {toDecimal 40 w} ipart {toDecimal 40 (ofFixed (2 * KOut) out.iPart.1 out.iPart.2)}"
    for c in [0:prm.Dout + 1] do
      for d in [0:prm.Dout + 1 - c] do
        h.putStrLn s!"{c} {d} {toDecimal 36 (ivGet J c d)}"
    h.flush
    return 0

/-- `quadrun twistdump <j> <ordinals> <outdir> [P]`: the twisted coefficients `J_{c,d}(s)` of the
listed nodes (one ordinal per line), one dump per node (`twistnode-j<j>-<ordinal>.txt`), with the
per-node times in `twistdump-j<j>-times.txt`. -/
def cmdTwistDump (j : Nat) (ordFile outdir : String) (P : Nat) : IO UInt32 := do
  let (panels, addrs, cutoffs, pd) ← loadAll
  let (prm, tabs) ← loadTwist j P
  let piI := piMachinI P (P / 3 + 20)
  IO.FS.createDirAll outdir
  let lines ← IO.FS.lines ordFile
  let ht ← IO.FS.Handle.mk s!"{outdir}/twistdump-j{j}-times.txt" IO.FS.Mode.append
  for l in lines do
    match (l.splitOn " ").filter (· ≠ "") with
    | [o] =>
      let ordinal := parseNat! o
      let nd := specOf panels addrs cutoffs ordinal
      let s := nodeS P nd
      let w := nodeW P nd
      match nodeShift P piI pd nd with
      | none => IO.println s!"node {ordinal}: profile sign undecided"
      | some (neg, aI) =>
        let t0 ← IO.monoMsNow
        let J := twistJ P prm tabs piI s neg aI
        let jw := J.foldl (fun m row => row.foldl (fun m x => max m (widthLog2 x)) m) (-100000 : Int)
        let t1 ← IO.monoMsNow
        let out := twistNode P prm tabs piI s w neg aI
        let t2 ← IO.monoMsNow
        let h ← IO.FS.Handle.mk s!"{outdir}/twistnode-j{j}-{ordinal}.txt" IO.FS.Mode.write
        h.putStrLn s!"node {ordinal} j {j} Dout {prm.Dout} s {toDecimal 40 s} W {toDecimal 40 w} ipart {toDecimal 40 (ofFixed (2 * KOut) out.iPart.1 out.iPart.2)}"
        for c in [0:prm.Dout + 1] do
          for d in [0:prm.Dout + 1 - c] do
            h.putStrLn s!"{c} {d} {toDecimal 36 (ivGet J c d)}"
        h.flush
        ht.putStrLn s!"{ordinal} {t1 - t0} {t2 - t1} {jw} {twistValid P prm nd aI}"
        ht.flush
        IO.println s!"node {ordinal}: J {t1 - t0} ms (+ node {t2 - t1} ms), max width 2^{jw}, valid {twistValid P prm nd aI}"
    | _ => pure ()
  return 0

/-- `quadrun twist <j> <n> [P]`: the loop over the first `n` nodes, timed. -/
def cmdTwist (j n P : Nat) : IO UInt32 := do
  let (panels, addrs, cutoffs, pd) ← loadAll
  let (prm, tabs) ← loadTwist j P
  let piI := piMachinI P (P / 3 + 20)
  let specs := (List.range (min n addrs.size)).map (specOf panels addrs cutoffs)
  let t0 ← IO.monoMsNow
  match twistSpecs P piI pd prm tabs specs (twAccZero (twistQlow prm)) with
  | none => throw (IO.userError "twist: a node was rejected (a flag failed)")
  | some acc =>
    let t1 ← IO.monoMsNow
    IO.println s!"twist j={j} over {specs.length} nodes at P = {P}: {t1 - t0} ms ({(t1 - t0) / specs.length} ms per node)"
    IO.println s!"  I-partial = {toDecimal 24 (ofFixed (2 * KOut) acc.iPart.1 acc.iPart.2)}"
    IO.println s!"  low[0][0][0] = {toDecimal 24 (ofFixed (2 * KOut) (lowGet acc.low 0 0 0).1 (lowGet acc.low 0 0 0).2)}"
    return 0

/-- Write an accumulator: `I lo hi`, then `q c d lo hi` (scale `2^{2 KOut}`). -/
def writeTwAcc (path : String) (Qlow : Nat) (acc : TwAcc) : IO Unit := do
  let h ← IO.FS.Handle.mk path IO.FS.Mode.write
  h.putStrLn s!"I {acc.iPart.1} {acc.iPart.2}"
  for q in [0:Qlow] do
    for c in [0:q + 2] do
      for d in [0:q + 1] do
        let (lo, hi) := lowGet acc.low q c d
        h.putStrLn s!"{q} {c} {d} {lo} {hi}"
  h.flush

/-- Read an accumulator file. -/
def readTwAcc (path : String) (Qlow : Nat) : IO TwAcc := do
  let lines ← IO.FS.lines path
  let mut acc := twAccZero Qlow
  for l in lines do
    match (l.splitOn " ").filter (· ≠ "") with
    | ["I", lo, hi] => acc := ⟨(parseInt! lo, parseInt! hi), acc.low⟩
    | [q, c, d, lo, hi] =>
      let q := parseNat! q; let c := parseNat! c; let d := parseNat! d
      if q < Qlow then
        acc := ⟨acc.iPart, acc.low.set! q ((acc.low.getD q #[]).set! c (((acc.low.getD q #[]).getD c #[]).set! d (parseInt! lo, parseInt! hi)))⟩
    | _ => pure ()
  return acc

/-- `quadrun twistshard <j> <i> <n> <outdir> [P]`: the nodes `≡ i (mod n)`. -/
def cmdTwistShard (j i n : Nat) (outdir : String) (P : Nat) : IO UInt32 := do
  let (panels, addrs, cutoffs, pd) ← loadAll
  let (prm, tabs) ← loadTwist j P
  let piI := piMachinI P (P / 3 + 20)
  IO.FS.createDirAll outdir
  let hn ← IO.FS.Handle.mk s!"{outdir}/twist-j{j}-nodes-{i}.txt" IO.FS.Mode.write
  let mut acc := twAccZero (twistQlow prm)
  let mut count := 0
  let tStart ← IO.monoMsNow
  let mut ordinal := i
  while ordinal < addrs.size do
    let nd := specOf panels addrs cutoffs ordinal
    let t0 ← IO.monoMsNow
    match twistSpec P piI pd prm tabs nd acc with
    | none => throw (IO.userError s!"node {ordinal}: rejected (a flag failed)")
    | some acc' =>
      acc := acc'
      let t1 ← IO.monoMsNow
      hn.putStrLn s!"{ordinal} {t1 - t0}"
      hn.flush
    count := count + 1
    if count % 20 == 0 then
      let now ← IO.monoMsNow
      IO.println s!"twist j={j} shard {i}: {count} nodes, {(now - tStart) / 1000} s"
    ordinal := ordinal + n
  writeTwAcc s!"{outdir}/twist-j{j}-{i}.txt" (twistQlow prm) acc
  let tEnd ← IO.monoMsNow
  IO.println s!"twist j={j} shard {i}: done, {count} nodes, {(tEnd - tStart) / 1000} s"
  return 0

/-- `quadrun twistmerge <j> <n> <outdir>`: sum the shards, compare the low band with the center. -/
def cmdTwistMerge (j n : Nat) (outdir : String) : IO UInt32 := do
  let prm := twistParams j
  let Qlow := twistQlow prm
  let center ← readCenter s!"handoff/quad-checker/center-{j}.txt" prm.Q prm.E
  let mut acc := twAccZero Qlow
  for i in [0:n] do
    let a ← readTwAcc s!"{outdir}/twist-j{j}-{i}.txt" Qlow
    acc := ⟨addPair acc.iPart a.iPart, Array.ofFn fun q : Fin Qlow => Array.ofFn fun c : Fin (q.val + 2) =>
      Array.ofFn fun d : Fin (q.val + 1) => addPair (lowGet acc.low q c d) (lowGet a.low q c d)⟩
  writeTwAcc s!"{outdir}/twist-j{j}-final.txt" Qlow acc
  IO.println s!"I_{j} = {toDecimal 30 (ofFixed (2 * KOut) acc.iPart.1 acc.iPart.2)} (width 2^{widthLog2 (ofFixed (2 * KOut) acc.iPart.1 acc.iPart.2)})"
  -- low band against the center: Σ excursion², max excursion, Σ (mid − c)², max |mid − c|, Σ c²
  let mut exSq : Int := 0
  let mut exMax : Int := 0
  let mut cSq : Int := 0
  let mut wMax : Int := 0
  let mut count := 0
  for q in [0:Qlow] do
    for c in [0:q + 2] do
      for d in [0:q + 1] do
        let e := lowGet acc.low q c d
        let t := center.getD (gradedFlat q c d) 0 * pow2 (2 * KOut - prm.E)
        let ex := excursionTw e t
        exSq := exSq + ex * ex
        exMax := max exMax ex
        cSq := cSq + t * t
        wMax := max wMax (e.2 - e.1)
        count := count + 1
  let sc := 2 * KOut
  IO.println s!"low band ({count} coefficients, grades < {Qlow}): max excursion {toDecimal 20 (ofFixed sc exMax exMax)}, sqrt(sum excursion^2) = {toDecimal 20 (ofFixed sc (isqrtDown exSq.toNat) (isqrtUp exSq.toNat))}, center norm {toDecimal 16 (ofFixed sc (isqrtDown cSq.toNat) (isqrtUp cSq.toNat))}, max enclosure width 2^{widthLog2 (ofFixed sc 0 wMax)}"
  IO.println s!"  lowBandExcursionSq = {lowBandExcursionSq acc center prm.E Qlow} (scale 2^{4 * KOut})"
  return 0

def main (args : List String) : IO UInt32 := do
  match args with
  | ["check", rf, ff, tf, lo, hi] => cmdCheck rf ff tf (parseNat! lo) (parseNat! hi)
  | ["block", lo, hi, n] => cmdBlock (parseNat! lo) (parseNat! hi) (parseNat! n) 512
  | ["block", lo, hi, n, p] => cmdBlock (parseNat! lo) (parseNat! hi) (parseNat! n) (parseNat! p)
  | ["smat", i, n, d] => cmdSmat (parseNat! i) (parseNat! n) d
  | ["rotate", i, n, sd, rf, ff, od] => cmdRotate (parseNat! i) (parseNat! n) sd rf ff od
  | ["twistnode", j, o] => cmdTwistNode (parseNat! j) (parseNat! o) 512
  | ["twistnode", j, o, p] => cmdTwistNode (parseNat! j) (parseNat! o) (parseNat! p)
  | ["twistdump", j, f, d] => cmdTwistDump (parseNat! j) f d 512
  | ["twistdump", j, f, d, p] => cmdTwistDump (parseNat! j) f d (parseNat! p)
  | ["twist", j, n] => cmdTwist (parseNat! j) (parseNat! n) 512
  | ["twist", j, n, p] => cmdTwist (parseNat! j) (parseNat! n) (parseNat! p)
  | ["twistshard", j, i, n, d] => cmdTwistShard (parseNat! j) (parseNat! i) (parseNat! n) d 512
  | ["twistshard", j, i, n, d, p] => cmdTwistShard (parseNat! j) (parseNat! i) (parseNat! n) d (parseNat! p)
  | ["twistmerge", j, n, d] => cmdTwistMerge (parseNat! j) (parseNat! n) d
  | ["rules"] => cmdRules
  | ["node", o] => cmdNode (parseNat! o) precisions
  | ["node", o, p] => cmdNode (parseNat! o) [parseNat! p]
  | ["shard", i, n, d] => cmdShard (parseNat! i) (parseNat! n) d
  | ["merge", n, d] => cmdMerge (parseNat! n) d
  | _ =>
    IO.println "usage: quadrun rules | node <ordinal> [P] | shard <i> <n> <outdir> | merge <n> <outdir>"
    IO.println "       quadrun smat <i> <n> <outdir> | rotate <i> <n> <smatdir> <rawfile> <frozenfile> <outdir>"
    IO.println "       quadrun block <qLo> <qHi> <n> [P]   (the node loop of n nodes restricted to a grade block)"
    IO.println "       quadrun check <rawfile> <frozenfile> <tablefile> <qLo> <qHi>   (the block checks on a stored raw vector)"
    IO.println "       quadrun twistnode <j> <ordinal> [P] | twist <j> <n> [P] | twistshard <j> <i> <n> <outdir> [P] | twistmerge <j> <n> <outdir>"
    return 2
