private theorem minusCert_nonneg (a b : ℝ)
    (ha : 0 ≤ a) (ha1 : a ≤ 1) (hb : 0 ≤ b) (hb1 : b ≤ 1) :
    0 ≤ minusCert a b := by
  have : 0 ≤ 1-a := by linarith
  have : 0 ≤ 1-b := by linarith
  unfold minusCert
  positivity

