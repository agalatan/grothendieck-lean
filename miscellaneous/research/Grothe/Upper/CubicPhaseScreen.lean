private theorem plusCert_nonneg (a b : ℝ)
    (ha : 0 ≤ a) (ha1 : a ≤ 1) (hb : 0 ≤ b) (hb1 : b ≤ 1) :
    0 ≤ plusCert a b := by
  have : 0 ≤ 1-a := by linarith
  have : 0 ≤ 1-b := by linarith
  unfold plusCert
  positivity

theorem phase_conditions_unit (a b : ℝ) (ha : 0 ≤ a) (ha1 : a ≤ 1)
    (hb : 0 ≤ b) (hb1 : b ≤ 1) :
    C1 a ((1-a)*b)-4*C2 a ((1-a)*b)+9*C3 a ((1-a)*b) ≤ 0 ∧
    C1 a ((1-a)*b)+4*C2 a ((1-a)*b)+9*C3 a ((1-a)*b) ≤ 0 := by
  have h : 0 ≤ a*((1-a)*b) := mul_nonneg ha (mul_nonneg (by linarith) hb)
  have hm := mul_nonneg h (minusCert_nonneg a b ha ha1 hb hb1)
  have hp := mul_nonneg h (plusCert_nonneg a b ha ha1 hb hb1)
  have em : -(C1 a ((1-a)*b)-4*C2 a ((1-a)*b)+9*C3 a ((1-a)*b)) =
      a*((1-a)*b)*minusCert a b := by
    unfold C1 C2 C3 U V W T minusCert
    ring
  have ep : -(C1 a ((1-a)*b)+4*C2 a ((1-a)*b)+9*C3 a ((1-a)*b)) =
      a*((1-a)*b)*plusCert a b := by
    unfold C1 C2 C3 U V W T plusCert
    ring
  constructor <;> linarith

theorem phase_conditions (a r : ℝ) (ha : 0 ≤ a) (hr : 0 ≤ r) (har : a+r ≤ 1) :
    C1 a r-4*C2 a r+9*C3 a r ≤ 0 ∧ C1 a r+4*C2 a r+9*C3 a r ≤ 0 := by
  have ha1 : a ≤ 1 := by linarith
  by_cases h : a = 1
  · have : r = 0 := by linarith
    subst a; subst r
    norm_num [C1,C2,C3,U,V,W,T]
  · have halt : a < 1 := (lt_or_eq_of_le ha1).resolve_right h
    have hpos : 0 < 1-a := sub_pos.mpr halt
    have hb0 : 0 ≤ r/(1-a) := div_nonneg hr hpos.le
    have hb1 : r/(1-a) ≤ 1 := (div_le_one hpos).2 (by linarith)
    have hid : (1-a)*(r/(1-a)) = r := by field_simp
    simpa only [hid] using phase_conditions_unit a (r/(1-a)) ha ha1 hb0 hb1

def tangentValue : ℝ := (797193186936699 / 3518437208883200 : ℝ)
def tangentSlope : ℝ := (-812425971 / 21990232555520 : ℝ)
private def quotientRemainder (a : ℝ) : ℝ :=
    (10884066839 / 1717986918400 : ℝ) * a ^ 0 * (1-a) ^ 5 +
    (546407250627 / 1717986918400 : ℝ) * a ^ 1 * (1-a) ^ 4 +
    (1113142813459 / 858993459200 : ℝ) * a ^ 2 * (1-a) ^ 3 +
    (1827942760291 / 858993459200 : ℝ) * a ^ 3 * (1-a) ^ 2 +
    (2783128268723 / 1717986918400 : ℝ) * a ^ 4 * (1-a) ^ 1 +
    (828490951271 / 1717986918400 : ℝ) * a ^ 5 * (1-a) ^ 0

private theorem quotientRemainder_nonneg (a : ℝ) (ha : 0 ≤ a) (ha1 : a ≤ 1) :
    0 ≤ quotientRemainder a := by
  have : 0 ≤ 1-a := by linarith
  unfold quotientRemainder
  positivity

theorem real_polynomial_cap (a : ℝ) (ha : 0 ≤ a) (ha1 : a ≤ 1) :
    realPoly a < 22659/100000 := by
  have h := mul_nonneg (sq_nonneg (a-29/32)) (quotientRemainder_nonneg a ha ha1)
  have hi : tangentValue + (25/16)*tangentSlope^2 - realPoly a =
      ((2/5)*(a-29/32)-(5/4)*tangentSlope)^2 +
      (a-29/32)^2*quotientRemainder a := by
    unfold tangentValue tangentSlope realPoly axis U V W T quotientRemainder
    ring
  have hc : tangentValue + (25/16)*tangentSlope^2 < (22659/100000 : ℝ) := by
    norm_num [tangentValue,tangentSlope]
  nlinarith [sq_nonneg ((2/5)*(a-29/32)-(5/4)*tangentSlope)]

theorem trigonometric_square_bound (u v w t x : ℝ) (hx : -1 ≤ x) (hx1 : x ≤ 1)
    (ht : 0 ≤ w*t)
    (hm : -u*(v+w)+v*t-4*(v*w-u*t)+9*w*t ≤ 0)
    (hp : -u*(v+w)+v*t+4*(v*w-u*t)+9*w*t ≤ 0) :
    (u+t-(v+w)*x-2*t*x^2)^2+(1-x^2)*(w-v-2*t*x)^2 ≤ (u+v+w-t)^2 := by
  have hx0 : 0 ≤ 1+x := by linarith
  have hx2 : (2*x-1)^2 ≤ 9 := by nlinarith
  have htail : w*t*(2*x-1)^2 ≤ 9*w*t := by nlinarith [mul_nonneg ht (by linarith : 0 ≤ 9-(2*x-1)^2)]
  have hmid : 0 ≤ -(-u*(v+w)+v*t)+2*(v*w-u*t)*(1-x)-w*t*(2*x-1)^2 := by
    by_cases h : 0 ≤ v*w-u*t
    · have h1 := mul_nonneg h (by linarith : 0 ≤ 1-x)
      linarith
    · have hq : v*w-u*t ≤ 0 := by linarith
      have h1 := mul_nonpos_of_nonpos_of_nonneg hq (by linarith : 0 ≤ 1+x)
      nlinarith
  have hnon := mul_nonneg hx0 hmid
  have hid : (u+v+w-t)^2-((u+t-(v+w)*x-2*t*x^2)^2+(1-x^2)*(w-v-2*t*x)^2) =
      2*(1+x)*(-(-u*(v+w)+v*t)+2*(v*w-u*t)*(1-x)-w*t*(2*x-1)^2) := by ring
  linarith

theorem axis_nonneg (a r : ℝ) (ha : 0 ≤ a) (hr : 0 ≤ r) (har : a+r ≤ 1) :
    0 ≤ axis a r := by
  have ha1 : a ≤ 1 := by linarith
  have har4 : a*r ≤ 1/4 := by nlinarith [sq_nonneg (a-r)]
  have hbase : 0 ≤ 1/4-(9/25)*a^2/32-3*a^4/256-25*a^6/4096 := by
    nlinarith [pow_le_one₀ (n := 2) ha ha1, pow_le_one₀ (n := 4) ha ha1, pow_le_one₀ (n := 6) ha ha1]
  have hrem : 0 ≤ (9/25)/4+3*a^2/32+15*a^4/256-3*a*r/32 := by
    nlinarith [sq_nonneg a, sq_nonneg (a^2)]
  have hid : axis a r = a*(1/4-(9/25)*a^2/32-3*a^4/256-25*a^6/4096)+
      r*((9/25)/4+3*a^2/32+15*a^4/256-3*a*r/32) := by
    unfold axis U V W T
    ring
  rw [hid]
  exact add_nonneg (mul_nonneg ha hbase) (mul_nonneg hr hrem)

theorem axis_le_real_polynomial (a r : ℝ) (ha : 0 ≤ a) (hr : 0 ≤ r) (har : a+r ≤ 1) :
    axis a r ≤ realPoly a := by
  have har4 : a*r ≤ 1/4 := by nlinarith [sq_nonneg (a-r)]
  have ha4 : a*(1-a) ≤ 1/4 := by nlinarith [sq_nonneg (a-1/2)]
  have hcoef : 0 ≤ (9/25)/4+3*a^2/32+15*a^4/256-3*a*(1-a+r)/32 := by
    nlinarith [sq_nonneg a, sq_nonneg (a^2)]
  have h := mul_nonneg (by linarith : 0 ≤ 1-a-r) hcoef
  have hid : realPoly a-axis a r =
      (1-a-r)*((9/25)/4+3*a^2/32+15*a^4/256-3*a*(1-a+r)/32) := by
    unfold realPoly axis U V W T
    ring
  linarith

def normalizedScore (a r : ℝ) (z : ℂ) : ℂ :=
    (U a r : ℂ)-(V a r : ℂ)*z-(W a r : ℂ)*star z-(T a r : ℂ)*z^2

theorem normalized_complex_cap (a r : ℝ) (z : ℂ)
    (ha : 0 ≤ a) (hr : 0 ≤ r) (har : a+r ≤ 1) (hz : ‖z‖ = 1) :
    ‖normalizedScore a r z‖ < 22659/100000 := by
  have hxy : z.re^2+z.im^2 = 1 := by
    have h := Complex.sq_norm z
    rw [hz,Complex.normSq_apply] at h
    nlinarith
  have hx : -1 ≤ z.re := by nlinarith [sq_nonneg z.im]
  have hx1 : z.re ≤ 1 := by nlinarith [sq_nonneg z.im]
  have ht : 0 ≤ W a r*T a r := by unfold W T; positivity
  obtain ⟨hm,hp⟩ := phase_conditions a r ha hr har
  simp only [C1,C2,C3] at hm hp
  have hs := trigonometric_square_bound (U a r) (V a r) (W a r) (T a r) z.re hx hx1 ht
    (by simpa only [mul_assoc] using hm) (by simpa only [mul_assoc] using hp)
  have hy : z.im^2 = 1-z.re^2 := by linarith
  have hRe : (normalizedScore a r z).re =
      U a r+T a r-(V a r+W a r)*z.re-2*T a r*z.re^2 := by
    simp only [normalizedScore,pow_two,Complex.sub_re,Complex.mul_re,Complex.mul_im,
      Complex.ofReal_re,Complex.ofReal_im,Complex.star_def,Complex.conj_re,Complex.conj_im]
    linear_combination (T a r)*hxy
  have hIm : (normalizedScore a r z).im = z.im*(W a r-V a r-2*T a r*z.re) := by
    simp only [normalizedScore,pow_two,Complex.sub_im,Complex.mul_re,Complex.mul_im,
      Complex.ofReal_re,Complex.ofReal_im,Complex.star_def,Complex.conj_re,Complex.conj_im]
    ring
  have hid : ‖normalizedScore a r z‖^2 =
      (U a r+T a r-(V a r+W a r)*z.re-2*T a r*z.re^2)^2+
      (1-z.re^2)*(W a r-V a r-2*T a r*z.re)^2 := by
    rw [Complex.sq_norm,Complex.normSq_apply,hRe,hIm]
    calc
      _ = (U a r+T a r-(V a r+W a r)*z.re-2*T a r*z.re^2)^2+
          z.im^2*(W a r-V a r-2*T a r*z.re)^2 := by ring
      _ = _ := by rw [hy]
  have hn := axis_nonneg a r ha hr har
  have he := axis_le_real_polynomial a r ha hr har
  have hc := real_polynomial_cap a ha (by linarith)
  change _ ≤ (axis a r)^2 at hs
  rw [← hid] at hs
  have hnorm : ‖normalizedScore a r z‖ ≤ axis a r := by
    nlinarith [norm_nonneg (normalizedScore a r z)]
  linarith

theorem complex_score_cap (a r : ℝ) (z : ℂ)
    (ha : 0 ≤ a) (hr : 0 ≤ r) (har : a+r ≤ 1) (hz : ‖z‖ = 1) :
    Real.pi*‖normalizedScore a r z‖ < 71186/100000 := by
  have h := normalized_complex_cap a r z ha hr har hz
  have hp : Real.pi < (355/113 : ℝ) := by linarith [Real.pi_lt_d20]
  have h1 := mul_lt_mul_of_pos_left h Real.pi_pos
  have h2 := mul_lt_mul_of_pos_right hp (by norm_num : (0:ℝ) < 22659/100000)
  nlinarith

/-- Every full absolute-tail score is bounded by this one linear functional. -/
theorem score_le_separator (c0 c1 c2 c3 : ℂ) (tail : ℝ)
    (ht : |c1.re|+|c2.re|+|c3.re| ≤ tail) :
    c0.re-tail ≤ (c0-(9/25 : ℂ)*c1-c2-c3).re := by
  have h1 := le_abs_self c1.re
  have h2 := le_abs_self c2.re
  have h3 := le_abs_self c3.re
  have hn := abs_nonneg c1.re
  norm_num [Complex.sub_re,Complex.mul_re,Complex.div_re]
  linarith

/-- Application interface: the Gaussian phase calculation supplies `hidentity`.
No bound on an uncomputed omitted tail is assumed, only its first three terms. -/
theorem full_score_cap_of_low_identity (a r : ℝ) (z gamma c0 c1 c2 c3 : ℂ) (tail : ℝ)
    (ha : 0 ≤ a) (hr : 0 ≤ r) (har : a+r ≤ 1) (hz : ‖z‖ = 1) (hg : ‖gamma‖ = 1)
    (ht : |c1.re|+|c2.re|+|c3.re| ≤ tail)
    (hidentity : c0-(9/25 : ℂ)*c1-c2-c3 = gamma*(Real.pi : ℂ)*normalizedScore a r z) :
    c0.re-tail < 71186/100000 := by
  have h0 := score_le_separator c0 c1 c2 c3 tail ht
  have h1 := Complex.re_le_norm (c0-(9/25 : ℂ)*c1-c2-c3)
  have hn : ‖c0-(9/25 : ℂ)*c1-c2-c3‖ = Real.pi*‖normalizedScore a r z‖ := by
    rw [hidentity,norm_mul,norm_mul,hg,Complex.norm_real,Real.norm_eq_abs,
      abs_of_pos Real.pi_pos,one_mul]
  rw [hn] at h1
  exact lt_of_le_of_lt (h0.trans h1) (complex_score_cap a r z ha hr har hz)

end
