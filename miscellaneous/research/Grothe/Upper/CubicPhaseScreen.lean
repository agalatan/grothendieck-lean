import Grothe.Upper.SpectralScreen
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Bounds

/-!
# A degree-seven separator for cubic Gaussian-phase preprocessors

The exact polynomial certificate is regenerated by
`tools/generate_cubic_phase_lean.py`. All arithmetic is checked by the kernel.
Gaussian phase integration and the graded limit are written analytic inputs,
not axioms introduced by this module.
-/
namespace Grothe.Upper.CubicPhaseScreen
noncomputable section
set_option maxHeartbeats 4000000

def U (a r : ℝ) : ℝ := a/4-(9/25)*a^3/32-3*a^5/256-25*a^7/4096-a*r^2/16
def V (a r : ℝ) : ℝ := r*((9/25)/4+a^2/16+9*a^4/256)
def W (a r : ℝ) : ℝ := r*(a^2/32+3*a^4/128)
def T (a r : ℝ) : ℝ := a*r^2/32
def C1 (a r : ℝ) : ℝ := -U a r*(V a r+W a r)+V a r*T a r
def C2 (a r : ℝ) : ℝ := V a r*W a r-U a r*T a r
def C3 (a r : ℝ) : ℝ := W a r*T a r
def axis (a r : ℝ) : ℝ := U a r+V a r+W a r-T a r
def realPoly (a : ℝ) : ℝ := axis a (1-a)

