import Grothe.Upper.Final
import Grothe.UpperChaos.LegacySingleCharacterSplit
import Init.Data.List.SplitOn.Lemmas
import Init.Data.String.Lemmas.Pattern.TakeDrop.String
import Std.Data.String.ToNat
import Lean.Util.CollectAxioms

/-! Actual current stored degree-one energy lookups. The complete energyRows
parser and tabVal remain the targets; no replacement parser or source axiom.
Generated by tools/gen_energy_degree_one_lookup.py from the tracked
upper-preprocess certificate. Agent-ID: codex-7c2e. -/

set_option warningAsError true

namespace Grothe.Upper.EnergyDegreeOneLookup

private def splitCharAccum (sep : Char) : List Char → List Char → List (List Char)
  | [], acc => [acc.reverse]
  | c :: cs, acc => if c == sep then acc.reverse :: splitCharAccum sep cs []
      else splitCharAccum sep cs (c :: acc)

private theorem splitCharAccum_eq (sep : Char) (cs acc : List Char) :
    splitCharAccum sep cs acc = List.splitOnPPrepend (· == sep) cs acc := by
  induction cs generalizing acc with
  | nil => simp only [splitCharAccum, List.splitOnPPrepend_nil]
  | cons c cs ih =>
    simp only [splitCharAccum, List.splitOnPPrepend_cons_eq_ite, ih,
      List.splitOnPPrepend_nil_right]

private def splitChars (sep : Char) (cs : List Char) : List (List Char) :=
  splitCharAccum sep cs []

private theorem splitChars_eq (sep : Char) (cs : List Char) :
    splitChars sep cs = cs.splitOn sep := by
  rw [splitChars, splitCharAccum_eq, List.splitOnPPrepend_nil_right,
    List.splitOn_eq_splitOnP]

private theorem split_strings (s : String) (c : Char) :
    s.splitOn (String.ofList [c]) = (splitChars c s.toList).map String.ofList := by
  have h := congrArg (List.map String.ofList)
    (Grothe.UpperChaos.PackedDyadic.Structural.legacy_split_tokens s c)
  simpa only [List.map_map, Function.comp_def, String.ofList_toList,
    List.map_id_fun', id_eq, splitChars_eq] using h

/-- Certificates accept only decimal tokens from the actual source. A rejected
token proves nothing about the original parser's fallback behavior. -/
private def decimal? (cs : List Char) : Option ℕ :=
  if cs ≠ [] ∧ cs.all Char.isDigit then
    some (Nat.ofDigitChars 10 (cs.filter (· != '_')) 0)
  else none

private theorem natBang_of_some (s : String) (n : ℕ) (h : s.toNat? = some n) :
    s.toNat! = n := by
  have hn := String.isNat_of_toNat?_eq_some h
  change s.toSlice.isNat = true at hn
  change (if s.toSlice.isNat then some
    (s.toSlice.foldl (fun k c => if c = '_' then k else
      k * 10 + (c.toNat - '0'.toNat)) 0) else none) = some n at h
  change (if s.toSlice.isNat then
    s.toSlice.foldl (fun k c => if c = '_' then k else
      k * 10 + (c.toNat - '0'.toNat)) 0 else _) = n
  simpa only [hn, ite_true, Option.some.injEq] using h

private theorem decimal_correct (s : String) (n : ℕ)
    (h : decimal? s.toList = some n) : s.toNat! = n := by
  unfold decimal? at h
  split at h
  next hv =>
    have hn : s.isNat = true := String.isNat_of_isDigit
      (by simpa only [ne_eq, String.toList_eq_nil_iff] using hv.1)
      (fun c hc => List.all_eq_true.mp hv.2 c hc)
    apply natBang_of_some s n
    rw [String.toNat?_eq_some_ofDigitChars hn]
    exact h
  next _ => simp at h

private def entryValue? (n : ℕ) (cs : List Char) : Option ℚ :=
  match splitChars ',' cs with
  | [ns, aa, ks] => do
    let ni ← decimal? ns
    if ni = n then
      let a ← decimal? aa
      let k ← decimal? ks
      pure ((a : ℚ) / ((2 ^ k : ℕ) : ℚ))
    else pure 0
  | _ => none

private theorem entryValue_correct (s : String) (n : ℕ) (v : ℚ)
    (h : entryValue? n s.toList = some v) :
    (if (GrotheKernel.parseEntry s).1 = n then (GrotheKernel.parseEntry s).2 else 0) = v := by
  unfold entryValue? at h
  split at h
  next ns aa ks hfields =>
    have hsplit : s.splitOn "," = [String.ofList ns, String.ofList aa, String.ofList ks] := by
      rw [show "," = String.ofList [','] from rfl, split_strings, hfields]
      rfl
    cases hns : decimal? ns with
    | none => simp [hns] at h
    | some ni =>
      have hn := decimal_correct (String.ofList ns) ni (by simpa using hns)
      by_cases he : ni = n
      · cases haa : decimal? aa with
        | none => simp [hns, he, haa] at h
        | some a =>
          cases hks : decimal? ks with
          | none => simp [hns, he, haa, hks] at h
          | some k =>
            have ha := decimal_correct (String.ofList aa) a (by simpa using haa)
            have hk := decimal_correct (String.ofList ks) k (by simpa using hks)
            have hv : (a : ℚ) / ((2 ^ k : ℕ) : ℚ) = v := by
              simpa [hns, he, haa, hks] using h
            simpa only [GrotheKernel.parseEntry, hsplit, hn, ha, hk, he, ite_true] using hv
      · have hv : (0 : ℚ) = v := by simpa [hns, he] using h
        simpa only [GrotheKernel.parseEntry, hsplit, hn, he, ite_false] using hv
  next _ => simp at h

private def rowValue (n m : ℕ) (row : GrotheKernel.RowQ) : ℚ :=
  if row.1 = m then
    (row.2.map fun entry => if entry.1 = n then entry.2 else 0).sum
  else 0

private theorem startsWith_append (prefix tail : String) :
    (prefix ++ tail).startsWith prefix = true := by
  apply String.startsWith_string_iff.mpr
  rw [String.toList_append]
  exact ⟨tail.toList, rfl⟩

private theorem split_single (s : String) (sep : Char) (h : sep ∉ s.toList) :
    s.splitOn (String.ofList [sep]) = [s] := by
  rw [split_strings, splitChars_eq, List.splitOn_eq_singleton h]
  simp only [List.map_cons, List.map_nil, String.ofList_toList]

/-- Composition is through the original legacy splitter. No complete source
string is converted to a character list by a generated closed computation. -/
private theorem split_join (left right : String) (sep : Char) :
    (left ++ String.ofList [sep] ++ right).splitOn (String.ofList [sep]) =
      left.splitOn (String.ofList [sep]) ++ right.splitOn (String.ofList [sep]) := by
  calc
    _ = (((left.toList ++ [sep]) ++ right.toList).splitOn sep).map String.ofList := by
      simp only [split_strings, splitChars_eq, String.toList_append, String.toList_ofList]
    _ = (left.toList.splitOn sep ++ right.toList.splitOn sep).map String.ofList := by
      rw [List.append_assoc, List.singleton_append, List.splitOn_append_cons_self]
    _ = _ := by simp only [List.map_append, split_strings, splitChars_eq]

private def bodyValue (n : ℕ) (s : String) : ℚ :=
  ((s.splitOn ";").map fun entry =>
    if (GrotheKernel.parseEntry entry).1 = n then (GrotheKernel.parseEntry entry).2 else 0).sum

private theorem bodyValue_single (s : String) (n : ℕ) (v : ℚ)
    (hsep : ';' ∉ s.toList) (h : entryValue? n s.toList = some v) :
    bodyValue n s = v := by
  have hs : s.splitOn ";" = [s] := split_single s ';' hsep
  simpa only [bodyValue, hs, List.map_cons, List.map_nil, List.sum_cons,
    List.sum_nil, add_zero] using entryValue_correct s n v h

private theorem bodyValue_join (left right : String) (n : ℕ) :
    bodyValue n (left ++ ";" ++ right) = bodyValue n left + bodyValue n right := by
  unfold bodyValue
  rw [show ";" = String.ofList [';'] from rfl, split_join]
  simp only [List.map_append, List.sum_append]

private theorem noColon_join (left right : String)
    (hl : ':' ∉ left.toList) (hr : ':' ∉ right.toList) :
    ':' ∉ (left ++ ";" ++ right).toList := by
  have hs : ':' ∉ ";".toList := by decide +kernel
  simpa only [String.toList_append, List.mem_append, not_or] using
    And.intro (And.intro hl hs) hr

private theorem rowValue_of_body (s header body : String) (n m : ℕ)
    (hs : s = header ++ ":" ++ body)
    (hd : decimal? header.toList = some m)
    (hc : ':' ∉ header.toList) (hb : ':' ∉ body.toList) :
    rowValue n m (GrotheKernel.parseRow s) = bodyValue n body := by
  have hm := decimal_correct header m hd
  have hh : header.splitOn ":" = [header] := split_single header ':' hc
  have ht : body.splitOn ":" = [body] := split_single body ':' hb
  have hsplit : (header ++ ":" ++ body).splitOn ":" = [header, body] := by
    rw [show ":" = String.ofList [':'] from rfl, split_join, hh, ht]
    rfl
  rw [hs]
  simp [GrotheKernel.parseRow, hsplit, rowValue, hm, bodyValue]

/-- A nonmatching header contributes zero even if the remaining source is
malformed: the original parser then returns its empty default row. Thus the
certificate need inspect only the short header, without discarding any row. -/
private theorem rowValue_zero_of_prefix (s : String) (n m mi : ℕ) (ms : List Char)
    (hp : s.startsWith (String.ofList (ms ++ [':'])) = true)
    (hd : decimal? ms = some mi) (hc : ':' ∉ ms) (hm : mi ≠ m) :
    rowValue n m (GrotheKernel.parseRow s) = 0 := by
  have hprefix := String.startsWith_string_iff.mp hp
  rw [String.toList_ofList] at hprefix
  obtain ⟨tail, htail⟩ := hprefix
  have hsplit : splitChars ':' s.toList = ms :: tail.splitOn ':' := by
    rw [splitChars_eq, ← htail]
    simpa only [List.append_assoc, List.singleton_append] using
      List.splitOn_append_cons_self_of_not_mem hc tail
  have hstrings : s.splitOn ":" =
      String.ofList ms :: (tail.splitOn ':').map String.ofList := by
    rw [show ":" = String.ofList [':'] from rfl, split_strings, hsplit]
    rfl
  have hmi := decimal_correct (String.ofList ms) mi
    (by simpa only [String.toList_ofList] using hd)
  cases ht : tail.splitOn ':' with
  | nil => simp [GrotheKernel.parseRow, hstrings, ht, rowValue]
  | cons body rest =>
    cases rest with
    | nil => simp [GrotheKernel.parseRow, hstrings, ht, rowValue, hmi, hm]
    | cons extra rest => simp [GrotheKernel.parseRow, hstrings, ht, rowValue]

/-- Preserve every row and every matching entry, including duplicates.
This changes only evaluation order, so nonmatching rows need no entry decoding. -/
private theorem tabVal_rows (rows : List GrotheKernel.RowQ) (n m : ℕ) :
    tabVal rows (n, m) = (rows.map (rowValue n m)).sum := by
  induction rows with
  | nil => rfl
  | cons row rows ih =>
    have hr : (row.2.map fun entry =>
        if (entry.1, row.1) = (n, m) then entry.2 else 0).sum = rowValue n m row := by
      by_cases h : row.1 = m <;> simp [rowValue, h, Prod.mk.injEq]
    calc
      tabVal (row :: rows) (n, m) =
          (row.2.map fun entry =>
            if (entry.1, row.1) = (n, m) then entry.2 else 0).sum + tabVal rows (n, m) := by
        simp only [tabVal, flat, List.flatMap_cons, List.map_append, List.sum_append,
          List.map_map, Function.comp_def]
      _ = ((row :: rows).map (rowValue n m)).sum := by
        rw [hr, ih]
        rfl

private theorem tabVal_append (left right : List GrotheKernel.RowQ) (n m : ℕ) :
    tabVal (left ++ right) (n, m) = tabVal left (n, m) + tabVal right (n, m) := by
  simp only [tabVal_rows, List.map_append, List.sum_append]

private theorem tabVal_nil (n m : ℕ) : tabVal [] (n, m) = 0 := rfl

@ROW_CERTIFICATES@

@TABLE_CERTIFICATES@

end Grothe.Upper.EnergyDegreeOneLookup

run_cmd do
  let allowed : Array Lean.Name := #[`propext, `Classical.choice, `Quot.sound]
  for target in #[``Grothe.Upper.EnergyDegreeOneLookup.one_zero,
      ``Grothe.Upper.EnergyDegreeOneLookup.zero_one] do
    let dependencies ← Lean.collectAxioms target
    let unexpected := dependencies.filter fun n => !allowed.contains n
    unless unexpected.isEmpty do
      throwError m!"Unexpected degree-one table lookup axioms: {unexpected}"
