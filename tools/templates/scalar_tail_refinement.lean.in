-- Grothe/Haagerup/ScalarTailRefinement.lean
import Grothe.Upper.PowerTail
import Grothe.Upper.Haagerup
import Grothe.Haagerup.WallisTail

/-!
# Scalar outer-tail refinement by finite-power cancellation

Generated by tools/gen_scalar_tail_refinement.py from
 data/scalar-tail-refinement/certificate.json and
 tools/templates/scalar_tail_refinement.lean.in. Do not edit by hand.

The exact polynomial has Wiener norm at most one and a strictly contracting
power. Its omitted outer suffix retains that contraction before the Wallis
bound is applied. The rational ledger includes the exact selector mass.

The Wallis bound follows from the Haagerup recurrence and a kernel-checked
rational comparison. The final score corollary explicitly assumes only the
published scalar analytic budgets. It does not assert a Grothendieck endpoint.
See data/scalar-tail-refinement/PROOF.md for the mathematical inputs.
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

namespace Grothe.ScalarTailRefinement

open GrotheKernel Grothe.Upper Grothe.Upper.PowerTail Grothe.HaagerupWallis Polynomial Finset

def pl : List ℚ := [@PL@]

def ratio : ℚ := @RATIO@

/-- Kernel-checked outward fixed-point bound for the finite polynomial power. -/
lemma power_check : powerNormOK pl @POWER@ ratio = true := by
  decide +kernel

/-- A rational comparison for the standard phase-tail cap. -/
lemma wallis_rational_check :
    (2 : ℝ)/(8*@START@+1) ≤ 1/@WALLIS_DENOMINATOR@ := by
  norm_num

noncomputable section

/-- The entire omitted phase suffix follows from the all-index Wallis estimate. -/
lemma wallis_tail_bound : (∑' k, |cHi @START@ k|) ≤ (1 : ℝ)/@WALLIS_DENOMINATOR@ := by
  calc
    _ ≤ tailMajorant @START@ := supported_tail_le @START@
    _ ≤ (2:ℝ)/(8*@START@+1) := by unfold tailMajorant; apply sub_le_self; positivity
    _ ≤ (1:ℝ)/@WALLIS_DENOMINATOR@ := wallis_rational_check

def P : ℝ[X] := ofListQ pl

lemma norm_P : l1 P ≤ 1 :=
  (l1_ofListQ_le pl).trans (by norm_num [pl])

lemma degree_P : P.natDegree ≤ @DEGREE@ := by
  simpa [P, pl] using natDegree_ofListQ_le pl

lemma norm_power : l1 (P^@POWER@) ≤ (ratio : ℝ) := by
  apply power_norm_of_check pl @POWER@ @CUTOFF@ ratio _ power_check
  exact lt_of_le_of_lt
    ((natDegree_pow_le).trans (Nat.mul_le_mul_left @POWER@ degree_P)) (by norm_num)

/-- Finite-power cancellation for an arbitrary power r. The intended
application has r>0; the statement also remains true for r=0. -/
theorem compTerm_arbitrary_power_bound {R : ℝ[X]} (hR : l1 R ≤ 1)
    {q : ℝ} (hq0 : 0 ≤ q) (r : ℕ) (hpow : l1 (R^r) ≤ q) (k : ℕ) :
    l1 (compTerm R k) ≤ q^((2*k+1)/r) := by
  have he : 2*k+1 = r*((2*k+1)/r)+(2*k+1)%r :=
    (Nat.div_add_mod (2*k+1) r).symm
  have hrem : l1 (R^((2*k+1)%r)) ≤ 1 :=
    (l1_pow_le _ _).trans (pow_le_one₀ (l1_nonneg _) hR)
  have hp : l1 (R^(2*k+1)) ≤ q^((2*k+1)/r) := by
    conv_lhs => rw [he, pow_add, pow_mul]
    exact (l1_mul_le _ _).trans ((mul_le_mul
      ((l1_pow_le _ _).trans (pow_le_pow_left₀ (l1_nonneg _) hpow _))
      hrem (l1_nonneg _) (pow_nonneg hq0 _)).trans_eq (mul_one _))
  exact (l1_mul_le _ _).trans ((mul_le_mul
    ((l1_pow_le _ _).trans (by simp)) hp (l1_nonneg _) zero_le_one).trans_eq (one_mul _))

/-- A signed supported suffix retains a common arbitrary-power saving.
No positivity of the outer coefficient sequence is assumed. -/
theorem supported_composition_arbitrary_power_bound {c : ℕ → ℝ}
    (hc : Summable fun k => |c k|) {R : ℝ[X]} (hR : l1 R ≤ 1)
    {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (r : ℕ) (hpow : l1 (R^r) ≤ q)
    (K m : ℕ) (hm : m ≤ (2*K+1)/r) (hsupport : ∀ k, k < K → c k = 0) :
    ∑' n, |compCoeff c R n| ≤ q^m * ∑' k, |c k| := by
  let w : ℕ → ℝ := fun k => if k < K then 1 else q^m
  have hw0 : ∀ k, 0 ≤ w k := by
    intro k
    dsimp [w]
    split_ifs <;> positivity
  have hw1 : ∀ k, w k ≤ 1 := by
    intro k
    dsimp [w]
    split_ifs
    · exact le_rfl
    · exact pow_le_one₀ hq0 hq1
  have hterm : ∀ k, l1 (compTerm R k) ≤ w k := by
    intro k
    by_cases hk : k < K
    · simpa [w, hk] using l1_compTerm_le hR k
    · have he : m ≤ (2*k+1)/r :=
        hm.trans (Nat.div_le_div_right (by omega : 2*K+1 ≤ 2*k+1))
      exact (compTerm_arbitrary_power_bound hR hq0 r hpow k).trans
        (by simpa [w, hk] using pow_le_pow_of_le_one hq0 hq1 he)
  calc
    ∑' n, |compCoeff c R n| ≤ ∑' k, |c k| * w k :=
      weighted_composition hc hR w hw0 hw1 hterm
    _ = ∑' k, q^m * |c k| := by
      apply tsum_congr
      intro k
      by_cases hk : k < K
      · simp [w, hk, hsupport k hk]
      · simp [w, hk, mul_comm]
    _ = q^m * ∑' k, |c k| := tsum_mul_left

/-- The canonical interval majorant, in rational arithmetic. -/
def rationalTail (n : ℕ) : ℚ :=
  2/(8*(n:ℚ)+1) - 14/(3*(8*(n:ℚ)+1)*(8*(n:ℚ)+9)*(8*(n:ℚ)+17))

/-- Consecutive blocks are priced once each, at their initial power weight. -/
def rationalBlocks : ℕ → List ℕ → ℚ
  | _, [] => 0
  | K, N :: rest => ratio^((2*K+1)/@POWER@) * (rationalTail K - rationalTail (K+N)) +
      rationalBlocks (K+N) rest

def blockWidths : List ℕ := [@BLOCK_WIDTHS@]

def canonicalOuterBound : ℚ := rationalBlocks @START@ blockWidths +
  ratio^((2*@WEIGHTED_SPLIT@+1)/@POWER@) * rationalTail @WEIGHTED_SPLIT@

/-- The unchanged exact ledger cap, now supplied directly by the certificate. -/
def weightedOuterBound : ℚ := @WEIGHTED_OUTER_BOUND@

private lemma rationalTail_cast (n : ℕ) : (rationalTail n:ℝ) = tailMajorant n := by
  simp [rationalTail, tailMajorant]

private lemma rationalBlocks_cast (n : ℕ) (ws : List ℕ) :
    (rationalBlocks n ws:ℝ) =
      blockBound (fun k => (ratio:ℝ)^((2*k+1)/@POWER@)) n ws := by
  induction ws generalizing n with
  | nil => simp [rationalBlocks, blockBound]
  | cons len rest ih =>
    simp only [rationalBlocks, blockBound, Rat.cast_add, Rat.cast_mul, Rat.cast_pow,
      Rat.cast_sub, rationalTail_cast, ih]

private lemma canonical_cast :
    blockBound (fun k => (ratio:ℝ)^((2*k+1)/@POWER@)) @START@ blockWidths +
      (ratio:ℝ)^((2*@WEIGHTED_SPLIT@+1)/@POWER@) * tailMajorant @WEIGHTED_SPLIT@ =
        (canonicalOuterBound:ℝ) := by
  simp [canonicalOuterBound, rationalBlocks_cast, rationalTail_cast]

/-- Twelve block costs replace the coefficient-by-coefficient weighted prefix. -/
lemma outer_composition_saving :
    ∑' n, |compCoeff (cHi @START@) P n| ≤ (canonicalOuterBound : ℝ) := by
  let w : ℕ → ℝ := fun k => (ratio : ℝ)^((2*k+1)/@POWER@)
  have hq0 : (0 : ℝ) ≤ ratio := by norm_num [ratio]
  have hq1 : (ratio : ℝ) ≤ 1 := by norm_num [ratio]
  have hw0 : ∀ k, 0 ≤ w k := fun k => pow_nonneg hq0 _
  have hw1 : ∀ k, w k ≤ 1 := fun k => pow_le_one₀ hq0 hq1
  have hm : Antitone w := by
    intro k l hkl
    exact pow_le_pow_of_le_one hq0 hq1 (Nat.div_le_div_right (by omega))
  have hmain := weighted_composition_cut (summable_cHi @START@) norm_P w hw0 hw1 hm
    (fun k => compTerm_arbitrary_power_bound norm_P hq0 @POWER@ norm_power k) @WEIGHTED_SPLIT@
  have hz : (∑ k ∈ range @START@, |cHi @START@ k| * w k) = 0 :=
    sum_eq_zero fun k hk => by simp [cHi, mem_range.mp hk]
  have hs : (∑ k ∈ range @WEIGHTED_SPLIT@, |cHi @START@ k| * w k) =
      (∑ k ∈ range @START@, |cHi @START@ k| * w k) +
        ∑ i ∈ range @PREFIX_LENGTH@, |cHi @START@ (@START@+i)| * w (@START@+i) := by
    simpa using sum_range_add (fun k => |cHi @START@ k| * w k) @START@ @PREFIX_LENGTH@
  rw [hz, zero_add] at hs
  have hfinite : (∑ k ∈ range @WEIGHTED_SPLIT@, |cHi @START@ k| * w k) ≤
      blockBound w @START@ blockWidths := by
    rw [hs]
    have he : (∑ i ∈ range @PREFIX_LENGTH@, |cHi @START@ (@START@+i)| * w (@START@+i)) =
        ∑ i ∈ range @PREFIX_LENGTH@, haagCoeff (@START@+i) * w (@START@+i) := by
      apply sum_congr rfl
      intro i _
      simp [cHi, show ¬ @START@+i < @START@ by omega, abs_of_nonneg (haagCoeff_nonneg _)]
    rw [he]
    have h := weighted_blocks w hw0 hm @START@ blockWidths
    simpa [blockWidths] using h
  have hshift : ∑' k, |cHi @START@ (k+@WEIGHTED_SPLIT@)| =
      ∑' k, haagCoeff (@WEIGHTED_SPLIT@+k) := by
    apply tsum_congr
    intro k
    simp [cHi, show ¬ k+@WEIGHTED_SPLIT@ < @START@ by omega,
      Nat.add_comm, abs_of_nonneg (haagCoeff_nonneg _)]
  rw [hshift] at hmain
  calc
    _ ≤ (∑ k ∈ range @WEIGHTED_SPLIT@, |cHi @START@ k| * w k) +
        w @WEIGHTED_SPLIT@ * ∑' k, haagCoeff (@WEIGHTED_SPLIT@+k) := hmain
    _ ≤ blockBound w @START@ blockWidths + w @WEIGHTED_SPLIT@ * tailMajorant @WEIGHTED_SPLIT@ :=
      add_le_add hfinite (mul_le_mul_of_nonneg_left (tail_le @WEIGHTED_SPLIT@) (hw0 _))
    _ = _ := by simpa only [w] using canonical_cast

private lemma canonicalOuterBound_le : canonicalOuterBound ≤ weightedOuterBound := by
  decide +kernel

/-- The existing rational cap follows from the twelve canonical block prices. -/
lemma outer_composition_bound :
    ∑' n, |compCoeff (cHi @START@) P n| ≤ (weightedOuterBound : ℝ) :=
  outer_composition_saving.trans (by exact_mod_cast canonicalOuterBound_le)

/-! ## Exact rational ledger

The prefix, finite-block tail, other tails, selector mass and slope are the
unchanged published budgets identified in data/scalar-tail-refinement/PROOF.md.
Only the omitted outer reserve is replaced. All are raw, before selector
normalization. The ledger does not grant the inputs their Gaussian meaning.
-/

def branch5Weight : ℚ := @WEIGHT@
def slopeLower : ℚ := @SLOPE@
def prefixUpper : ℚ := @PREFIX@
def finite67Upper : ℚ := @FINITE@
def otherTailsUpper : ℚ := @OTHER@
def selectorMass : ℚ := @MASS@
def outerReserve : ℚ := branch5Weight * weightedOuterBound
def residualUpper : ℚ := prefixUpper + finite67Upper + otherTailsUpper + outerReserve
def scoreLower : ℚ := (slopeLower-residualUpper)/selectorMass
def reciprocalClaim : ℚ := @CLAIM@

lemma branch5_outer_bound
    (houter : (∑' n, |compCoeff (cHi @START@) P n|) ≤ (weightedOuterBound : ℝ)) :
    (branch5Weight : ℝ) * (∑' n, |compCoeff (cHi @START@) P n|) ≤
      (outerReserve : ℝ) := by
  calc
    (branch5Weight : ℝ) * (∑' n, |compCoeff (cHi @START@) P n|) ≤
        (branch5Weight : ℝ) * (weightedOuterBound : ℝ) :=
      mul_le_mul_of_nonneg_left houter
        (by norm_num [branch5Weight])
    _ = (outerReserve : ℝ) := by
      dsimp [outerReserve]
      push_cast
      ring

/-- Exact arithmetic including the selector mass, with a strict margin. -/
lemma ledger_acceptance :
    (1 : ℚ)/reciprocalClaim * selectorMass < slopeLower-residualUpper := by
  decide +kernel

lemma score_acceptance : (1 : ℚ)/reciprocalClaim < scoreLower := by
  unfold scoreLower
  exact (lt_div_iff₀ (by norm_num [selectorMass])).2 ledger_acceptance

/-- Parameterized arithmetic transfer. Each hypothesis must be supplied by
the published proof or a separate verified replay for the same raw mixture.
No valid-kernel or Grothendieck conclusion is asserted by this theorem. -/
theorem normalized_score_of_published_budgets
    (linear prefixCost finite67 otherTails outer mass : ℝ)
    (hlinear : (slopeLower : ℝ) ≤ linear)
    (hprefix : prefixCost ≤ (prefixUpper : ℝ))
    (hfinite67 : finite67 ≤ (finite67Upper : ℝ))
    (hother : otherTails ≤ (otherTailsUpper : ℝ))
    (houter : outer ≤ (outerReserve : ℝ))
    (hmass : mass = (selectorMass : ℝ)) :
    1/(reciprocalClaim : ℝ) <
      (linear-(prefixCost+finite67+otherTails+outer))/mass := by
  have hres : prefixCost+finite67+otherTails+outer ≤ (residualUpper : ℝ) := by
    calc
      prefixCost+finite67+otherTails+outer ≤
          (prefixUpper : ℝ)+finite67Upper+otherTailsUpper+outerReserve :=
        add_le_add (add_le_add (add_le_add hprefix hfinite67) hother) houter
      _ = (residualUpper : ℝ) := by
        dsimp [residualUpper]
        push_cast
        rfl
  have hmpos : 0 < mass := by rw [hmass]; norm_num [selectorMass]
  apply (lt_div_iff₀ hmpos).2
  calc
    1/(reciprocalClaim : ℝ)*mass =
        1/(reciprocalClaim : ℝ)*(selectorMass : ℝ) := by rw [hmass]
    _ < (slopeLower : ℝ)-(residualUpper : ℝ) := by
      exact_mod_cast ledger_acceptance
    _ ≤ linear-(prefixCost+finite67+otherTails+outer) := sub_le_sub hlinear hres

/-- The preceding score transfer with the improved outer tail proved above.
All remaining numerical and analytic inputs are still explicit hypotheses. -/
theorem refined_score_of_published_inputs
    (linear prefixCost finite67 otherTails mass : ℝ)
    (hlinear : (slopeLower : ℝ) ≤ linear)
    (hprefix : prefixCost ≤ (prefixUpper : ℝ))
    (hfinite67 : finite67 ≤ (finite67Upper : ℝ))
    (hother : otherTails ≤ (otherTailsUpper : ℝ))
    (hmass : mass = (selectorMass : ℝ))
    (houter : (∑' n, |compCoeff (cHi @START@) P n|) ≤ (weightedOuterBound : ℝ)) :
    1/(reciprocalClaim : ℝ) <
      (linear-(prefixCost+finite67+otherTails+
        (branch5Weight : ℝ)*(∑' n, |compCoeff (cHi @START@) P n|)))/mass := by
  exact normalized_score_of_published_budgets linear prefixCost finite67 otherTails
    ((branch5Weight : ℝ)*(∑' n, |compCoeff (cHi @START@) P n|)) mass
    hlinear hprefix hfinite67 hother (branch5_outer_bound houter) hmass

/-- The normalized score corollary needs only the published numerical
budgets: the weighted outer-tail input is proved by outer_composition_bound. The Gaussian
interpretation of the remaining budgets is not asserted by this theorem. -/
theorem refined_score_of_published_budgets
    (linear prefixCost finite67 otherTails mass : ℝ)
    (hlinear : (slopeLower : ℝ) ≤ linear)
    (hprefix : prefixCost ≤ (prefixUpper : ℝ))
    (hfinite67 : finite67 ≤ (finite67Upper : ℝ))
    (hother : otherTails ≤ (otherTailsUpper : ℝ))
    (hmass : mass = (selectorMass : ℝ)) :
    1/(reciprocalClaim : ℝ) <
      (linear-(prefixCost+finite67+otherTails+
        (branch5Weight : ℝ)*(∑' n, |compCoeff (cHi @START@) P n|)))/mass := by
  exact refined_score_of_published_inputs linear prefixCost finite67 otherTails mass
    hlinear hprefix hfinite67 hother hmass outer_composition_bound

end
end Grothe.ScalarTailRefinement
